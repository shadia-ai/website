---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../i18n/utils';
import { getAlternatePath } from '../lib/routes';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  canonical?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  noIndex?: boolean;
  jsonLd?: object | object[];
  pageType?: 'website' | 'article';
}

const {
  title,
  description,
  lang = 'es',
  canonical,
  ogImage = '/og/default.png',
  ogTitle,
  ogDescription,
  noIndex = false,
  jsonLd,
  pageType = 'website',
} = Astro.props;

const siteUrl = 'https://shadia.ai';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const alternateLang = lang === 'es' ? 'en' : 'es';
const alternatePath = getAlternatePath(Astro.url.pathname, alternateLang as 'es' | 'en');
const alternateUrl = `${siteUrl}${alternatePath}`;

const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Shadia AI',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'AI-native conversational operations platform. Autonomous AI agents on WhatsApp and social channels, plus native appointment scheduling for growing businesses.',
  offers: { '@type': 'Offer', priceCurrency: 'USD' },
  areaServed: ['DO', 'MX', 'CO', 'AR', 'CL', 'PE', 'EC', 'US'],
  inLanguage: ['es', 'en'],
  url: siteUrl,
};

const schemas = jsonLd
  ? (Array.isArray(jsonLd) ? [softwareAppSchema, ...jsonLd] : [softwareAppSchema, jsonLd])
  : [softwareAppSchema];
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/es/`} />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Shadia AI" />
    <meta property="og:locale" content={lang === 'es' ? 'es_DO' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Force light theme always -->
    <script is:inline>document.documentElement.setAttribute('data-theme', 'light');</script>
  </head>
  <body>
    <div class="relative z-10">
      <Nav lang={lang} />
      <main class="site-main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>

    <!-- Persist language preference so root redirect remembers manual switches -->
    <script is:inline define:vars={{ pageLang: lang }}>
      try { localStorage.setItem('shadia_lang', pageLang); } catch (e) {}
    </script>

    <!-- Analytics -->
    <script>
      import { init, track } from '../lib/analytics';
      init();
      track('page_view', {
        page: window.location.pathname,
        lang: document.documentElement.lang,
        referrer: document.referrer,
      });
    </script>
  </body>
</html>
