---
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const productLinks = [
  { label: '✦ Shadia Agent', href: lang === 'es' ? '/es/producto/agente' : '/en/product/agent' },
  { label: t('nav.omnichannel', lang), href: lang === 'es' ? '/es/producto/omnicanal' : '/en/product/omnichannel' },
  { label: t('nav.agents', lang), href: lang === 'es' ? '/es/producto/agentes-ia' : '/en/product/ai-agents' },
  { label: t('nav.appointments', lang), href: lang === 'es' ? '/es/producto/citas' : '/en/product/appointments' },
  { label: t('nav.pricing', lang), href: lang === 'es' ? '/es/precios' : '/en/pricing' },
];

const channelLinks = [
  { label: 'WhatsApp',  href: lang === 'es' ? '/es/canales/whatsapp'  : '/en/channels/whatsapp'  },
  { label: 'Instagram', href: lang === 'es' ? '/es/canales/instagram' : '/en/channels/instagram' },
  { label: 'Facebook',  href: lang === 'es' ? '/es/canales/facebook'  : '/en/channels/facebook'  },
  { label: 'TikTok',    href: lang === 'es' ? '/es/canales/tiktok'    : '/en/channels/tiktok'    },
];

const industryLinks = [
  { label: t('nav.ecommerce', lang), href: lang === 'es' ? '/es/industrias/ecommerce'  : '/en/industries/ecommerce'  },
  { label: t('nav.healthcare', lang),href: lang === 'es' ? '/es/industrias/salud'       : '/en/industries/healthcare' },
  { label: t('nav.sales', lang),     href: lang === 'es' ? '/es/industrias/ventas'      : '/en/industries/sales'      },
  { label: t('nav.support', lang),   href: lang === 'es' ? '/es/industrias/soporte'     : '/en/industries/support'    },
  { label: t('nav.dental', lang),    href: lang === 'es' ? '/es/industrias/odontologia' : '/en/industries/dental'     },
  { label: t('nav.beauty', lang),    href: lang === 'es' ? '/es/industrias/belleza'     : '/en/industries/beauty'     },
];

const compareLinks = [
  { label: 'vs Respond.io', href: lang === 'es' ? '/es/comparar/vs-respond-io' : '/en/compare/vs-respond-io' },
  { label: 'vs Wati',       href: lang === 'es' ? '/es/comparar/vs-wati'       : '/en/compare/vs-wati'       },
  { label: 'vs ManyChat',   href: lang === 'es' ? '/es/comparar/vs-manychat'   : '/en/compare/vs-manychat'   },
  { label: 'vs Intercom',   href: lang === 'es' ? '/es/comparar/vs-intercom'   : '/en/compare/vs-intercom'   },
];
const compareAllHref  = lang === 'es' ? '/es/comparar' : '/en/compare';
const compareAllLabel = lang === 'es' ? 'Ver todas →' : 'See all →';
---

<footer style="
  border-top: 1px solid var(--border);
  background: var(--bg-subtle);
  padding: 4rem 0 2rem;
  margin-top: 0;
">
  <div class="container">
    <!-- Top grid -->
    <div class="footer-grid" style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 2.5rem; margin-bottom: 3rem;">

      <!-- Brand column -->
      <div>
        <a href={lang === 'es' ? '/es/' : '/en/'} style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; margin-bottom: 1rem;">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="8" fill="#2F2636"/>
            <path d="M16 6 L22 14 L16 12 L10 14 Z" fill="#8C5A9E"/>
            <path d="M16 12 L22 14 L16 26 L10 14 Z" fill="#8C5A9E" opacity="0.6"/>
          </svg>
          <span style="font-weight: 700; font-size: 1rem; color: var(--ink); letter-spacing: -0.02em;">Shadia AI</span>
        </a>
        <p style="color: var(--ink-3); font-size: 0.875rem; line-height: 1.6; max-width: 260px; margin-bottom: 1.5rem;">
          {t('footer.tagline', lang)}
        </p>

        <!-- Social links — LinkedIn and Instagram only -->
        <div style="display: flex; gap: 0.625rem; align-items: center;">
          <a
            href="https://instagram.com/shadia.ai"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="social-icon"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.01" fill="currentColor" stroke-width="3"/>
            </svg>
          </a>
          <a
            href="https://linkedin.com/company/shadia-ai"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="social-icon"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Channels column -->
      <div>
        <h4 class="footer-heading">{lang === 'es' ? 'Canales' : 'Channels'}</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem;">
          {channelLinks.map(link => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Product column -->
      <div>
        <h4 class="footer-heading">{t('footer.product', lang)}</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem;">
          {productLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Industries column -->
      <div>
        <h4 class="footer-heading">{t('footer.industries', lang)}</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem;">
          {industryLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
          <li>
            <a href={lang === 'es' ? '/es/blog' : '/en/blog'} class="footer-link">{t('footer.blog', lang)}</a>
          </li>
        </ul>
      </div>

      <!-- Compare column -->
      <div>
        <h4 class="footer-heading">{t('footer.compare', lang)}</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem;">
          {compareLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
          <li style="margin-top: 0.25rem;">
            <a href={compareAllHref} class="footer-link" style="color: var(--accent); font-weight: 500; font-size: 0.8125rem;">{compareAllLabel}</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div style="border-top: 1px solid var(--border); padding-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <p style="color: var(--ink-4); font-size: 0.8125rem; margin: 0;">
        © {new Date().getFullYear()} Shadia AI. {t('footer.copyright', lang)}.
      </p>
      <div style="display: flex; gap: 1.5rem;">
        <a href={lang === 'es' ? '/es/privacidad' : '/en/privacy'} class="footer-link" style="font-size: 0.8125rem;">{t('footer.privacy', lang)}</a>
        <a href={lang === 'es' ? '/es/terminos' : '/en/terms'} class="footer-link" style="font-size: 0.8125rem;">{t('footer.terms', lang)}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .footer-link {
    color: var(--ink-3);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover { color: var(--ink); }

  .social-icon {
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--ink-3);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .social-icon:hover {
    color: var(--ink);
    border-color: var(--border-mid);
    background: var(--bg-subtle);
  }

  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr !important; }
  }
</style>
