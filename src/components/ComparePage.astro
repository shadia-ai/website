---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBand from './PageBand.astro';
import PageCta from './PageCta.astro';
import EmailCapture from './EmailCapture.tsx';
import { Check, X } from 'lucide-react';
import type { Lang } from '../i18n/utils';

interface CompareRow {
  feature: string;
  shadia: boolean | string;
  competitor: boolean | string;
}

interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  lang: Lang;
  competitor: string;
  competitorSlug: string;
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  heroHeadline: string;
  heroSubheadline: string;
  verdictPoints: string[];
  compareRows: CompareRow[];
  detailedText: string;
  migrationText: string;
  faqs: FAQItem[];
}

const {
  lang,
  competitor,
  competitorSlug,
  title,
  description,
  canonical,
  ogImage = '/og/compare-default.png',
  heroHeadline,
  heroSubheadline,
  verdictPoints,
  compareRows,
  detailedText,
  migrationText,
  faqs,
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const source = `compare_page_${competitorSlug}`;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={faqSchema}
>

<!-- Compare page view tracking -->
<script is:inline define:vars={{ competitorSlug, lang }}>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.mixpanel) {
      window.mixpanel.track('compare_page_view', { competitor: competitorSlug, lang });
    }
  });
</script>

<PageBand variant="plain" mesh class="page-hero" size="lg">
  <div style="position: absolute; top: -20%; left: 50%; transform: translateX(-50%); width: 800px; height: 500px; background: radial-gradient(ellipse at center, rgba(140,90,158,0.15) 0%, transparent 65%); pointer-events: none;"></div>
  <div class="container" style="position: relative; max-width: 860px;">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 1rem; background: var(--accent-soft); border: 1px solid rgba(140,90,158,0.25); border-radius: 9999px; margin-bottom: 1.5rem; font-size: 0.8125rem; font-weight: 600; color: var(--accent);">
      Shadia AI vs {competitor}
    </div>
    <h1 style="font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1.25rem; line-height: 1.1;">
      {heroHeadline}
    </h1>
    <p style="color: var(--ink-3); font-size: 1.125rem; line-height: 1.7; max-width: 620px; margin-bottom: 2rem;">
      {heroSubheadline}
    </p>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <EmailCapture source={source} lang={lang} mode="modal" client:load
        buttonLabel={lang === 'es' ? 'Probar Shadia AI gratis' : 'Try Shadia AI free'}
      />
      <a href={lang === 'es' ? '/es/precios' : '/en/pricing'} class="btn-secondary" style="font-size: 1rem; padding: 0.875rem 2rem;">
        {lang === 'es' ? 'Ver precios' : 'View pricing'}
      </a>
    </div>
  </div>
</PageBand>

<PageBand variant="muted" size="sm">
  <div class="container" style="max-width: 860px;">
    <div class="verdict-box">
      <h2 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 1rem; color: var(--accent);">
        {lang === 'es' ? `Dónde Shadia se diferencia de ${competitor}` : `Where Shadia differs from ${competitor}`}
      </h2>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem;">
        {verdictPoints.map(point => (
          <li style="display: flex; align-items: flex-start; gap: 0.625rem; font-size: 0.9375rem; color: var(--ink);">
            <Check size={16} style={{ color: '#22c55e', flexShrink: 0, marginTop: '2px' }}/>
            {point}
          </li>
        ))}
      </ul>
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 860px;">
    <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 2rem; text-align: center;">
      {lang === 'es' ? `Shadia AI vs ${competitor}: Comparación completa` : `Shadia AI vs ${competitor}: Full comparison`}
    </h2>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; background: var(--surface-raised); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
        <thead>
          <tr style="background: var(--bg-subtle); border-bottom: 1px solid var(--border);">
            <th style="text-align: left; padding: 1rem 1.25rem; font-size: 0.875rem; color: var(--ink-3); font-weight: 600; min-width: 220px;">
              {lang === 'es' ? 'Función' : 'Feature'}
            </th>
            <th style="text-align: center; padding: 1rem; font-size: 0.875rem; font-weight: 700; color: var(--accent); min-width: 140px;">
              Shadia AI
            </th>
            <th style="text-align: center; padding: 1rem; font-size: 0.875rem; font-weight: 700; color: var(--ink-3); min-width: 140px;">
              {competitor}
            </th>
          </tr>
        </thead>
        <tbody>
          {compareRows.map((row, i) => (
            <tr style={`border-bottom: 1px solid var(--border); background: ${i % 2 === 1 ? 'var(--bg-subtle)' : 'transparent'};`}>
              <td style="padding: 0.875rem 1.25rem; font-size: 0.875rem; color: var(--ink); font-weight: 500;">{row.feature}</td>
              <td style="text-align: center; padding: 0.875rem 1rem;">
                {row.shadia === true ? (
                  <Check size={18} style={{ color: '#22c55e', margin: '0 auto' }}/>
                ) : row.shadia === false ? (
                  <X size={16} style={{ color: '#ef4444', margin: '0 auto', opacity: 0.6 }}/>
                ) : (
                  <span style="font-size: 0.8125rem; color: var(--ink-3);">{row.shadia}</span>
                )}
              </td>
              <td style="text-align: center; padding: 0.875rem 1rem;">
                {row.competitor === true ? (
                  <Check size={18} style={{ color: '#22c55e', margin: '0 auto' }}/>
                ) : row.competitor === false ? (
                  <X size={16} style={{ color: '#ef4444', margin: '0 auto', opacity: 0.6 }}/>
                ) : (
                  <span style="font-size: 0.8125rem; color: var(--ink-3);">{row.competitor}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container" style="max-width: 780px;">
    <div class="prose-shadia" set:html={detailedText} />
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 780px;">
    <div class="card" style="padding: 2rem; border-color: rgba(140,90,158,0.3); text-align: center;">
      <div style="margin-bottom: 1rem; display: flex; justify-content: center;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
      </div>
      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem;">
        {lang === 'es' ? `Migrar de ${competitor} es fácil` : `Switching from ${competitor} is easy`}
      </h3>
      <p style="color: var(--ink-3); font-size: 0.9375rem; line-height: 1.65; max-width: 560px; margin: 0 auto 1.5rem;" set:html={migrationText} />
      <EmailCapture source={`${source}_migration`} lang={lang} mode="modal" client:load
        buttonLabel={lang === 'es' ? 'Empezar con Shadia AI' : 'Get started with Shadia AI'}
      />
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container" style="max-width: 720px;">
    <h2 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; text-align: center; margin-bottom: 2rem;">
      {lang === 'es' ? 'Preguntas frecuentes' : 'Frequently asked questions'}
    </h2>
    <div id="faq-list">
      {faqs.map((faq, i) => (
        <div class="faq-item" data-index={i}>
          <button class="faq-question" onclick={`
            var answer = this.nextElementSibling;
            var icon = this.querySelector('.faq-icon');
            var isOpen = answer.style.display === 'block';
            answer.style.display = isOpen ? 'none' : 'block';
            icon.textContent = isOpen ? '+' : '−';
          `}>
            {faq.q}
            <span class="faq-icon" style="color: var(--accent); font-size: 1.25rem; line-height: 1; flex-shrink: 0;">+</span>
          </button>
          <div class="faq-answer" style="display: none;">{faq.a}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain" size="sm">
  <div class="container" style="max-width: 780px; text-align: center;">
    <p style="color: var(--ink-3); font-size: 0.875rem; margin-bottom: 1rem;">{lang === 'es' ? 'Explora más sobre Shadia AI:' : 'Explore more about Shadia AI:'}</p>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
      <a href={lang === 'es' ? '/es/producto/sesiones' : '/en/product/sessions'} style="font-size: 0.875rem; color: var(--accent); text-decoration: none; padding: 0.375rem 0.875rem; border: 1px solid var(--accent-soft); border-radius: 9999px;">
        {lang === 'es' ? 'Sesiones clínicas' : 'Clinical sessions'}
      </a>
      <a href={lang === 'es' ? '/es/producto/recepcionista' : '/en/product/receptionist'} style="font-size: 0.875rem; color: var(--accent); text-decoration: none; padding: 0.375rem 0.875rem; border: 1px solid var(--accent-soft); border-radius: 9999px;">
        {lang === 'es' ? 'Recepcionista IA' : 'AI Receptionist'}
      </a>
      <a href={lang === 'es' ? '/es/producto/citas' : '/en/product/appointments'} style="font-size: 0.875rem; color: var(--accent); text-decoration: none; padding: 0.375rem 0.875rem; border: 1px solid var(--accent-soft); border-radius: 9999px;">
        {lang === 'es' ? 'Motor de Citas' : 'Appointments Engine'}
      </a>
      <a href={lang === 'es' ? '/es/precios' : '/en/pricing'} style="font-size: 0.875rem; color: var(--accent); text-decoration: none; padding: 0.375rem 0.875rem; border: 1px solid var(--accent-soft); border-radius: 9999px;">
        {lang === 'es' ? 'Precios' : 'Pricing'}
      </a>
      <a href={lang === 'es' ? '/es/comparar' : '/en/compare'} style="font-size: 0.875rem; color: var(--accent); text-decoration: none; padding: 0.375rem 0.875rem; border: 1px solid var(--accent-soft); border-radius: 9999px;">
        {lang === 'es' ? 'Ver todas las comparaciones' : 'All comparisons'}
      </a>
    </div>
  </div>
</PageBand>

<PageCta
  lang={lang}
  source={source}
  title={lang === 'es' ? 'Prueba Shadia' : 'Try Shadia'}
  titleAccent={lang === 'es' ? '7 días gratis.' : 'free for 7 days.'}
  lead={lang === 'es' ? 'Conecta WhatsApp y compara resultados en tu operación real.' : 'Connect your channels and compare resolution on your real support volume.'}
/>

</BaseLayout>
