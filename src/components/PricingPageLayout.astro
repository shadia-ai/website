---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import PageBand from './PageBand.astro';
import PageCta from './PageCta.astro';
import {
  getPricingCopy,
  getPlans,
  getFeatureGroups,
  getFaq,
  getFaqSchema,
  type PricingLang,
} from '../lib/pricing-page';

interface Props {
  lang: PricingLang;
}

const { lang } = Astro.props;
const copy = getPricingCopy(lang);
const plans = getPlans(lang);
const featureGroups = getFeatureGroups(lang);
const faq = getFaq(lang);
const faqSchema = getFaqSchema(lang);
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  lang={lang}
  canonical={copy.meta.canonical}
  ogImage={copy.meta.ogImage}
  jsonLd={faqSchema}
>

<PageHero
  eyebrow={copy.hero.eyebrow}
  title={copy.hero.title}
  titleAccent={copy.hero.titleAccent}
  lead={copy.hero.lead}
/>

<PageBand variant="muted" size="sm">
  <div class="container" style="text-align: center;">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 1rem; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 9999px; font-size: 0.8125rem; color: var(--ink-3);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v4M8 15h.01M16 15h.01"/></svg>
      {copy.creditsPill}
    </div>
  </div>
</PageBand>

<PageBand variant="plain" size="sm">
  <div class="container" style="max-width: 960px;">
    <div class="grid-3">
      {plans.map(p => (
        <div class="card" style={`padding: 2rem; position: relative; display: flex; flex-direction: column; gap: 1.25rem; ${p.popular ? 'border-color: var(--accent);' : ''} ${p.enterprise ? 'background: var(--ink); border-color: var(--ink);' : ''}`}>
          {p.popular && (
            <div style="position: absolute; top: -13px; left: 50%; transform: translateX(-50%); padding: 0.1875rem 1rem; background: var(--ink); color: var(--bg); border-radius: 9999px; font-size: 0.625rem; font-weight: 700; white-space: nowrap; letter-spacing: 0.08em; text-transform: uppercase;">{copy.popularBadge}</div>
          )}
          <div>
            <div style={`font-weight: 800; font-size: 1.25rem; margin-bottom: 0.25rem; letter-spacing: -0.03em; color: ${p.enterprise ? '#fff' : 'var(--ink)'};`}>{p.name}</div>
            <div style={`font-size: 0.875rem; color: ${p.enterprise ? 'rgba(255,255,255,0.5)' : 'var(--ink-4)'};`}>{p.taglineText}</div>
          </div>
          {p.enterprise ? (
            <div>
              <div style="font-size: 1.5rem; font-weight: 700; color: #fff; margin-bottom: 0.25rem;">{copy.customPrice}</div>
              <div style="font-size: 0.8125rem; color: rgba(255,255,255,0.4);">{copy.customPriceSub}</div>
            </div>
          ) : (
            <div style="display: flex; align-items: baseline; gap: 0.25rem;">
              <span style="font-size: 2.75rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1;">{p.price}</span>
              <span style="font-size: 0.875rem; color: var(--ink-4);">{p.periodText}</span>
            </div>
          )}
          {!p.enterprise && (
            <div style="background: var(--bg-subtle); border-radius: 10px; padding: 0.875rem; display: flex; flex-direction: column; gap: 0.5rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: var(--ink-2);">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 0 0-3-3.87"/><path stroke-linecap="round" stroke-linejoin="round" d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>{p.seats} {copy.membersIncluded} <span style="color: var(--ink-4);">· +{p.extraSeat}/{copy.extraMember}</span></span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: var(--ink-2);">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v4M8 15h.01M16 15h.01"/></svg>
                <span>{p.credits} {copy.creditsPerMonth} <span style="color: var(--ink-4);">· {copy.onDemandAvailable}</span></span>
              </div>
            </div>
          )}
          {p.enterprise && p.enterpriseItemsText && (
            <div style="display: flex; flex-direction: column; gap: 0.5rem; flex: 1;">
              {p.enterpriseItemsText.map(item => (
                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: rgba(255,255,255,0.8);">
                  <svg width="14" height="14" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="#22c55e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {item}
                </div>
              ))}
            </div>
          )}
          <button
            class={p.popular ? 'btn-primary' : 'btn-secondary'}
            style={`width: 100%; display: flex; justify-content: center; margin-top: auto; ${p.enterprise ? 'background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: #fff;' : ''}`}
            data-open-modal
          >{p.ctaText}</button>
        </div>
      ))}
    </div>
    <p style="text-align: center; font-size: 0.8125rem; color: var(--ink-4); margin-top: 1.5rem;">{copy.trialNote}</p>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container" style="max-width: 960px;">
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <div class="eyebrow">{copy.comparison.eyebrow}</div>
      <h2 style="font-size: clamp(1.875rem, 3vw, 2.375rem); font-weight: 600; line-height: 1.15;">
        {copy.comparison.title}<br/>
        <span style="font-family: var(--font-display); font-style: italic; font-weight: 400;">{copy.comparison.titleAccent}</span>
      </h2>
    </div>

    <div style="display: grid; grid-template-columns: 1fr repeat(3, 140px); gap: 0; border-bottom: 2px solid var(--border); padding-bottom: 1rem; margin-bottom: 0.5rem; position: sticky; top: var(--header-offset); background: var(--bg-subtle); z-index: 10;">
      <div></div>
      {plans.map(p => (
        <div style={`text-align: center; padding: 0 0.5rem; ${p.popular ? 'color: var(--accent);' : ''}`}>
          <div style="font-weight: 700; font-size: 0.9375rem; margin-bottom: 0.2rem;">{p.name}</div>
          <div style="font-size: 0.75rem; color: var(--ink-4);">{p.price ? `${p.price}${copy.comparison.perMonth}` : copy.customPrice}</div>
        </div>
      ))}
    </div>

    {featureGroups.map(group => (
      <div style="margin-bottom: 2rem;">
        <div style="padding: 0.875rem 0 0.5rem; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-4); border-bottom: 1px solid var(--border);">{group.group}</div>
        {group.rows.map(row => (
          <div style="display: grid; grid-template-columns: 1fr repeat(3, 140px); gap: 0; padding: 0.6875rem 0; border-bottom: 1px solid var(--border); align-items: center;">
            <div style="font-size: 0.9rem; color: var(--ink-3); padding-right: 1rem;">{row.label}</div>
            {([row.hob, row.pro, row.ultra] as (string | boolean)[]).map((val) => (
              <div style="text-align: center; font-size: 0.875rem; padding: 0 0.25rem;">
                {val === true
                  ? <span style="color: var(--green); font-weight: 600; font-size: 1rem;">✓</span>
                  : val === false
                  ? <span style="color: var(--ink-4); font-size: 0.875rem; opacity: 0.4;">—</span>
                  : <span style="color: var(--ink); font-weight: 500;">{val}</span>
                }
              </div>
            ))}
          </div>
        ))}
      </div>
    ))}

    <div style="display: grid; grid-template-columns: 1fr repeat(3, 140px); gap: 0; padding-top: 1.5rem;">
      <div></div>
      {plans.map(p => (
        <div style="text-align: center; padding: 0 0.375rem;">
          <button class={p.popular ? 'btn-primary' : 'btn-secondary'} style="width: 100%; display: flex; justify-content: center; font-size: 0.8125rem; padding: 0.5rem 0.75rem;" data-open-modal>{p.ctaText}</button>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container" style="max-width: 860px;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;">
      <div>
        <div class="eyebrow">{copy.api.eyebrow}</div>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600; margin-bottom: 1.125rem; line-height: 1.15;">
          {copy.api.title}<br/>
          <span style="font-family: var(--font-display); font-style: italic; font-weight: 400;">{copy.api.titleAccent}</span>
        </h2>
        <p style="font-size: 1rem; color: var(--ink-3); line-height: 1.75; margin-bottom: 1.75rem;">{copy.api.lead}</p>
        <ul style="list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.625rem;">
          {copy.api.bullets.map(item => (
            <li style="display: flex; align-items: center; gap: 0.625rem; font-size: 0.9375rem; color: var(--ink-3);">
              <span style="color: var(--accent); font-weight: 700;">✓</span> {item}
            </li>
          ))}
        </ul>
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4375rem 0.875rem; background: var(--ink); color: var(--bg); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M4.93 4.93l14.14 14.14"/></svg>
          {copy.api.badge}
        </div>
      </div>
      <div style="background: #0D0C0F; border-radius: 16px; padding: 1.375rem; font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.75rem; line-height: 1.8; border: 1px solid rgba(255,255,255,0.08); overflow: hidden;">
        <div style="display: flex; gap: 0.375rem; margin-bottom: 1rem;">
          {['#FF5F57','#FEBC2E','#28C840'].map(c => <span style={`width:8px;height:8px;border-radius:50%;background:${c}`}/>)}
        </div>
        <div style="color: #6B7280;">{'# query example'}</div>
        <div style="color: #C084FC; margin-top: 0.25rem;">query {'{'}</div>
        <div style="color: #60A5FA; padding-left: 1rem;">conversations {'{'}</div>
        <div style="color: #86EFAC; padding-left: 2rem;">id</div>
        <div style="color: #86EFAC; padding-left: 2rem;">contact {'{ name phone }'}</div>
        <div style="color: #86EFAC; padding-left: 2rem;">channel</div>
        <div style="color: #86EFAC; padding-left: 2rem;">lastMessage {'{ text at }'}</div>
        <div style="color: #60A5FA; padding-left: 1rem;">{'}'}</div>
        <div style="color: #C084FC;">{'}'}</div>
        <div style="margin-top: 1rem; color: #6B7280;">{'# Mutation example'}</div>
        <div style="color: #C084FC; margin-top: 0.25rem;">mutation {'{'}</div>
        <div style="color: #60A5FA; padding-left: 1rem;">scheduleAppointment(<span style="color: #FCD34D;">input: {'{'}</span></div>
        <div style="color: #86EFAC; padding-left: 2rem;">contactId: "c_123"</div>
        <div style="color: #86EFAC; padding-left: 2rem;">at: "2026-06-01T14:00:00Z"</div>
        <div style="color: #FCD34D; padding-left: 1rem;">{'}'}</div>
        <div style="color: #60A5FA; padding-left: 1rem;">) {'{ id status }'}</div>
        <div style="color: #C084FC;">{'}'}</div>
      </div>
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 680px;">
    <div class="eyebrow" style="justify-content: center; margin-bottom: 0.875rem;">{copy.faq.eyebrow}</div>
    <h2 style="font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600; text-align: center; margin-bottom: 3rem; line-height: 1.15;">{copy.faq.title}</h2>
    {faq.map(item => (
      <div class="faq-item">
        <div class="faq-question">{item.q}</div>
        <div class="faq-answer">{item.a}</div>
      </div>
    ))}
  </div>
</PageBand>

<PageCta
  lang={lang}
  source={copy.cta.source}
  title={copy.cta.title}
  titleAccent={copy.cta.titleAccent}
  lead={copy.cta.lead}
/>

</BaseLayout>

<style>
  @media (max-width: 860px) {
    [style*="grid-template-columns: 1fr repeat(3"] { overflow-x: auto; }
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 640px) {
    .grid-3 { grid-template-columns: 1fr !important; }
  }
</style>
