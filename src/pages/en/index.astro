---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupInput from '../../components/SignupInput.tsx';
import Icon from '../../components/Icon.astro';
import { SessionFloatComposition, InboxFloatPreview } from '../../components/FloatWidgets.tsx';
import { t } from '../../i18n/utils';

const pillars = [
  { label: 'Sessions', title: t('pillars.sessions.title', 'en'), desc: t('pillars.sessions.desc', 'en'), href: '/en/product/sessions' },
  { label: 'Front Desk', title: t('pillars.receptionist.title', 'en'), desc: t('pillars.receptionist.desc', 'en'), href: '/en/product/receptionist' },
  { label: 'Appointments', title: t('pillars.appointments.title', 'en'), desc: t('pillars.appointments.desc', 'en'), href: '/en/product/appointments' },
];

const workflowSteps = [
  { n: '1', title: 'Record', desc: 'The clinician starts Shadia at the beginning of the visit. Audio captured securely, with consent.' },
  { n: '2', title: 'Chart', desc: 'The AI transcribes and structures the information directly into the patient chart.' },
  { n: '3', title: 'Clinical note', desc: 'A clear note with findings, diagnosis and plan, ready for review.' },
  { n: '4', title: 'Patient version', desc: 'The same visit, in plain language, free of medical jargon.' },
  { n: '5', title: 'Channel', desc: 'The summary is shared on chat as soon as the clinician approves.' },
];

const liveScenarios = [
  { event: t('live.scenario1.event', 'en'), reaction: t('live.scenario1.reaction', 'en') },
  { event: t('live.scenario2.event', 'en'), reaction: t('live.scenario2.reaction', 'en') },
  { event: t('live.scenario3.event', 'en'), reaction: t('live.scenario3.reaction', 'en') },
  { event: t('live.scenario4.event', 'en'), reaction: t('live.scenario4.reaction', 'en') },
];

const specialties = [
  { title: t('industries.clinics.title', 'en'), href: '/en/specialties/clinics', icon: 'stethoscope' },
  { title: t('industries.dental.title', 'en'), href: '/en/specialties/dental', icon: 'tooth' },
  { title: t('industries.mental.title', 'en'), href: '/en/specialties/mental-health', icon: 'heart' },
  { title: t('industries.aesthetics.title', 'en'), href: '/en/specialties/aesthetics', icon: 'sparkles' },
  { title: t('industries.hospitals.title', 'en'), href: '/en/specialties/hospitals', icon: 'building' },
];

const trustItems = [
  { icon: 'lock', title: 'End-to-end encryption', desc: 'Conversations and clinical data protected in transit and at rest.' },
  { icon: 'user', title: 'Roles & permissions', desc: 'Every team member sees only the information they need for their role.' },
  { icon: 'clipboard', title: 'Full audit trail', desc: 'Every interaction logged with a timestamp and responsible user.' },
];
---

<BaseLayout
  title={t('meta.home.title', 'en')}
  description={t('meta.home.desc', 'en')}
  lang="en"
  canonical="https://shadia.ai/en/"
  ogImage="/og/home-en.png"
>

<section class="home-band hero-mesh section-lg" style="padding-bottom: 3rem;">
  <div class="container-wide hero-split">
    <div>
      <div class="pill-badge" style="margin-bottom: 1.25rem;">
        <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent);"></span>
        AI that runs the clinic
      </div>
      <h1 class="hero-title" style="margin-bottom: 1.25rem;">
        {t('hero.headline', 'en')}
      </h1>
      <p class="lead" style="margin-bottom: 1.5rem; max-width: 32rem;">
        {t('hero.subheadline', 'en')}
      </p>
      <SignupInput lang="en" source="home_hero" size="lg" client:load />
      <p class="lead-sm" style="margin-top: 0.875rem;">No credit card required · Live in 24h</p>
    </div>
    <div>
      <SessionFloatComposition lang="en" client:load />
    </div>
  </div>
</section>

<section class="home-band home-band--plain section">
  <div class="container-wide">
    <div class="section-intro" style="margin-bottom: 2.5rem;">
      <div class="eyebrow">Product</div>
      <h2 class="section-title" style="margin-bottom: 0.75rem;">{t('pillars.heading', 'en')}</h2>
    </div>
    <div class="pillar-grid">
      {pillars.map(p => (
        <a href={p.href} class="pillar-card" style="text-decoration: none; color: inherit;">
          <span class="pillar-card__label">{p.label}</span>
          <h3 class="pillar-card__title">{p.title}</h3>
          <p class="pillar-card__desc">{p.desc}</p>
          <span class="pillar-card__link">Learn more →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="home-band home-band--muted section">
  <div class="container-wide">
    <div class="section-intro" style="margin-bottom: 2.5rem;">
      <div class="eyebrow">Clinical sessions</div>
      <h2 class="section-title" style="margin-bottom: 0.75rem;">From visit to message</h2>
      <p class="lead-sm">Shadia drafts the note and shares the summary. The clinician reviews and approves instead of typing from scratch.</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:1rem;max-width:820px;">
      {workflowSteps.map(s => (
        <div style="display:flex;gap:1.25rem;align-items:flex-start;padding:1.125rem 1.375rem;background:var(--bg-elevated);border:1px solid var(--border);border-radius:14px;">
          <div style="width:34px;height:34px;border-radius:50%;background:var(--accent);color:#fff;font-weight:700;font-size:0.8125rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.n}</div>
          <div>
            <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.25rem;">{s.title}</h3>
            <p style="font-size:0.9rem;color:var(--ink-3);margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
    <p style="margin-top: 2rem;">
      <a href="/en/product/sessions" class="btn-secondary">See clinical sessions →</a>
    </p>
  </div>
</section>

<section class="home-band home-band--tint section">
  <div class="container-wide section-split section-split--reverse">
    <div class="section-split__visual">
      <InboxFloatPreview lang="en" client:load />
    </div>
    <div class="section-intro">
      <div class="eyebrow">Front desk, 24/7</div>
      <h2 class="section-title" style="margin-bottom: 1rem;">{t('live.heading', 'en')}</h2>
      <p class="lead" style="margin-bottom: 1.5rem;">{t('live.subheading', 'en')}</p>
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0.875rem;">
        {liveScenarios.map(s => (
          <div class="live-item">
            <strong>{s.event}</strong>
            <span>✦ {s.reaction}</span>
          </div>
        ))}
      </div>
      <a href="/en/product/receptionist" class="btn-ghost" style="margin-top: 1.5rem; display: inline-flex;">See AI Receptionist →</a>
    </div>
  </div>
</section>

<section class="home-band home-band--plain section">
  <div class="container-wide">
    <div class="section-intro" style="margin-bottom: 2.5rem;">
      <div class="eyebrow">Specialties</div>
      <h2 class="section-title" style="margin-bottom: 0.75rem;">{t('industries.heading', 'en')}</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem;">
      {specialties.map(s => (
        <a href={s.href} class="card-feature" style="text-decoration:none;color:inherit;text-align:center;">
          <div style="display:flex;align-items:center;justify-content:center;margin-bottom:0.75rem;color:var(--accent);"><Icon name={s.icon} size={22} /></div>
          <h3 style="font-size:0.9375rem;font-weight:600;margin:0;">{s.title}</h3>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="home-band home-band--muted section">
  <div class="container-wide">
    <div class="section-intro" style="margin-bottom: 2.5rem;">
      <div class="eyebrow">Privacy</div>
      <h2 class="section-title" style="margin-bottom: 0.75rem;">Clear controls for health data</h2>
      <p class="lead-sm">Encryption, role-based access, and a log of who did what.</p>
    </div>
    <div class="grid-3">
      {trustItems.map(f => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.5rem;">{f.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;color:var(--ink-3);">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="home-band home-band--dark section" style="overflow: hidden;">
  <div class="home-band__glow" aria-hidden="true"></div>
  <div class="container-wide">
    <div class="hero-split" style="align-items: center;">
      <div>
        <h2 class="hero-title" style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem;">
          {t('final_cta.headline', 'en')}
        </h2>
        <p class="lead" style="margin-bottom: 1.75rem; max-width: 26rem;">
          {t('final_cta.desc', 'en')}
        </p>
        <SignupInput lang="en" source="home_footer_cta" size="lg" client:load />
      </div>
      <div style="display: flex; justify-content: flex-end; opacity: 0.9;">
        <div class="home-band__quote">
          <p>"We stopped losing appointments to messages nobody had time to see."</p>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  @media (max-width: 720px) {
    [style*="grid-template-columns: repeat(2,minmax(0,1fr))"] { grid-template-columns: 1fr !important; }
  }
</style>
