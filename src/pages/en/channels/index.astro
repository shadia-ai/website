---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import ChannelCards from '../../../components/ChannelCards.astro';
import { WhatsAppIcon, InstagramIcon, MessengerIcon, TikTokIcon } from '../../../lib/channel-icons';

const channels = [
  {
    id: 'whatsapp',
    name: 'WhatsApp',
    featured: true,
    desc: 'Bookings, confirmations, and visit summaries on the channel patients already open.',
    href: '/en/channels/whatsapp',
    iconSvg: WhatsAppIcon,
  },
  {
    id: 'instagram',
    name: 'Instagram DMs',
    desc: 'Turn aesthetics and new-patient DMs into booked visits, even after hours.',
    href: '/en/channels/instagram',
    iconSvg: InstagramIcon,
  },
  {
    id: 'messenger',
    name: 'Messenger',
    desc: 'Handle Facebook Messenger and move high-intent threads to WhatsApp when it helps.',
    href: '/en/channels/facebook',
    iconSvg: MessengerIcon,
  },
  {
    id: 'tiktok',
    name: 'TikTok',
    desc: 'Reply to medical aesthetics DMs and convert engagement into booked consults.',
    href: '/en/channels/tiktok',
    iconSvg: TikTokIcon,
  },
];
---

<BaseLayout
  title="Channels. WhatsApp, Instagram, Messenger for clinics | Shadia AI"
  description="Unify WhatsApp, Instagram, and Messenger for your clinic. Appointments, AI receptionist, and visit summaries."
  lang="en"
  canonical="https://shadia.ai/en/channels/"
  ogImage="/og/channels-en.png"
>
  <PageHero
    eyebrow="Channels"
    title="Where patients message you,"
    titleAccent="one clinical inbox."
    lead="Shadia connects your practice channels, unified inbox, native appointments, and full patient context."
  />

  <PageBand variant="plain" size="sm">
    <div class="container-wide">
      <ChannelCards lang="en" channels={channels} />
    </div>
  </PageBand>

  <PageBand variant="muted">
    <div class="container">
      <div class="page-section-head">
        <div class="eyebrow">Why unify</div>
        <h2 class="section-title">One practice, not four apps</h2>
        <p class="lead-sm">Your team stops jumping between phones. AI keeps patient context across every channel.</p>
      </div>
      <div class="page-grid-3">
        {[
          { t: 'Patient context', d: 'History whether they wrote on WhatsApp or Instagram.' },
          { t: 'AI on every channel', d: 'Same clinical tone, bookings, visit prep, and follow-up.' },
          { t: 'Human handoff', d: 'Staff step in when needed, with the full thread visible.' },
        ].map(item => (
          <div class="card page-card">
            <h3 class="page-card__title">{item.t}</h3>
            <p class="page-card__desc">{item.d}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>

  <PageCta
    lang="en"
    source="channels_index_cta"
    title="Connect your channels"
    titleAccent="in minutes."
    lead="Book a demo. Turn on WhatsApp first, add the rest when you are ready."
  />
</BaseLayout>
