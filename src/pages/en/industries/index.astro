---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';

const industries = [
  { title: 'Ecommerce', desc: 'Recover carts, resolve orders, and confirm shipments over messaging.', benefits: ['Cart recovery', 'Order status', 'Returns in chat', 'Post-purchase upsell'], href: '/en/industries/ecommerce', color: '#10B981' },
  { title: 'Healthcare', desc: 'Fill schedules, cut no-shows, and reactivate patients without phone tag.', benefits: ['24/7 scheduling', 'Reminders', 'Easy rescheduling', 'Reactivation'], href: '/en/industries/healthcare', color: '#22c55e' },
  { title: 'Sales', desc: 'Qualify leads, follow up, and close more without growing headcount.', benefits: ['AI qualification', 'Auto follow-up', 'Always-on pipeline', 'Rep handoff'], href: '/en/industries/sales', color: '#3b82f6' },
  { title: 'Support', desc: 'Handle routine volume; your team owns what needs a human.', benefits: ['Autonomous resolution', 'Full-context escalation', 'SLA by priority', 'Live analytics'], href: '/en/industries/support', color: '#6366F1' },
  { title: 'Agencies', desc: 'Multi-brand from one platform — each client with its own agent and rules.', benefits: ['Multi-workspace', 'Per-brand agents', 'Consolidated reporting', 'Fast onboarding'], href: '/en/industries/agencies', color: '#F59E0B' },
  { title: 'Dental', desc: 'Automate scheduling and patient inquiries — your team focuses on in-chair care.', benefits: ['WhatsApp booking', 'Confirmations', 'Post-visit follow-up', 'Reactivation'], href: '/en/industries/dental', color: '#14B8A6' },
  { title: 'Beauty & Wellness', desc: 'Confirm, reschedule, and reactivate clients from messaging.', benefits: ['Auto confirmation', '24h reminders', 'Reactivation', 'Upsell'], href: '/en/industries/beauty', color: '#ec4899' },
];
---

<BaseLayout
  title="Industries — Shadia AI for your sector | Shadia AI"
  description="AI customer service agents by industry — ecommerce, healthcare, sales, support, agencies, and more. Deploy on WhatsApp and social messaging."
  lang="en"
  canonical="https://shadia.ai/en/industries"
  ogImage="/og/industries-en.png"
>
  <PageHero
    eyebrow="Industries"
    title="AI customer service"
    titleAccent="for your vertical."
    lead="Same resolution engine — tuned for ecommerce, support teams, healthcare, agencies, and brands that run on messaging."
  />

  <PageBand variant="plain">
    <div class="container">
      <div class="page-grid-2">
        {industries.map(ind => (
          <a href={ind.href} class="page-card-link">
            <div class="card page-card">
              <h2 class="page-card__title">{ind.title}</h2>
              <p class="page-card__desc">{ind.desc}</p>
              <ul style="list-style:none;padding:0;margin:0 0 1.25rem;display:flex;flex-direction:column;gap:0.5rem;">
                {ind.benefits.map(b => (
                  <li style="display:flex;align-items:center;gap:0.5rem;font-size:0.875rem;color:var(--ink-3);">
                    <span style={`width:5px;height:5px;border-radius:50%;background:${ind.color};flex-shrink:0;`}></span>
                    {b}
                  </li>
                ))}
              </ul>
              <span class="page-card__link" style={`color:${ind.color};`}>See solution →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </PageBand>

  <PageCta
    lang="en"
    source="industries_index_cta"
    title="Don't see your vertical?"
    titleAccent="Let's talk."
    lead="We'll map Shadia to your support workflow — start free today."
  />
</BaseLayout>
