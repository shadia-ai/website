---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageBand from '../../components/PageBand.astro';
import PageCta from '../../components/PageCta.astro';
import SignupInput from '../../components/SignupInput.tsx';

const sections = [
  {
    id: 'channels',
    title: 'Channels & agents',
    subtitle: 'Every channel, one place',
    desc: 'Connect WhatsApp, Instagram, TikTok, Facebook Messenger and more. Manage all conversations from a single unified platform.',
    icon: 'message-square',
    features: [
      { name: 'Official WhatsApp Business API', desc: 'Verified number, approved templates and full access to Meta\'s API.' },
      { name: 'Instagram DMs & comments', desc: 'Automatically respond to direct messages and comments with purchase intent.' },
      { name: 'Facebook Messenger', desc: 'Automate Messenger DMs and offer to continue on WhatsApp in the user\'s preferred language.' },
      { name: 'TikTok DMs', desc: 'Convert TikTok engagement into real conversations and appointments.' },
      { name: 'Switch to WhatsApp', desc: 'When a lead starts in Messenger, Shadia offers to move the conversation to WhatsApp — in their preferred language.' },
      { name: 'Unified omnichannel conversations', desc: 'All channels in one platform. Your team responds without switching windows.' },
      { name: 'Broadcast campaigns', desc: 'Send campaigns to contact segments with approved WhatsApp templates.' },
      { name: 'WhatsApp templates', desc: 'Create, manage and use approved templates for proactive outbound messages.' },
    ],
  },
  {
    id: 'conversations',
    title: 'Conversations',
    subtitle: 'Everything you need to handle any interaction',
    desc: 'Collaboration, organization and resolution tools to manage any customer conversation efficiently.',
    icon: 'message-square',
    features: [
      { name: 'Auto-assignment', desc: 'Automatically assign conversations to the right agent based on team rules and workload.' },
      { name: 'Internal notes', desc: 'Add private notes inside any conversation so the team has full context.' },
      { name: 'Message reactions', desc: 'React quickly to customer or team messages with emojis.' },
      { name: 'Thread replies', desc: 'Reply to specific messages while keeping the conversation thread organized.' },
      { name: 'Mentions (@)', desc: 'Mention a colleague or Shadia Agent in any conversation to ask for help or context.' },
      { name: 'Team presence', desc: 'See who is online and actively working on conversations in real time.' },
      { name: 'Attachments', desc: 'Share and receive documents, images, audio and videos directly in the chat.' },
      { name: 'Conversation search', desc: 'Find any conversation, message or file instantly with advanced search.' },
      { name: 'Business hours', desc: 'Define business hours per channel and team. Automatic out-of-hours messages.' },
      { name: 'Collision detection', desc: 'Alerts when two agents are replying to the same conversation simultaneously.' },
      { name: 'Scheduled messages', desc: 'Schedule messages to send later, just like Slack. Set the exact date and time and Shadia delivers it automatically.' },
      { name: 'Auto-close by inactivity', desc: 'Automatically close conversations after X days/months without activity. Configurable per account, channel or team.' },
      { name: 'Conversation collaborators', desc: 'Assign multiple roles to the same conversation (e.g. sales + support). Mentioning (@user) automatically adds them as a participant.' },
      { name: 'View modes', desc: 'Four agent-configurable views: Full (everything), Standard (no internal notes), Focus (client messages only), Collaborative (team notes only).' },
    ],
  },
  {
    id: 'ai',
    title: 'AI & Agents',
    subtitle: 'AI that truly operates',
    desc: 'Conversational AI agents with real LLM that maintain context, make decisions and manage complete conversations autonomously.',
    icon: 'bot',
    features: [
      { name: 'Conversational AI agents (LLM)', desc: 'Agents that understand context, remember conversations and respond with real intelligence.' },
      { name: 'Shadia Agent (AI on your team)', desc: 'Your AI on your team copilot. Ask about clients, request summaries, draft responses — in plain language.' },
      { name: 'AI Threads', desc: 'Start AI on your team-assisted conversations ChatGPT-style about your own data. Delegate, activate, assign, and send work to the AI directly from chat so it activates your business.' },
      { name: 'AI Presence', desc: 'See exactly where the AI is working across your account in real time: which conversations it\'s processing, what actions it\'s executing, and its current status.' },
      { name: 'Smart escalation', desc: 'The agent escalates to the human team when it detects the situation requires it.' },
      { name: 'Brand personality & tone', desc: 'Define how your agent speaks: formal, friendly, technical. Consistent in every message.' },
      { name: 'Automatic FAQ responses', desc: 'The agent answers frequent questions without human intervention, 24/7.' },
      { name: 'Conversation memory', desc: 'The agent remembers client history and adapts responses to context.' },
      { name: 'Multiple AI agents', desc: 'Configure different agents for different channels, teams or types of inquiry.' },
    ],
  },
  {
    id: 'appointments',
    title: 'Appointments Engine',
    subtitle: 'Autonomous scheduling, no external tools',
    desc: 'No Calendly, no external links. Shadia books, confirms, reschedules and handles all appointment logistics directly on WhatsApp.',
    icon: 'calendar',
    features: [
      { name: 'WhatsApp booking', desc: 'Client requests an appointment on WhatsApp and the agent confirms in the same chat.' },
      { name: 'Automatic reminders', desc: 'Automatic WhatsApp 24h and 1h before. Client confirms with a reply.' },
      { name: 'In-chat rescheduling', desc: 'Client can change the appointment by replying to the reminder. Agent updates the calendar.' },
      { name: 'Google Calendar sync', desc: 'Bidirectional real-time sync. Zero double bookings.' },
      { name: 'Multiple appointment types', desc: 'Define services with duration, price, prep time and specific availability.' },
      { name: 'Availability rules', desc: 'Hours, days, max simultaneous appointments per service or agent.' },
      { name: 'Post-appointment follow-up', desc: 'Automatic satisfaction survey and next appointment reminder.' },
      { name: 'Multiple locations', desc: 'Manage availability across different branches or agents from the same system.' },
    ],
  },
  {
    id: 'contacts',
    title: 'Contacts & Data',
    subtitle: 'Full client context, always available',
    desc: 'Organize contacts, companies and all relevant information. No spreadsheets, no separate tools — Shadia manages the context for you.',
    icon: 'user',
    features: [
      { name: 'Unified contact profiles', desc: 'Full history of conversations, appointments, notes and attributes in one profile.' },
      { name: 'Companies & organizations', desc: 'Associate contacts with companies and see all activity for a corporate client.' },
      { name: 'Tags & labels', desc: 'Organize and segment contacts with custom tags to filter and find.' },
      { name: 'Custom data attributes (16 types)', desc: 'The most complete attribute system in the category: TEXT, LINK, EMAIL, PHONE, NUMBER, DATE, DATETIME, TIME, BOOLEAN, CURRENCY, SELECTION, GEOLOCATION, SIGNATURE, CONSENT, STATEMENT, ATTACHMENT, and RELATIONSHIP. Model any business data without limitations.' },
      { name: 'Contact notes', desc: 'The team can add notes to any contact with important context.' },
      { name: 'Resource viewers', desc: 'See which resources, documents or pages each contact has visited.' },
      { name: 'Duplicate suggestions', desc: 'Shadia automatically detects duplicate contacts and suggests merging them.' },
      { name: 'CSV import/export', desc: 'Import your existing contact base and export segments when needed.' },
      { name: 'AI contact cleanup', desc: 'The AI detects and automatically flags contacts with no response, no interest, or long inactivity. Keep your database clean without manual work.' },
      { name: 'Bulk actions', desc: 'Import contacts, assign tags, change folder, update status and more — in batch across multiple contacts at once.' },
    ],
  },
  {
    id: 'teams',
    title: 'Teams & Collaboration',
    subtitle: 'Your team working as one',
    desc: 'Tools designed for full teams to collaborate on conversations with visibility, control and efficiency.',
    icon: 'users',
    features: [
      { name: 'Smart auto-assignment', desc: 'Automatically assigns conversations by availability, workload and agent skills.' },
      { name: 'Folders & organization', desc: 'Organize conversations and threads in folders by project, channel or team.' },
      { name: 'Teams & sub-teams', desc: 'Create agent groups for different areas: sales, support, operations.' },
      { name: 'Real-time presence', desc: 'See who\'s active, busy or offline. Distribute workload intelligently.' },
      { name: 'Role-based access (RBAC)', desc: 'Define what each team member can see and do in the platform.' },
      { name: 'Action audit log', desc: 'Records who did what and when for compliance and internal reviews.' },
      { name: 'Agent schedules', desc: 'Configure each agent\'s availability so assignments respect their hours.' },
      { name: 'Member capacity', desc: 'Prevent overload by limiting simultaneous conversations per team member.' },
    ],
  },
  {
    id: 'api',
    title: 'API & Integrations',
    subtitle: 'Connect Shadia to your entire stack',
    desc: 'Robust API, real-time webhooks and native integrations to connect Shadia with any tool in your ecosystem.',
    icon: 'link',
    features: [
      { name: 'Full API', desc: 'Queries and mutations to access and modify contacts, conversations, appointments and more.' },
      { name: 'Real-time webhooks', desc: 'Receive Shadia events in your system instantly for external automations.' },
      { name: 'OAuth 2.0', desc: 'Secure, standard authentication for third-party integrations.' },
      { name: 'Interactive documentation', desc: 'Explore and test the API directly from the online documentation.' },
      { name: 'SDK (Node.js, Python)', desc: 'Official libraries to integrate Shadia into your applications faster.' },
      { name: 'Native integrations', desc: 'Google Calendar, HubSpot, Zapier, Slack and more — connected in minutes.' },
      { name: 'Dashboard apps', desc: 'Embed custom applications inside Shadia for specific use cases.' },
      { name: 'IP whitelisting', desc: 'Control which IPs can access your API for maximum security.' },
    ],
  },
  {
    id: 'reports',
    title: 'Reports & Analytics',
    subtitle: 'Data that helps you decide',
    desc: 'Real-time dashboards and detailed reports to measure the performance of your operation, team and channels.',
    icon: 'bar-chart',
    features: [
      { name: 'Real-time dashboard', desc: 'Overview of active conversations, response times and team workload.' },
      { name: 'Member reports', desc: 'Measure individual team member performance: speed, resolution and satisfaction.' },
      { name: 'Channel reports', desc: 'See which channels generate the most conversations and which convert best.' },
      { name: 'CSAT (Customer satisfaction)', desc: 'Automatic post-conversation surveys with real-time satisfaction metrics.' },
      { name: 'Appointment reports', desc: 'Calendar occupancy, most requested services, no-shows and trends.' },
      { name: 'Report export', desc: 'Download any report in CSV for external analysis or presentations.' },
      { name: 'Custom reports', desc: 'Create custom reports with the metrics that matter most to your business (ULTRA).' },
      { name: 'Live view', desc: 'Monitor active team conversations in real time from the dashboard.' },
    ],
  },
  {
    id: 'security',
    title: 'Security & Compliance',
    subtitle: 'Enterprise security from day one',
    desc: 'Encryption, audit logs, access control and data privacy compliance so your operation is always protected.',
    icon: 'lock',
    features: [
      { name: 'End-to-end encryption (TLS + AES-256)', desc: 'All data in transit and at rest encrypted to enterprise standards.' },
      { name: 'Role-based access control (RBAC)', desc: 'Define granular permissions per role for every platform function.' },
      { name: 'Full audit log', desc: 'Detailed record of all actions performed by platform users.' },
      { name: 'SSO / SAML', desc: 'Single sign-on compatible with major identity providers (ULTRA).' },
      { name: '99.9% uptime SLA', desc: 'Redundant infrastructure with contractual availability commitments.' },
      { name: 'GDPR compliance', desc: 'Tools and controls to comply with data privacy regulations.' },
      { name: 'IP whitelisting', desc: 'Restrict access to specific IPs for API and admin panel access.' },
      { name: 'Meta Business Partner', desc: 'Officially verified Meta integration for maximum WhatsApp security.' },
      { name: 'Data masking (Mask)', desc: 'Hide phone numbers and email addresses from agents to protect sensitive contact information. Privacy and data security without operational friction.' },
    ],
  },
];
---

<BaseLayout
  title="Features — Everything included in Shadia AI | Shadia AI"
  description="The complete platform for AI customer service: omnichannel agents, AI agents, scheduling, integrations, analytics, and enterprise security."
  lang="en"
  canonical="https://shadia.ai/en/features"
  ogImage="/og/features-en.png"
>

<PageHero
  eyebrow="Features"
  title="The platform for"
  titleAccent="AI customer service."
  lead="Omnichannel agents, autonomous agents, scheduling, integrations, analytics, and guardrails — everything to build, deploy, and improve support agents."
  narrow={false}
>
  <div class="page-hero__actions">
    <SignupInput lang="en" source="features_page_hero" size="lg" client:load />
  </div>
</PageHero>

<div class="sticky-subnav">
  <div class="container sticky-subnav__inner">
    <div class="sticky-subnav__tabs">
      {sections.map(s => (
        <a href={`#${s.id}`} class="sticky-subnav__tab">
          <Icon name={s.icon} size={20} /> {s.title}
        </a>
      ))}
    </div>
  </div>
</div>

{sections.map((section, i) => (
  <PageBand id={section.id} variant={i % 2 === 0 ? 'plain' : 'muted'}>
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; margin-bottom: 3.5rem; align-items: start;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.875rem; background: var(--accent-bg); border: 1px solid var(--accent-ring); border-radius: 9999px; font-size: 0.6875rem; font-weight: 700; color: var(--accent); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1rem;">
            <Icon name={section.icon} size={20} /> {section.title}
          </div>
          <h2 style="font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 600; line-height: 1.2; color: var(--ink); margin-bottom: 0.875rem;">{section.subtitle}</h2>
        </div>
        <div>
          <p style="font-size: 1.0625rem; color: var(--ink-3); line-height: 1.75; margin: 0;">{section.desc}</p>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 16px; overflow: hidden;">
        {section.features.map(f => (
          <div style="padding: 1.375rem 1.5rem; background: var(--bg);">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
              <span style="width: 18px; height: 18px; border-radius: 50%; background: var(--accent); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="9" height="9" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.3;">{f.name}</h3>
            </div>
            <p style="font-size: 0.8125rem; color: var(--ink-4); line-height: 1.6; margin: 0; padding-left: 1.625rem;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>
))}

<PageBand variant="tint">
  <div class="container" style="max-width: 960px;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <div class="eyebrow" style="justify-content: center; margin-bottom: 0.875rem;">Data Attributes</div>
      <h2 style="font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600; line-height: 1.15; margin-bottom: 0.875rem;">
        16 attribute types.<br/>
        <span style="font-family: var(--font-display); font-style: italic; font-weight: 400;">Model any business data.</span>
      </h2>
      <p style="color: var(--ink-3); font-size: 1rem; max-width: 580px; margin: 0 auto;">
        Most platforms give you a text field and call it done. Shadia supports 16 structured data types — from geolocation and digital signatures to legal consent and entity relationships.
      </p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
      {[
        { type: 'TEXT',         label: 'Text',           desc: 'Free-form single-line text' },
        { type: 'NUMBER',       label: 'Number',         desc: 'Integer or decimal' },
        { type: 'BOOLEAN',      label: 'Boolean',        desc: 'True / False flag' },
        { type: 'DATE',         label: 'Date',           desc: 'ISO-8601 YYYY-MM-DD' },
        { type: 'DATETIME',     label: 'Date & Time',    desc: 'With timezone info' },
        { type: 'TIME',         label: 'Time',           desc: 'HH:MM:SS' },
        { type: 'CURRENCY',     label: 'Currency',       desc: 'Amount + ISO-4217 code' },
        { type: 'SELECTION',    label: 'Selection',      desc: 'Configured option list' },
        { type: 'LINK',         label: 'Link',           desc: 'Validated URL' },
        { type: 'EMAIL',        label: 'Email',          desc: 'Normalized address' },
        { type: 'PHONE',        label: 'Phone',          desc: 'E.164 format' },
        { type: 'GEOLOCATION',  label: 'Geolocation',    desc: 'Latitude & longitude' },
        { type: 'SIGNATURE',    label: 'Signature',      desc: 'Digital signature capture' },
        { type: 'CONSENT',      label: 'Consent',        desc: 'Accept policy or terms' },
        { type: 'STATEMENT',    label: 'Statement',      desc: 'Display / acknowledge text' },
        { type: 'ATTACHMENT',   label: 'Attachment',     desc: 'Uploaded file reference' },
      ].map(a => (
        <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.875rem 1rem;">
          <div style="font-size: 0.625rem; font-weight: 700; letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase; margin-bottom: 0.25rem; font-family: 'SF Mono', 'Fira Code', monospace;">{a.type}</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--ink); margin-bottom: 0.125rem;">{a.label}</div>
          <div style="font-size: 0.75rem; color: var(--ink-4);">{a.desc}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageCta
  lang="en"
  source="features_page_cta"
  title="All of this,"
  titleAccent="starting at $49/month."
  lead="7 days free, no credit card. Start today and activate what you need."
>
  <p class="lead-sm" style="margin-top: 0.75rem; text-align: center;">No commitments · Cancel anytime</p>
</PageCta>

</BaseLayout>

<style>
  @media (max-width: 1024px) {
    [style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: repeat(2, 1fr) !important; }
    [style*="grid-template-columns: 1fr 2fr"] { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 640px) {
    [style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: 1fr !important; }
  }
  ::-webkit-scrollbar { display: none; }
</style>
