---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageBand from '../../components/PageBand.astro';
import PageCta from '../../components/PageCta.astro';
import SignupInput from '../../components/SignupInput.tsx';

const sections = [
  {
    id: 'sessions',
    title: 'Clinical sessions',
    subtitle: 'Documentation while you care for patients',
    desc: 'Shadia listens to the visit, structures the clinical note, and prepares it for your review, without breaking the patient relationship.',
    icon: 'clipboard',
    features: [
      { name: 'AI clinical scribe', desc: 'Transcribes and structures the visit in real time. You review and approve before anything is saved.' },
      { name: 'Specialty templates', desc: 'Notes tailored to primary care, dental, aesthetics, mental health, and more.' },
      { name: 'Post-visit summary', desc: 'Generates a clear chart summary and follow-up instructions for the patient.' },
      { name: 'Patient instructions', desc: 'Pre-visit prep, medication guidance, post-procedure care, written in plain language.' },
      { name: 'Session history', desc: 'Every visit links to the patient profile with full context for your team.' },
      { name: 'Review before save', desc: 'No note is finalized without clinician approval. Full control over what enters the chart.' },
      { name: 'Multi-provider', desc: 'Multiple clinicians document in the same practice with templates and role-based permissions.' },
      { name: 'Note export', desc: 'Export approved notes in standard formats for your clinical workflow.' },
    ],
  },
  {
    id: 'receptionist',
    title: 'AI Receptionist',
    subtitle: 'The front desk that never closes',
    desc: 'Answers FAQs, triages inquiries, books appointments, and escalates to your team only when the case requires a human.',
    icon: 'bot',
    features: [
      { name: '24/7 WhatsApp coverage', desc: 'Patients write at any hour. Shadia replies, guides, and books without wait times.' },
      { name: 'Practice FAQs', desc: 'Hours, location, services, pricing guidance, and visit requirements, answered instantly.' },
      { name: 'Inquiry triage', desc: 'Identifies urgency, service type, and whether the patient is new or returning before booking.' },
      { name: 'Smart escalation', desc: 'Sensitive cases, complaints, or out-of-protocol situations go to staff with full history.' },
      { name: 'Your practice tone', desc: 'Formal, warm, or clinical, the receptionist speaks like your team, not a generic bot.' },
      { name: 'Pre-visit preparation', desc: 'Sends fasting instructions, required documents, and insurance confirmation before the visit.' },
      { name: 'Multi-location routing', desc: 'Directs patients to the right location based on service, provider, or availability.' },
      { name: 'Handoff with context', desc: 'When a human steps in, they already know what the patient asked, what AI offered, and what remains.' },
    ],
  },
  {
    id: 'appointments',
    title: 'Appointments engine',
    subtitle: 'Autonomous scheduling, no external tools',
    desc: 'Shadia books, confirms, reschedules, and handles cancellations directly on WhatsApp, synced with your practice calendar.',
    icon: 'calendar',
    features: [
      { name: 'WhatsApp booking', desc: 'Patient requests an appointment in chat and the AI receptionist confirms in the same thread.' },
      { name: 'Automatic reminders', desc: 'WhatsApp 24h and 1h before. Patient confirms with a reply and no-shows drop.' },
      { name: 'In-chat rescheduling', desc: 'Patient changes the appointment by replying to the reminder. Calendar updates instantly.' },
      { name: 'Google Calendar sync', desc: 'Bidirectional real-time sync by provider, room, or location. Zero double booking.' },
      { name: 'Clinical appointment types', desc: 'Initial consult, follow-up, procedure, telehealth, with duration and prep requirements.' },
      { name: 'Availability rules', desc: 'Provider schedules, surgical blocks, holidays, and max simultaneous appointments.' },
      { name: 'Post-visit follow-up', desc: 'Satisfaction survey, care reminders, and next appointment suggestion, automated.' },
      { name: 'Multiple locations', desc: 'Manage availability across offices, clinics, and centers from one system.' },
    ],
  },
  {
    id: 'channels',
    title: 'Omnichannel',
    subtitle: 'Every channel, one patient record',
    desc: 'WhatsApp as the primary channel, Instagram for aesthetics, Facebook and TikTok for patient acquisition, all unified with clinical context.',
    icon: 'message-square',
    features: [
      { name: 'Official WhatsApp Business API', desc: 'Primary channel for appointments, reminders, post-visit summaries, and clinical follow-up.' },
      { name: 'Instagram DMs & comments', desc: 'Ideal for aesthetics practices: answer procedure questions and book from the DM.' },
      { name: 'Facebook Messenger', desc: 'Handle your practice page and offer to continue on WhatsApp when the patient prefers.' },
      { name: 'TikTok DMs', desc: 'Turn interest from aesthetics or wellness videos into consultations and booked visits.' },
      { name: 'Unified conversations', desc: 'One patient, one profile. Regardless of channel, your team sees the full history.' },
      { name: 'Switch to WhatsApp', desc: 'Move the conversation to the preferred channel without losing context.' },
      { name: 'WhatsApp templates', desc: 'Appointment reminders, pre-visit instructions, and follow-up with approved templates.' },
      { name: 'Segmented broadcasts', desc: 'Preventive care campaigns, screening promotions, or follow-up reminders to patient segments.' },
    ],
  },
  {
    id: 'patients',
    title: 'Patients & contacts',
    subtitle: 'Unified record for every patient',
    desc: 'Conversation history, appointments, clinical notes, and patient attributes in one profile, no spreadsheets or parallel systems.',
    icon: 'user',
    features: [
      { name: 'Unified patient profile', desc: 'Conversations, appointments, clinical sessions, team notes, and attributes in one place.' },
      { name: 'Conversational clinical history', desc: 'Every interaction is logged so front desk, clinicians, and admin share context.' },
      { name: 'Tags & segmentation', desc: 'Tag by specialty, treatment stage, insurance, or campaign to filter and follow up.' },
      { name: 'Custom attributes (16 types)', desc: 'Insurance, allergies, PCP, consent, model any clinical or administrative data point.' },
      { name: 'Team notes', desc: 'Front desk, nursing, and admin add context without mixing it into the clinical note.' },
      { name: 'Duplicate detection', desc: 'Identifies duplicate patients by phone or name and suggests merging records.' },
      { name: 'CSV import/export', desc: 'Migrate your existing patient base and export segments for reports or campaigns.' },
      { name: 'Data masking', desc: 'Hide phones and emails from roles that do not need them. Privacy without operational friction.' },
    ],
  },
  {
    id: 'automation',
    title: 'Automation',
    subtitle: 'Clinical workflows that run themselves',
    desc: 'From first inquiry to post-procedure follow-up, automate the repetitive so your team focuses on care.',
    icon: 'zap',
    features: [
      { name: 'New patient flows', desc: 'New patients receive orientation, intake prompts, and booking options on first contact.' },
      { name: 'Appointment reminders', desc: 'Automatic sequence of confirmation, pre-visit prep, and no-show alerts.' },
      { name: 'Post-visit follow-up', desc: 'Care instructions, satisfaction survey, and follow-up appointment reminders, scheduled.' },
      { name: 'Patient reactivation', desc: 'Identify inactive patients and send screening or periodic check-up reminders.' },
      { name: 'Rule-based escalation', desc: 'Define when AI hands off to humans: urgency, complaints, out-of-protocol cases, or explicit request.' },
      { name: 'Automatic routing', desc: 'Route conversations to the right team: front desk, billing, specialist, or location.' },
      { name: 'Business hours', desc: 'Automatic after-hours messages with option to leave a question or book for the next day.' },
      { name: 'Scheduled messages', desc: 'Schedule follow-ups, medication reminders, or result notifications for exact date and time.' },
    ],
  },
  {
    id: 'analytics',
    title: 'Analytics',
    subtitle: 'Data to improve clinical operations',
    desc: 'Measure response times, calendar utilization, patient satisfaction, and performance by location, in real time.',
    icon: 'bar-chart',
    features: [
      { name: 'Real-time dashboard', desc: 'Active conversations, today\'s appointments, response times, and team workload.' },
      { name: 'Appointment reports', desc: 'Utilization by provider, most requested services, no-shows, and weekly trends.' },
      { name: 'Patient satisfaction (CSAT)', desc: 'Automatic post-visit surveys with real-time satisfaction metrics.' },
      { name: 'Channel reports', desc: 'Which channel drives the most bookings: WhatsApp, Instagram, Facebook, or TikTok.' },
      { name: 'Location reports', desc: 'Compare performance across offices, clinics, or network sites.' },
      { name: 'Team performance', desc: 'Response times, resolution, and escalations by team member.' },
      { name: 'CSV export', desc: 'Download reports for external analysis, leadership reviews, or internal audits.' },
      { name: 'Custom reports (ULTRA)', desc: 'Tailored metrics for hospital networks and multi-site operations.' },
    ],
  },
  {
    id: 'security',
    title: 'Security & privacy',
    subtitle: 'Clinical data protection by design',
    desc: 'Encryption, role-based access, audit logs, and retention controls, built for the confidentiality healthcare demands.',
    icon: 'lock',
    features: [
      { name: 'TLS + AES-256 encryption', desc: 'Data in transit and at rest encrypted to enterprise standards.' },
      { name: 'Role-based access (RBAC)', desc: 'Front desk, nursing, clinicians, and admin see only what their role requires.' },
      { name: 'Full audit log', desc: 'Record of who accessed, modified, or exported patient information.' },
      { name: 'Sensitive data masking', desc: 'Hide phones, emails, and identifiers based on user role.' },
      { name: 'Configurable retention', desc: 'Define retention and deletion policies for conversations and clinical notes.' },
      { name: 'SSO / SAML (ULTRA)', desc: 'Single sign-on for networks with active corporate directory.' },
      { name: '99.9% uptime SLA', desc: 'Redundant infrastructure with contractual availability commitments.' },
      { name: 'Meta Business Partner', desc: 'Officially verified Meta integration for WhatsApp with maximum security.' },
      { name: 'No training on your data', desc: 'Your conversations and clinical notes are never used to train AI models.' },
      { name: 'Designed for healthcare privacy', desc: 'Built with healthcare privacy expectations in mind. BAA available for enterprise accounts.' },
    ],
  },
];
---

<BaseLayout
  title="Features. Clinical AI platform | Shadia AI"
  description="Clinical sessions, AI receptionist, appointments, omnichannel, patient records, automation, analytics, and security, all in Shadia AI for clinics."
  lang="en"
  canonical="https://shadia.ai/en/features"
  ogImage="/og/features-en.png"
>

<PageHero
  eyebrow="Features"
  title="Everything your clinic"
  titleAccent="needs with AI."
  lead="Clinical sessions, AI receptionist, appointments engine, omnichannel, patient records, automation, and security, in one platform."
  narrow={false}
>
  <div class="page-hero__actions">
    <SignupInput lang="en" source="features_page_hero" size="lg" client:load />
  </div>
</PageHero>

<div class="sticky-subnav">
  <div class="container sticky-subnav__inner">
    <div class="sticky-subnav__tabs">
      {sections.map(s => (
        <a href={`#${s.id}`} class="sticky-subnav__tab">
          <Icon name={s.icon} size={20} /> {s.title}
        </a>
      ))}
    </div>
  </div>
</div>

{sections.map((section, i) => (
  <PageBand id={section.id} variant={i % 2 === 0 ? 'plain' : 'muted'}>
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; margin-bottom: 3.5rem; align-items: start;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.875rem; background: var(--accent-bg); border: 1px solid var(--accent-ring); border-radius: 9999px; font-size: 0.6875rem; font-weight: 700; color: var(--accent); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1rem;">
            <Icon name={section.icon} size={20} /> {section.title}
          </div>
          <h2 style="font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 600; line-height: 1.2; color: var(--ink); margin-bottom: 0.875rem;">{section.subtitle}</h2>
        </div>
        <div>
          <p style="font-size: 1.0625rem; color: var(--ink-3); line-height: 1.75; margin: 0;">{section.desc}</p>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 16px; overflow: hidden;">
        {section.features.map(f => (
          <div style="padding: 1.375rem 1.5rem; background: var(--bg);">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
              <span style="width: 18px; height: 18px; border-radius: 50%; background: var(--accent); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="9" height="9" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.3;">{f.name}</h3>
            </div>
            <p style="font-size: 0.8125rem; color: var(--ink-4); line-height: 1.6; margin: 0; padding-left: 1.625rem;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>
))}

<PageBand variant="tint">
  <div class="container" style="max-width: 960px;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <div class="eyebrow" style="justify-content: center; margin-bottom: 0.875rem;">Patient record</div>
      <h2 style="font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600; line-height: 1.15; margin-bottom: 0.875rem;">
        16 attribute types.<br/>
        <span style="font-family: var(--font-display); font-style: italic; font-weight: 400;">Model any clinical data.</span>
      </h2>
      <p style="color: var(--ink-3); font-size: 1rem; max-width: 580px; margin: 0 auto;">
        From allergies and insurance to informed consent and digital signatures. Shadia supports 16 structured data types for the patient record.
      </p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
      {[
        { type: 'TEXT',         label: 'Text',           desc: 'Diagnosis, observations' },
        { type: 'NUMBER',       label: 'Number',         desc: 'Weight, vitals, lab values' },
        { type: 'BOOLEAN',      label: 'Boolean',        desc: 'Allergy yes/no, pregnancy' },
        { type: 'DATE',         label: 'Date',           desc: 'DOB, last visit' },
        { type: 'DATETIME',     label: 'Date & Time',    desc: 'Appointment, procedure' },
        { type: 'TIME',         label: 'Time',           desc: 'Preferred time slot' },
        { type: 'CURRENCY',     label: 'Currency',       desc: 'Copay, balance due' },
        { type: 'SELECTION',    label: 'Selection',      desc: 'Insurance, specialty' },
        { type: 'LINK',         label: 'Link',           desc: 'Results, intake forms' },
        { type: 'EMAIL',        label: 'Email',          desc: 'Patient email' },
        { type: 'PHONE',        label: 'Phone',          desc: 'Primary WhatsApp' },
        { type: 'GEOLOCATION',  label: 'Geolocation',    desc: 'Nearest location' },
        { type: 'SIGNATURE',    label: 'Signature',      desc: 'Informed consent' },
        { type: 'CONSENT',      label: 'Consent',        desc: 'Data authorization' },
        { type: 'STATEMENT',    label: 'Statement',      desc: 'Privacy notice' },
        { type: 'ATTACHMENT',   label: 'Attachment',     desc: 'Labs, ID documents' },
      ].map(a => (
        <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.875rem 1rem;">
          <div style="font-size: 0.625rem; font-weight: 700; letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase; margin-bottom: 0.25rem; font-family: 'SF Mono', 'Fira Code', monospace;">{a.type}</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--ink); margin-bottom: 0.125rem;">{a.label}</div>
          <div style="font-size: 0.75rem; color: var(--ink-4);">{a.desc}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageCta
  lang="en"
  source="features_page_cta"
  title="All of this,"
  titleAccent="starting at $49/month."
  lead="7 days free, no credit card. Start today and activate what you need."
>
  <p class="lead-sm" style="margin-top: 0.75rem; text-align: center;">No commitments · Cancel anytime</p>
</PageCta>

</BaseLayout>

<style>
  @media (max-width: 1024px) {
    [style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: repeat(2, 1fr) !important; }
    [style*="grid-template-columns: 1fr 2fr"] { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 640px) {
    [style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: 1fr !important; }
  }
  ::-webkit-scrollbar { display: none; }
</style>
