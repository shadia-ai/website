---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import { t } from '../../../i18n/utils';

const specialties = [
  { id: 'clinics', icon: 'activity', href: '/en/specialties/clinics', titleKey: 'industries.clinics.title', descKey: 'industries.clinics.desc' },
  { id: 'dental', icon: 'tooth', href: '/en/specialties/dental', titleKey: 'industries.dental.title', descKey: 'industries.dental.desc' },
  { id: 'mental', icon: 'heart', href: '/en/specialties/mental-health', titleKey: 'industries.mental.title', descKey: 'industries.mental.desc' },
  { id: 'aesthetics', icon: 'sparkles', href: '/en/specialties/aesthetics', titleKey: 'industries.aesthetics.title', descKey: 'industries.aesthetics.desc' },
  { id: 'hospitals', icon: 'building', href: '/en/specialties/hospitals', titleKey: 'industries.hospitals.title', descKey: 'industries.hospitals.desc' },
];
---

<BaseLayout
  title={t('meta.industries.title', 'en')}
  description={t('meta.industries.desc', 'en')}
  lang="en"
  canonical="https://shadia.ai/en/specialties"
>
  <PageHero
    eyebrow="Specialties"
    title="Shadia for your"
    titleAccent="kind of practice."
    lead="Clinical sessions, AI receptionist, and appointments, tuned to how each specialty actually runs."
  />

  <PageBand variant="plain">
    <div class="container">
      <div class="page-grid-3">
        {specialties.map(s => (
          <a href={s.href} class="page-card-link">
            <div class="card page-card">
              <div style="display:flex;align-items:center;margin-bottom:0.75rem;color:var(--accent);">
                <Icon name={s.icon} size={22} />
              </div>
              <h3 class="page-card__title">{t(s.titleKey, 'en')}</h3>
              <p class="page-card__desc">{t(s.descKey, 'en')}</p>
              <span class="page-card__link">Explore →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </PageBand>

  <PageCta
    lang="en"
    source="specialties_index_cta"
    title="Your practice,"
    titleAccent="with less admin."
    lead="Book a demo and see sessions, front desk, and scheduling in action."
  />
</BaseLayout>
