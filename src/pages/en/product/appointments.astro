---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHeroSplit from '../../../components/ProductHeroSplit.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import { AppointmentsFloatComposition } from '../../../components/FloatWidgets.tsx';
import { t } from '../../../i18n/utils';

const appointmentSlides = [
  {
    tag: 'No-shows',
    stat1: '70%',
    stat1Label: 'Fewer no-shows with\nautomated reminders',
    stat2: '48h + 2h',
    stat2Label: 'Reminder windows that\nmaximise confirmation rates',
    insight: 'No-shows usually happen because of not reaching the patient at the right moment.',
    detail: 'Shadia sends automated reminders at the most effective windows and requests confirmation. If the patient does not reply, the agent reschedules before the slot stays empty.',
  },
  {
    tag: '24/7 availability',
    stat1: '40%',
    stat1Label: 'Of appointments requested\noutside opening hours',
    stat2: '< 30 s',
    stat2Label: 'AI confirmation time\nat any hour',
    insight: 'Your schedule does not stop when your team goes home. Neither should a patient\'s ability to book.',
    detail: 'Shadia captures every request in real time, checks provider availability and confirms in seconds, any time, on WhatsApp. You get fewer missed calls and unanswered requests.',
  },
  {
    tag: 'Waitlist',
    stat1: '1 in 4',
    stat1Label: 'Cancelled slots refilled\nfrom the waitlist',
    stat2: '6 months',
    stat2Label: 'Threshold to trigger\na reactivation follow-up',
    insight: 'A cancelled slot can go to someone on your waitlist.',
    detail: 'When a patient cancels, Shadia automatically reaches out to the waitlist and offers the newly open slot, in priority order.',
  },
  {
    tag: 'Productivity',
    stat1: '3 hrs',
    stat1Label: 'Per day recovered by\nautomating the schedule',
    stat2: '0',
    stat2Label: 'Manual confirmation calls\nneeded with Shadia active',
    insight: 'Every hour your team spends managing the schedule is an hour not spent with a real patient.',
    detail: 'Confirmations, reschedules, reminders and new bookings run automatically so your team can stay on care instead of calendar logistics.',
  },
];
---

<BaseLayout
  title={t('meta.appointments.title', 'en')}
  description={t('meta.appointments.desc', 'en')}
  lang="en"
  canonical="https://shadia.ai/en/product/appointments"
  ogImage="/og/appointments-en.png"
>

<ProductHeroSplit
  badge="Appointments Engine"
  title="An AI agent fills"
  titleAccent="your practice's schedule."
  lead="The agent talks with the patient, understands availability by provider, and confirms the appointment directly. It books, confirms, reschedules, and works the waitlist, without your team stepping in."
  lang="en"
  source="product_appts_hero"
  hint="No credit card · Free to start"
>
  <AppointmentsFloatComposition lang="en" client:load />
</ProductHeroSplit>

<PageBand variant="plain" size="sm">
  <div class="container">
    <div class="page-stats-row">
      {[
        { v: '85%', l: 'Reduction in no-shows' },
        { v: '24/7', l: 'Always open for bookings' },
        { v: '3 min', l: 'Appointment confirmed in' },
        { v: '0', l: 'Scheduling conflicts' },
      ].map(s => (
        <div>
          <div class="page-stat__value" style="color: var(--accent);">{s.v}</div>
          <div class="page-stat__label">{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Features</div>
      <h2 class="section-title">Automated appointments, start to finish</h2>
    </div>
    <div class="grid-3">
      {[
        { icon: 'bot', title: 'Autonomous scheduling', desc: 'The agent receives the patient\'s request, checks provider availability and confirms the appointment without manual work.' },
        { icon: 'bell', title: 'Smart reminders', desc: 'WhatsApp reminders with optimal timing. The patient confirms with a tap. No-shows eliminated.' },
        { icon: 'refresh-cw', title: 'Easy rescheduling', desc: 'Patients can change their appointment by replying to the reminder. The agent updates the calendar automatically.' },
        { icon: 'users', title: 'Active waitlist', desc: 'When a slot is cancelled, Shadia reaches the waitlist in priority order and fills it instantly.' },
        { icon: 'calendar', title: 'Multiple providers', desc: 'Every clinician has their own calendar, services and availability, synced in real time.' },
        { icon: 'bar-chart', title: 'Occupancy reports', desc: 'See when your schedule is full, which providers are in highest demand, and optimize availability.' },
      ].map(f => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.5rem;">{f.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;color:var(--ink-3);">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Before & After</div>
      <h2 class="section-title">From scheduling chaos to total control</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
      <div style="padding:1.75rem;background:rgba(239,68,68,0.04);border:1px solid rgba(239,68,68,0.15);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#ef4444;margin-bottom:1.25rem;">Without Shadia</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Patients waiting hours for confirmation', 'No-shows with no prior reminder', 'Double bookings between providers from human error', 'Front desk taking appointments manually by phone', 'Cancelled slots that stay empty'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink-3);">
              <span style="color:#ef4444;flex-shrink:0;">✗</span>{item}
            </li>
          ))}
        </ul>
      </div>
      <div style="padding:1.75rem;background:rgba(34,197,94,0.04);border:1px solid rgba(34,197,94,0.2);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#22c55e;margin-bottom:1.25rem;">With Appointments Engine</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Confirmed in 3 minutes via WhatsApp', '85% fewer no-shows with automatic reminders', 'Zero double bookings, real-time calendar per provider', 'Your team focused on care, not scheduling', 'A waitlist that fills every cancelled slot'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink);">
              <span style="color:var(--green);font-weight:700;flex-shrink:0;">✓</span>{item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Use Cases</div>
      <h2 class="section-title">Adapted to how every specialty schedules</h2>
    </div>
    <div class="grid-4">
      {[
        { icon: 'stethoscope', title: 'General practices', desc: 'Visits, follow-ups and check-ups with pre-visit reminders.' },
        { icon: 'tooth', title: 'Dental', desc: 'Multi-session treatments, cleanings and chair-based scheduling.' },
        { icon: 'heart', title: 'Mental health', desc: 'Recurring weekly or biweekly sessions with frictionless rescheduling.' },
        { icon: 'building', title: 'Multi-provider clinics', desc: 'Independent calendars per clinician, synced into one view.' },
      ].map(u => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={u.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.375rem;">{u.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;color:var(--ink-3);">{u.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Appointment Flow</div>
      <h2 class="section-title">One appointment. Five automatic steps</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:1rem;">
      {[
        { n: '1', title: 'Patient requests via WhatsApp', desc: 'The agent detects intent, asks for a preferred provider/service and checks real-time availability.' },
        { n: '2', title: 'Instant confirmation', desc: 'Appointment confirmed, summary sent and added to both the patient\'s and provider\'s calendar.' },
        { n: '3', title: '24h reminder', desc: 'Automatic WhatsApp message with all details. Patient replies to confirm.' },
        { n: '4', title: '2h reminder', desc: 'Second reminder with address, directions and option to reschedule if needed.' },
        { n: '5', title: 'Cancellation and waitlist', desc: 'If the patient cancels, Shadia frees the slot and offers it immediately to the next person on the waitlist.' },
      ].map(s => (
        <div style="display:flex;gap:1.25rem;align-items:flex-start;padding:1.25rem 1.5rem;background:var(--surface-raised);border:1px solid var(--border);border-radius:14px;">
          <div style="width:36px;height:36px;border-radius:50%;background:#0EA5E9;color:#fff;font-weight:700;font-size:0.875rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.n}</div>
          <div>
            <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.25rem;">{s.title}</h3>
            <p style="font-size:0.9rem;color:var(--ink-3);">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">By the numbers</div>
      <h2 class="section-title">What changes with the appointments engine</h2>
    </div>
    <div class="page-grid-2">
      {appointmentSlides.map(slide => (
        <div class="card page-card">
          <span class="pill-badge" style="margin-bottom: 1rem; width: fit-content;">{slide.tag}</span>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div>
              <div class="page-stat__value" style="font-size: 1.75rem;">{slide.stat1}</div>
              <p class="page-card__desc" style="white-space: pre-line; margin: 0;">{slide.stat1Label}</p>
            </div>
            <div>
              <div class="page-stat__value" style="font-size: 1.75rem;">{slide.stat2}</div>
              <p class="page-card__desc" style="white-space: pre-line; margin: 0;">{slide.stat2Label}</p>
            </div>
          </div>
          <p class="page-card__title" style="margin-bottom: 0.5rem;">{slide.insight}</p>
          <p class="page-card__desc">{slide.detail}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width:680px;">
    <div class="page-section-head">
      <div class="eyebrow">FAQ</div>
      <h2 class="section-title">Frequently asked questions</h2>
    </div>
    {[
      { q: 'Does it work with Google Calendar?', a: 'Yes. Bidirectional real-time sync. Appointments appear in each provider\'s Google Calendar automatically and calendar blocks are respected.' },
      { q: 'Can I have services with different durations per provider?', a: 'Yes. Define each service with its duration, prep time and specific availability per clinician.' },
      { q: 'What happens if the patient needs to cancel?', a: 'The agent handles the cancellation, frees the slot and offers it immediately to the next person on the waitlist. You get a real-time notification.' },
      { q: 'Does it work with multiple clinicians or providers?', a: 'Yes. Each provider has their own calendar and availability. The agent distributes appointments intelligently across all of them.' },
    ].map(faq => (
      <div class="faq-item">
        <div style="padding:1.25rem 0;font-weight:600;font-size:1rem;color:var(--ink);">{faq.q}</div>
        <div class="faq-answer">{faq.a}</div>
      </div>
    ))}
  </div>
</PageBand>

<PageCta
  lang="en"
  source="product_appts_cta"
  title="A full schedule"
  titleAccent="starts today."
  lead="Activate the appointments engine and let AI book, confirm, and reschedule patients automatically."
/>

</BaseLayout>

<style>
  @media (max-width: 900px) {
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
