---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHeroSplit from '../../../components/ProductHeroSplit.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import { AgentFloatPreview } from '../../../components/FloatWidgets.tsx';

const threads = [
  {
    title: 'What happened with this patient?',
    msg: '@shadia give me a summary of the last visit for the patient who asked about their results last week.',
    response: 'Last Thursday they had a follow-up with Dr. Perez. Dose was adjusted and a 4-week check-up was scheduled. The summary was sent on chat but not yet confirmed. Want me to follow up?',
    time: '2 min ago',
  },
  {
    title: 'Draft a message',
    msg: '@shadia draft a message for the patient who missed their appointment this morning.',
    response: 'Here\'s a draft: "Hi [Name], we noticed you weren\'t able to make it to today\'s appointment. Want help rescheduling? We have openings this week." Shall I send it?',
    time: '15 min ago',
  },
  {
    title: 'Analyze this week',
    msg: '@shadia how was schedule utilization this week compared to last week?',
    response: 'This week: 84 appointments (+12%), 6 no-shows (-40% vs last week), 91% confirmed on WhatsApp without staff intervention. Dr. Perez had the busiest schedule. 3 patients on the waitlist haven\'t been contacted yet.',
    time: 'yesterday',
  },
];
---

<BaseLayout
  title="Shadia Agent. AI copilot for your clinical team | Shadia AI"
  description="Shadia Agent works alongside your clinical team: summarizes patients, drafts messages, analyzes schedule utilization, and runs actions, in plain language, just mention @shadia."
  lang="en"
  canonical="https://shadia.ai/en/product/agent"
  ogImage="/og/agent-en.png"
>

<ProductHeroSplit
  badge="✦ Shadia Agent"
  title="The AI that runs"
  titleAccent="the practice with you."
  lead="Shadia Agent lives inside your practice ops. Ask about a patient, request a draft message, check schedule utilization, or escalate a case by typing @shadia."
  lang="en"
  source="product_agent_hero"
>
  <AgentFloatPreview lang="en" client:load />
</ProductHeroSplit>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Use cases</div>
      <h2 class="section-title">
        Ask whatever you need.<br/>
        <span class="headline-accent">Shadia has the clinical context.</span>
      </h2>
    </div>
    <div class="grid-3">
      {[
        { q: '"What happened with patient X?"', a: 'Shadia reviews the visit and message history and gives you a summary with full context.' },
        { q: '"Draft a follow-up message"', a: 'Shadia generates an appropriate message based on the case, your practice\'s tone, and the patient\'s history.' },
        { q: '"How was utilization this week?"', a: 'Get appointment, no-show, and confirmation metrics by channel instantly.' },
        { q: '"Flag this patient for follow-up"', a: 'Shadia updates the profile, adds the tag, and notifies the responsible team member.' },
        { q: '"How many appointments are tomorrow?"', a: 'Shadia checks the schedule and gives you a summary with each appointment\'s provider and details.' },
        { q: '"Escalate this case to the attending clinician"', a: 'Shadia creates an internal notification, assigns the case, and adds the necessary clinical context.' },
      ].map(item => (
        <div class="card-feature">
          <div style="font-size: 0.875rem; font-weight: 700; color: var(--accent); margin-bottom: 0.625rem; font-style: italic; line-height: 1.4;">{item.q}</div>
          <p style="font-size: 0.9375rem; color: var(--ink-3); line-height: 1.65;">{item.a}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 860px;">
    <div class="hero-split" style="align-items: start;">
      <div>
        <div class="eyebrow">Threads</div>
        <h2 class="section-title" style="margin-bottom: 1.25rem;">
          Organize your operations<br/>
          <span class="headline-accent">in smart threads.</span>
        </h2>
        <p class="lead-sm" style="margin-bottom: 2rem;">
          Create threads for any task or question at your practice. Shadia remembers the context of each conversation
          and can pick up where you left off. Share threads with your team or keep them private.
        </p>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
          {[
            'Persistent context per thread',
            'Share threads with your clinical team',
            'Mention Shadia with @shadia',
            'Archive or pin important threads',
            'Full history of your operations',
          ].map(item => (
            <li style="display: flex; align-items: center; gap: 0.625rem; font-size: 0.9375rem; color: var(--ink-3);">
              <span style="color: var(--accent); font-weight: 700;">✓</span> {item}
            </li>
          ))}
        </ul>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.875rem;">
        {threads.map((t, i) => (
          <div class="card" style={`padding: 1.125rem 1.25rem; opacity: ${i === 0 ? 1 : 0.65};`}>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
              <span style="font-weight: 600; font-size: 0.875rem; color: var(--ink);">{t.title}</span>
              <span style="font-size: 0.6875rem; color: var(--ink-4);">{t.time}</span>
            </div>
            <p style="font-size: 0.8125rem; color: var(--ink-3); margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{t.msg}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">For clinical teams</div>
      <h2 class="section-title">
        Built for your whole<br/>
        <span class="headline-accent">team to work together.</span>
      </h2>
    </div>
    <div class="grid-4">
      {[
        { icon: '@', title: 'Mentions', desc: 'Mention Shadia or a teammate in any thread.' },
        { icon: 'eye', title: 'Presence', desc: 'See who\'s active and what they\'re handling in real time.' },
        { icon: 'message-square', title: 'Reactions', desc: 'React to team messages with emojis for quick context.' },
        { icon: 'folder', title: 'Folders', desc: 'Organize threads by provider, specialty, or case type.' },
        { icon: 'tag', title: 'Tags', desc: 'Tag threads and patients to filter and find what you need.' },
        { icon: '↩', title: 'Thread replies', desc: 'Reply to specific messages while keeping thread context.' },
        { icon: 'paperclip', title: 'Attachments', desc: 'Share documents, images, and results directly in threads.' },
        { icon: 'user', title: 'Patients', desc: 'Organize context by patient and see all their recent activity.' },
      ].map(f => (
        <div class="card-feature" style="text-align: center;">
          <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--accent-bg); border: 1px solid var(--accent-ring); display: flex; align-items: center; justify-content: center; font-size: 1.125rem; margin: 0 auto 0.875rem; color: var(--accent); font-weight: 700;"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size: 0.9375rem; font-weight: 600; margin-bottom: 0.375rem; color: var(--ink);">{f.title}</h3>
          <p style="font-size: 0.8125rem; color: var(--ink-3); line-height: 1.6;">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageCta
  lang="en"
  source="product_agent_cta"
  title="Your AI. Always on."
  titleAccent="Start with @shadia."
  lead="Shadia Agent is included in every plan. No complex setup: type @shadia and go."
>
  <p class="lead-sm" style="margin-top: 0.75rem; text-align: center;">No credit card · Included in all plans</p>
</PageCta>

</BaseLayout>

<style>
  @media (max-width: 900px) {
    .grid-4 { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>
