---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHeroSplit from '../../../components/ProductHeroSplit.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import { InboxFloatPreview } from '../../../components/FloatWidgets.tsx';
import { Check } from 'lucide-react';
import { t } from '../../../i18n/utils';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Does Shadia work with the official WhatsApp Business API?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Shadia uses the official WhatsApp Business API, ensuring your practice number is never blocked and you have access to all premium features.' } },
    { '@type': 'Question', name: 'How many team members can collaborate on conversations?', acceptedAnswer: { '@type': 'Answer', text: 'PRO includes up to 8 team members. ULTRA supports unlimited seats via add-on. Everyone sees the full patient history and can collaborate with internal notes.' } },
    { '@type': 'Question', name: 'Does the AI replace my front desk?', acceptedAnswer: { '@type': 'Answer', text: 'No. The agent handles routine volume and escalates to the right team member. Your staff decides which replies to approve and when to step in.' } },
  ],
};
---

<BaseLayout
  title={t('meta.omnichannel.title', 'en')}
  description={t('meta.omnichannel.desc', 'en')}
  lang="en"
  canonical="https://shadia.ai/en/product/omnichannel"
  ogImage="/og/omnichannel-en.png"
  jsonLd={faqSchema}
>

<ProductHeroSplit
  badge="Clinical Omnichannel"
  title="One agent, full"
  titleAccent="patient context."
  lead="WhatsApp, Instagram, and Messenger in one clinical inbox. The agent handles routine questions; your team steps in with the full history, without hopping apps or making the patient repeat themselves."
  lang="en"
  source="product_omnichannel_hero"
  hint="No credit card required · Free to start"
>
  <InboxFloatPreview lang="en" client:load />
</ProductHeroSplit>

<PageBand variant="muted" size="sm">
  <div class="container">
    <div class="page-stats-row">
      {[
        { v: '< 3 min', l: 'Time to first response' },
        { v: '90%+', l: 'Messages resolved by the agent' },
        { v: '0', l: 'Missed patient conversations' },
        { v: '24/7', l: 'AI agent availability' },
      ].map(s => (
        <div>
          <div class="page-stat__value" style="color: var(--accent);">{s.v}</div>
          <div class="page-stat__label">{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Capabilities</div>
      <h2 class="section-title">Everything your front desk needs at scale</h2>
    </div>
    <div class="grid-3">
      {[
        { icon: 'zap', title: 'Replies with patient context', desc: 'Your agent suggests replies using the patient\'s visit and message history. Approve or edit in one click.' },
        { icon: 'users', title: 'Team collaboration', desc: 'Assign conversations to front desk, nursing, or the right clinician. Never two people replying to the same patient.' },
        { icon: 'bar-chart', title: 'Patient history', desc: 'Appointments, messages, and notes centralized per patient, no external tools or spreadsheets.' },
        { icon: 'search', title: 'Instant search', desc: 'Find any conversation in seconds. Filter by channel, patient, tag, or date.' },
        { icon: 'bot', title: 'Routine automation', desc: 'Automatic replies for FAQs, welcome messages, after-hours, and visit prep. No code required.' },
        { icon: 'trending-up', title: 'Resolution analytics', desc: 'Response times, resolution rate, and volume by channel, in real time.' },
      ].map(f => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.5rem;">{f.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;color:var(--ink-3);">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Before & after</div>
      <h2 class="section-title">The difference is immediate</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
      <div style="padding:1.75rem;background:rgba(239,68,68,0.04);border:1px solid rgba(239,68,68,0.15);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#ef4444;margin-bottom:1.25rem;">Without Shadia</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Patient messages lost between WhatsApp and Instagram', 'Slow responses that turn into missed appointments', 'No centralized patient history', 'Team confusion about who is handling what', 'Impossible to scale without hiring more front desk staff'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink-3);">
              <span style="color:#ef4444;flex-shrink:0;">✗</span>{item}
            </li>
          ))}
        </ul>
      </div>
      <div style="padding:1.75rem;background:rgba(34,197,94,0.04);border:1px solid rgba(34,197,94,0.2);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#22c55e;margin-bottom:1.25rem;">With Shadia agents</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Every channel connected, zero missed messages', 'The agent responds in seconds, 24/7', 'Full patient history in one place', 'Automatic assignment + internal team notes', 'Scale without hiring: the agent absorbs the volume'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink);">
              <Check size={15} style={{ color: '#22c55e', flexShrink: 0, marginTop: '2px' }} />{item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">How it works</div>
      <h2 class="section-title">Start in minutes, not days</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:1.5rem;">
      {[
        { n: '1', title: 'Connect your channels', desc: 'WhatsApp Business API, Instagram, and Messenger, all in one click. No complex technical setup.' },
        { n: '2', title: 'Configure your agent', desc: 'Give it your practice\'s context: specialty, hours, policies, and escalation rules. Plain language, no code.' },
        { n: '3', title: 'Invite your team', desc: 'Front desk, nursing, and clinicians, each with the role and permissions they need.' },
        { n: '4', title: 'The agent starts working', desc: 'From the first message, it replies, books, and escalates. Your team approves and refines.' },
      ].map(s => (
        <div class="card" style="display:flex;gap:1.25rem;align-items:flex-start;padding:1.5rem;">
          <div style="width:40px;height:40px;border-radius:50%;background:var(--accent);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.n}</div>
          <div>
            <h3 style="font-size:1.0625rem;font-weight:700;margin-bottom:0.375rem;">{s.title}</h3>
            <p style="font-size:0.9375rem;color:var(--ink-3);margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container page-section-head" style="max-width:760px;">
    <div class="eyebrow">Integrations</div>
    <h2 class="section-title">Connect with the tools you already use</h2>
    <p class="lead-sm" style="margin-bottom:2.5rem;">Shadia integrates natively with the systems clinics already run on. No Zapier, no code.</p>
    <div class="product-channel-bar">
      {['WhatsApp Business API', 'Google Calendar', 'Google Workspace', 'Zoom', 'Calendly', 'Twilio', 'Slack', 'Notion', 'Zapier'].map(int => (
        <span class="channel-badge">{int}</span>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container" style="max-width:680px;">
    <div class="page-section-head">
      <div class="eyebrow">FAQ</div>
      <h2 class="section-title">Frequently asked questions</h2>
    </div>
    {[
      { q: 'Does it work with the official WhatsApp API?', a: 'Yes. We use the official WhatsApp Business API, ensuring your practice number is never blocked and you have full access to premium features.' },
      { q: 'How many team members can collaborate?', a: 'PRO includes up to 8 members. ULTRA supports unlimited seats via add-on. Everyone sees the full patient history and can leave internal notes.' },
      { q: 'Does the AI replace my front desk?', a: 'No. The agent handles routine volume and escalates to the right team member. Your staff decides what to approve and when to step in.' },
      { q: 'What happens when a patient writes outside business hours?', a: 'Your agent responds 24/7. You configure what it can resolve alone and what waits for the next business day.' },
    ].map(faq => (
      <div class="faq-item">
        <div style="padding:1.25rem 0;font-weight:600;font-size:1rem;color:var(--ink);">{faq.q}</div>
        <div class="faq-answer">{faq.a}</div>
      </div>
    ))}
  </div>
</PageBand>

<PageCta
  lang="en"
  source="product_omnichannel_cta"
  title="Deploy your front desk"
  titleAccent="on every channel."
  lead="Connect WhatsApp, Instagram, and Messenger. One inbox, one history per patient."
/>

</BaseLayout>

<style>
  @media (max-width: 900px) {
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
