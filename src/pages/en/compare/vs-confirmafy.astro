---
import ComparePage from '../../../components/ComparePage.astro';

const compareRows = [
  { feature: 'Appointment reminders', shadia: true, competitor: true },
  { feature: 'Smart rescheduling', shadia: true, competitor: 'Basic' },
  { feature: 'Waitlist / fill open slots', shadia: true, competitor: false },
  { feature: 'AI receptionist 24/7', shadia: true, competitor: false },
  { feature: 'Clinical sessions & summaries', shadia: true, competitor: false },
  { feature: 'Omnichannel (WhatsApp, IG, Messenger)', shadia: true, competitor: false },
  { feature: 'Patient reactivation', shadia: true, competitor: false },
  { feature: 'Clinic-focused workflows', shadia: true, competitor: 'Reminders only' },
];

const faqs = [
  {
    q: "What's the difference between Shadia AI and Confirmafy?",
    a: 'Confirmafy specializes in appointment reminders. Shadia is the clinic platform: reminders, AI receptionist, documented sessions, and patient follow-up in one place.',
  },
  {
    q: 'Should I use Confirmafy or Shadia for my clinic?',
    a: 'If you only need basic reminders, Confirmafy may be enough. If you want front desk, scheduling, and documentation with AI, Shadia is the complete option.',
  },
];
---

<ComparePage
  lang="en"
  competitor="Confirmafy"
  competitorSlug="confirmafy"
  title="Shadia AI vs Confirmafy. Full clinic ops vs reminders | Shadia AI"
  description="Confirmafy reminds patients. Shadia confirms, reschedules, documents sessions, and runs front desk in chat."
  canonical="https://shadia.ai/en/compare/vs-confirmafy"
  ogImage="/og/compare-confirmafy-en.png"
  heroHeadline="Shadia AI vs Confirmafy. More than reminders"
  heroSubheadline="Confirmafy reminds the appointment. Shadia runs the practice: reception, schedule, and clinical sessions."
  verdictPoints={[
    'Reminders + rescheduling + waitlist',
    'AI receptionist and clinical sessions included',
    'Patients informed with post-visit summaries',
    'One system vs fragmented tools',
    'Built for modern clinics',
  ]}
  compareRows={compareRows}
  detailedText={`<h2>What Confirmafy does well</h2><p>Confirmafy is effective for appointment reminders. Simple and focused if that is your only need.</p><h2>What clinics need after the reminder</h2><p>When a patient cancels, who fills the slot? Who answers after hours? Who documents the visit and sends the summary?</p><p>Shadia covers that loop: confirm, reschedule, document, and follow up, without stacking more tools.</p>`}
  migrationText="If you use Confirmafy, you can migrate in under a day: connect messaging, turn on reminders, and activate the AI receptionist."
  faqs={faqs}
/>
