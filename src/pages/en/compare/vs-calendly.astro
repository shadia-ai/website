---
import ComparePage from '../../../components/ComparePage.astro';

const compareRows = [
  { feature: 'Scheduling in patient chat', shadia: true, competitor: false },
  { feature: 'AI receptionist', shadia: true, competitor: false },
  { feature: 'Answers patient questions', shadia: true, competitor: false },
  { feature: 'Chat reminders', shadia: true, competitor: 'Email mainly' },
  { feature: 'Waitlist / fill open slots', shadia: true, competitor: false },
  { feature: 'Clinical sessions & summaries', shadia: true, competitor: false },
  { feature: 'Reschedule in conversation', shadia: true, competitor: 'Via link' },
  { feature: 'No external booking link required', shadia: true, competitor: false },
];

const faqs = [
  {
    q: 'Why use Shadia instead of Calendly for a clinic?',
    a: 'Calendly is a booking link. Shadia talks to patients, answers questions, confirms, fills gaps, and documents visits. It is practice operations, not just a calendar.',
  },
  {
    q: 'Can Shadia replace Calendly for patient appointments?',
    a: 'For most clinics, yes. Patients confirm in chat without opening an external form.',
  },
];
---

<ComparePage
  lang="en"
  competitor="Calendly"
  competitorSlug="calendly"
  title="Shadia AI vs Calendly. Clinic scheduling in chat | Shadia AI"
  description="Calendly uses booking links. Shadia schedules patients in chat with AI, confirms visits, fills gaps, and documents sessions."
  canonical="https://shadia.ai/en/compare/vs-calendly"
  ogImage="/og/compare-calendly-en.png"
  heroHeadline="Shadia AI vs Calendly. Book in chat, not a link"
  heroSubheadline="Calendly assumes patients will open a link. Shadia schedules, confirms, and follows up where patients already message."
  verdictPoints={[
    'Shadia books in chat; Calendly needs an external link',
    'AI receptionist answers questions; Calendly only shows slots',
    'Native reminders and waitlist',
    'Clinical sessions on the same platform',
    'Built for clinics, not just B2B meetings',
  ]}
  compareRows={compareRows}
  detailedText={`<h2>What Calendly does well</h2><p>Calendly is excellent for coordinating meetings between professionals. Simple and universal for demos and calls.</p><h2>Why clinics need more</h2><p>Patients already message your practice. Sending them to a link adds friction and no-shows.</p><p>Shadia confirms, reschedules, and fills gaps in conversation, and documents visits with clinical sessions.</p>`}
  migrationText="Import your appointment types and availability. Soon your AI receptionist can book in chat."
  faqs={faqs}
/>
