---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';

const differentiators = [
  { icon: 'clipboard', title: 'Clinical sessions with AI', desc: 'Record the visit, update the chart, and generate clinician + patient summaries.' },
  { icon: 'bot', title: 'AI Receptionist', desc: 'Book, confirm, and answer patients 24/7, with smart human handoff.' },
  { icon: 'calendar', title: 'Native appointments', desc: 'No Calendly. Confirmations, waitlists, and fewer no-shows in chat.' },
  { icon: 'message-square', title: 'Built for modern clinics', desc: 'Messaging-first workflows designed for front desk + clinical documentation.' },
];

const competitors = [
  { name: 'Calendly', slug: 'vs-calendly', desc: 'Booking links vs conversational scheduling for patients.', priority: true },
  { name: 'Confirmafy', slug: 'vs-confirmafy', desc: 'Appointment reminders vs a full clinical ops platform.', priority: true },
  { name: 'Heidi', slug: 'vs-heidi', desc: 'Clinical scribe vs sessions + front desk + appointments together.', priority: true },
  { name: 'Traditional front desk', slug: 'vs-traditional-front-desk', desc: 'The hidden cost of running the practice on people and spreadsheets alone.', priority: false },
];
---

<BaseLayout
  title="Compare. Shadia AI vs Calendly, Confirmafy, Heidi | Shadia AI"
  description="Compare Shadia AI with scheduling and clinical documentation tools. Sessions, receptionist, and appointments for clinics."
  lang="en"
  canonical="https://shadia.ai/en/compare"
  ogImage="/og/compare-en.png"
>
  <PageHero
    eyebrow="Compare"
    title="Choose with clarity,"
    titleAccent="not hype."
    lead="Shadia combines clinical sessions, AI receptionist, and appointments, built for modern clinics."
  />

  <PageBand variant="muted" size="sm">
    <div class="container" style="max-width: 720px;">
      <div class="page-grid-2">
        {differentiators.map(d => (
          <div class="card page-card">
            <div style="display:flex;align-items:center;margin-bottom:0.625rem;color:var(--accent);"><Icon name={d.icon} size={20} /></div>
            <h3 class="page-card__title" style="font-size:0.9375rem;">{d.title}</h3>
            <p class="page-card__desc" style="font-size:0.8125rem;margin-bottom:0;">{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>

  <PageBand variant="plain">
    <div class="container">
      <div class="page-section-head">
        <h2 class="section-title">Detailed comparisons</h2>
      </div>
      <div class="page-grid-3">
        {competitors.map(c => (
          <a href={`/en/compare/${c.slug}`} class="page-card-link">
            <div class:list={['card', 'page-card', c.priority && 'page-card--featured']}>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;">
                <h3 class="page-card__title" style="font-size:1rem;">Shadia vs {c.name}</h3>
                {c.priority && <span class="pill-badge" style="font-size:0.6875rem;padding:0.15rem 0.5rem;">Popular</span>}
              </div>
              <p class="page-card__desc" style="font-size:0.8125rem;">{c.desc}</p>
              <span class="page-card__link">See comparison →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </PageBand>

  <PageCta
    lang="en"
    source="compare_index_cta"
    title="Try it in your practice"
    titleAccent="with a demo."
    lead="Connect your channels and see sessions, front desk, and appointments in action."
  />
</BaseLayout>
