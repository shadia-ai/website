---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageBand from '../../components/PageBand.astro';
import PageCta from '../../components/PageCta.astro';
import IndustryCarousel from '../../components/IndustryCarousel.tsx';

const enterpriseSlides = [
  {
    tag: 'Multi-site',
    stat1: '50+',
    stat1Label: 'Locations operating\non one platform',
    stat2: '99.9%',
    stat2Label: 'Uptime SLA with\ndedicated infrastructure',
    insight: 'Hospital networks cannot depend on tools that do not scale across locations.',
    detail: 'Shadia unifies front desk, appointments, clinical sessions, and patient communication across every site, with centralized roles, permissions, and reporting.',
  },
  {
    tag: 'Clinical operations',
    stat1: '85%',
    stat1Label: 'Front desk inquiries\nresolved without staff',
    stat2: '40%',
    stat2Label: 'Average no-show reduction\nwith AI reminders',
    insight: 'Less administrative load means more clinical time for your team.',
    detail: 'The AI receptionist handles FAQs, confirms appointments, and sends pre-visit prep. Your team steps in only when the case requires it.',
  },
  {
    tag: 'Clinical teams',
    stat1: '3x',
    stat1Label: 'More patient capacity\nwithout hiring front desk staff',
    stat2: '24/7',
    stat2Label: 'Front desk coverage\nwithout overnight shifts',
    insight: 'Every front desk hire has hidden cost: training, turnover, shift coverage.',
    detail: 'Shadia absorbs routine volume so front desk, nursing, and admin focus on what requires human judgment.',
  },
  {
    tag: 'Privacy',
    stat1: 'RBAC',
    stat1Label: 'Role-based access\nacross the network',
    stat2: 'BAA',
    stat2Label: 'Business Associate Agreement\navailable for enterprise',
    insight: 'In healthcare, patient data confidentiality is not optional.',
    detail: 'Encryption in transit and at rest, granular permissions by role and site, configurable retention, and full audit logs. Designed for healthcare privacy expectations with BAA available for enterprise accounts.',
  },
];

const lang = 'en';

const features = [
  {
    icon: 'lock',
    title: 'Clinical security & privacy',
    desc: 'TLS/AES-256 encryption, access audit logs, role-based access, and configurable retention. Designed for healthcare privacy expectations.',
  },
  {
    icon: 'users',
    title: 'Multi-site roles & permissions',
    desc: 'Define what each role sees and does, front desk, nursing, clinicians, admin, by location, specialty, or channel.',
  },
  {
    icon: 'clipboard',
    title: 'Clinical sessions at scale',
    desc: 'AI scribe across the network. Specialty templates, review-before-save, and export for clinical integration.',
  },
  {
    icon: 'calendar',
    title: 'Centralized scheduling',
    desc: 'Unified calendar by location, provider, and room. Automatic reminders, in-chat rescheduling, and utilization reports.',
  },
  {
    icon: 'bot',
    title: 'AI receptionist per location',
    desc: 'Agents configured by site, specialty, and tone. Smart escalation to human staff with full context.',
  },
  {
    icon: 'bar-chart',
    title: 'Network reporting',
    desc: 'Dashboards by location, specialty, and channel. CSAT, no-shows, response times, and cross-site comparisons.',
  },
];

const stats = [
  { value: '< 30 s', label: 'Average AI receptionist response time' },
  { value: '85%', label: 'Inquiries resolved without human intervention' },
  { value: '24/7', label: 'Front desk available at every location' },
  { value: '50+', label: 'Sites supported in one account' },
];
---

<BaseLayout
  lang={lang}
  title="Shadia AI Enterprise. Clinical platform for hospital networks"
  description="Shadia AI Enterprise: multi-site, clinical roles, AI receptionist, clinical sessions, and security designed for hospital networks and health systems."
>
  <PageHero
    eyebrow="Enterprise"
    title="Clinical AI that scales"
    titleAccent="with your network."
    lead="Multi-site, clinical roles, AI receptionist, and clinical sessions, with the security and control a serious healthcare operation demands."
    narrow={false}
  >
    <div class="page-hero__actions">
      <button class="btn-primary" style="padding: 0.75rem 1.75rem; font-size: 1rem;" data-open-modal>Talk to sales</button>
      <a href="/en/pricing" class="btn-secondary" style="padding: 0.75rem 1.75rem; font-size: 1rem;">View plans</a>
    </div>
  </PageHero>

  <PageBand variant="muted" size="sm">
    <div class="container">
      <div class="page-stats-row">
        {stats.map(s => (
          <div>
            <div class="page-stat__value">{s.value}</div>
            <div class="page-stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </PageBand>

  <PageBand variant="plain">
    <div class="container">
      <div class="page-section-head">
        <h2 class="section-title">Everything a hospital network needs</h2>
        <p class="lead-sm">Full control over front desk, scheduling, clinical documentation, and patient communication.</p>
      </div>
      <div class="page-grid-3" style="max-width:none;">
        {features.map(f => (
          <div class="card page-card">
            <div style="display:flex;align-items:center;margin-bottom:1rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
            <h3 class="page-card__title">{f.title}</h3>
            <p class="page-card__desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>

  <PageBand variant="tint">
    <div class="container" style="max-width: 900px;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
        <div>
          <div style="font-size: 0.8125rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem;">Security & privacy</div>
          <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: 700; letter-spacing: -0.03em; color: var(--ink); margin-bottom: 1rem;">
            Patient data. Only yours.
          </h2>
          <p style="font-size: 1rem; color: var(--ink-3); line-height: 1.7; margin-bottom: 1.5rem;">
            We never use your conversations or clinical notes to train models. Encryption in transit and at rest. Automatic backups and configurable retention by location.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem;">
            {['TLS/AES-256 encryption', 'Full audit log', 'Role & site-based access control', 'Configurable data retention', 'No training on your data', 'BAA available for enterprise'].map(item => (
              <li style="display: flex; align-items: center; gap: 0.625rem; font-size: 0.9375rem; color: var(--ink-2);">
                <span style="width: 18px; height: 18px; border-radius: 50%; background: var(--accent-bg); border: 1px solid var(--accent-ring); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="card" style="padding: 2rem;">
          <h3 style="font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 1.25rem;">Dedicated Enterprise support</h3>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {[
              { icon: 'zap', title: 'Guided clinical onboarding', desc: 'Dedicated implementation with your technical and clinical teams' },
              { icon: 'phone', title: 'Account Manager', desc: 'A direct point of contact for your network' },
              { icon: 'zap', title: 'Priority SLA', desc: 'Guaranteed response time < 4 hours' },
              { icon: 'wrench', title: 'Custom integrations', desc: 'EHR/EMR connectors and internal system integrations' },
            ].map(item => (
              <div style="display: flex; gap: 0.875rem; align-items: flex-start;">
                <span style="font-size: 1.25rem; flex-shrink: 0; line-height: 1;"><Icon name={item.icon} size={20} /></span>
                <div>
                  <div style="font-size: 0.9375rem; font-weight: 600; color: var(--ink); margin-bottom: 0.125rem;">{item.title}</div>
                  <div style="font-size: 0.875rem; color: var(--ink-3);">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </PageBand>

  <PageBand variant="muted">
    <div class="container">
      <IndustryCarousel slides={enterpriseSlides} eyebrow="Why hospital networks choose Shadia" client:load />
    </div>
  </PageBand>

  <PageCta
    lang={lang}
    source="enterprise_cta"
    title="Ready to unify"
    titleAccent="your clinical network?"
    lead="Talk to our team and we'll show you how Shadia AI adapts to your multi-site operation."
  />
</BaseLayout>

<style>
  @media (max-width: 860px) {
    .page-band .container > div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
  }
</style>
