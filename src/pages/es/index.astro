---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupInput from '../../components/SignupInput.tsx';
import Icon from '../../components/Icon.astro';
import { SessionFloatComposition, InboxFloatPreview } from '../../components/FloatWidgets.tsx';
import { t } from '../../i18n/utils';

const pillars = [
  { label: 'Sesiones', title: t('pillars.sessions.title', 'es'), desc: t('pillars.sessions.desc', 'es'), href: '/es/producto/sesiones' },
  { label: 'Recepción', title: t('pillars.receptionist.title', 'es'), desc: t('pillars.receptionist.desc', 'es'), href: '/es/producto/recepcionista' },
  { label: 'Citas', title: t('pillars.appointments.title', 'es'), desc: t('pillars.appointments.desc', 'es'), href: '/es/producto/citas' },
];

const workflowSteps = [
  { n: '1', title: 'Grabar', desc: 'El médico activa Shadia al iniciar la consulta. Audio capturado de forma segura, con consentimiento.' },
  { n: '2', title: 'Expediente', desc: 'La IA transcribe y estructura la información directamente en el historial del paciente.' },
  { n: '3', title: 'Resumen médico', desc: 'Nota clínica clara con hallazgos, diagnóstico y plan, lista para revisión.' },
  { n: '4', title: 'Versión paciente', desc: 'El mismo encuentro, en lenguaje simple, sin jerga médica.' },
  { n: '5', title: 'Canal', desc: 'El resumen se envía por WhatsApp apenas el médico aprueba.' },
];

const liveScenarios = [
  { event: t('live.scenario1.event', 'es'), reaction: t('live.scenario1.reaction', 'es') },
  { event: t('live.scenario2.event', 'es'), reaction: t('live.scenario2.reaction', 'es') },
  { event: t('live.scenario3.event', 'es'), reaction: t('live.scenario3.reaction', 'es') },
  { event: t('live.scenario4.event', 'es'), reaction: t('live.scenario4.reaction', 'es') },
];

const specialties = [
  { title: t('industries.clinics.title', 'es'), href: '/es/especialidades/clinicas', icon: 'stethoscope' },
  { title: t('industries.dental.title', 'es'), href: '/es/especialidades/odontologia', icon: 'tooth' },
  { title: t('industries.mental.title', 'es'), href: '/es/especialidades/salud-mental', icon: 'heart' },
  { title: t('industries.aesthetics.title', 'es'), href: '/es/especialidades/estetica', icon: 'sparkles' },
  { title: t('industries.hospitals.title', 'es'), href: '/es/especialidades/hospitales', icon: 'building' },
];

const trustItems = [
  { icon: 'lock', title: 'Encriptación de extremo a extremo', desc: 'Conversaciones y datos clínicos protegidos en tránsito y en reposo.' },
  { icon: 'user', title: 'Roles y permisos', desc: 'Cada miembro del equipo ve solo la información que necesita para su función.' },
  { icon: 'clipboard', title: 'Auditoría completa', desc: 'Registro de cada interacción con timestamp y usuario responsable.' },
];
---

<BaseLayout
  title={t('meta.home.title', 'es')}
  description={t('meta.home.desc', 'es')}
  lang="es"
  canonical="https://shadia.ai/es/"
  ogImage="/og/home-es.png"
>

<section class="home-band hero-mesh section-lg" style="padding-bottom: 3rem;">
  <div class="container-wide hero-split">
    <div>
      <div class="pill-badge" style="margin-bottom: 1.25rem;">
        <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent);"></span>
        Para clínicas que viven en WhatsApp
      </div>
      <h1 class="hero-title" style="margin-bottom: 1.25rem;">
        {t('hero.headline', 'es')}
      </h1>
      <p class="lead" style="margin-bottom: 1.5rem; max-width: 32rem;">
        {t('hero.subheadline', 'es')}
      </p>
      <SignupInput lang="es" source="home_hero" size="lg" client:load />
      <p class="lead-sm" style="margin-top: 0.875rem;">Sin tarjeta de crédito · Configuración en 24h</p>
    </div>
    <div>
      <SessionFloatComposition lang="es" client:load />
    </div>
  </div>
</section>

<section class="home-band home-band--plain section">
  <div class="container-wide">
    <div class="section-intro" style="margin-bottom: 2.5rem;">
      <div class="eyebrow">Producto</div>
      <h2 class="section-title" style="margin-bottom: 0.75rem;">{t('pillars.heading', 'es')}</h2>
    </div>
    <div class="pillar-grid">
      {pillars.map(p => (
        <a href={p.href} class="pillar-card" style="text-decoration: none; color: inherit;">
          <span class="pillar-card__label">{p.label}</span>
          <h3 class="pillar-card__title">{p.title}</h3>
          <p class="pillar-card__desc">{p.desc}</p>
          <span class="pillar-card__link">Ver más →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="home-band home-band--muted section">
  <div class="container-wide">
    <div class="section-intro" style="margin-bottom: 2.5rem;">
      <div class="eyebrow">Sesiones clínicas</div>
      <h2 class="section-title" style="margin-bottom: 0.75rem;">De la consulta al mensaje</h2>
      <p class="lead-sm">Shadia documenta la visita y envía el resumen. El médico revisa y aprueba; no tiene que escribir la nota desde cero.</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:1rem;max-width:820px;">
      {workflowSteps.map(s => (
        <div style="display:flex;gap:1.25rem;align-items:flex-start;padding:1.125rem 1.375rem;background:var(--bg-elevated);border:1px solid var(--border);border-radius:14px;">
          <div style="width:34px;height:34px;border-radius:50%;background:var(--accent);color:#fff;font-weight:700;font-size:0.8125rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.n}</div>
          <div>
            <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.25rem;">{s.title}</h3>
            <p style="font-size:0.9rem;color:var(--ink-3);margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
    <p style="margin-top: 2rem;">
      <a href="/es/producto/sesiones" class="btn-secondary">Ver sesiones clínicas →</a>
    </p>
  </div>
</section>

<section class="home-band home-band--tint section">
  <div class="container-wide section-split section-split--reverse">
    <div class="section-split__visual">
      <InboxFloatPreview lang="es" client:load />
    </div>
    <div class="section-intro">
      <div class="eyebrow">Recepción 24/7</div>
      <h2 class="section-title" style="margin-bottom: 1rem;">{t('live.heading', 'es')}</h2>
      <p class="lead" style="margin-bottom: 1.5rem;">{t('live.subheading', 'es')}</p>
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0.875rem;">
        {liveScenarios.map(s => (
          <div class="live-item">
            <strong>{s.event}</strong>
            <span>✦ {s.reaction}</span>
          </div>
        ))}
      </div>
      <a href="/es/producto/recepcionista" class="btn-ghost" style="margin-top: 1.5rem; display: inline-flex;">Ver recepcionista IA →</a>
    </div>
  </div>
</section>

<section class="home-band home-band--plain section">
  <div class="container-wide">
    <div class="section-intro" style="margin-bottom: 2.5rem;">
      <div class="eyebrow">Especialidades</div>
      <h2 class="section-title" style="margin-bottom: 0.75rem;">{t('industries.heading', 'es')}</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem;">
      {specialties.map(s => (
        <a href={s.href} class="card-feature" style="text-decoration:none;color:inherit;text-align:center;">
          <div style="display:flex;align-items:center;justify-content:center;margin-bottom:0.75rem;color:var(--accent);"><Icon name={s.icon} size={22} /></div>
          <h3 style="font-size:0.9375rem;font-weight:600;margin:0;">{s.title}</h3>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="home-band home-band--muted section">
  <div class="container-wide">
    <div class="section-intro" style="margin-bottom: 2.5rem;">
      <div class="eyebrow">Privacidad</div>
      <h2 class="section-title" style="margin-bottom: 0.75rem;">Datos de salud con controles claros</h2>
      <p class="lead-sm">Encriptación, permisos por rol y un registro de quién hizo qué.</p>
    </div>
    <div class="grid-3">
      {trustItems.map(f => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;">{f.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="home-band home-band--dark section" style="overflow: hidden;">
  <div class="home-band__glow" aria-hidden="true"></div>
  <div class="container-wide">
    <div class="hero-split" style="align-items: center;">
      <div>
        <h2 class="hero-title" style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem;">
          {t('final_cta.headline', 'es')}
        </h2>
        <p class="lead" style="margin-bottom: 1.75rem; max-width: 26rem;">
          {t('final_cta.desc', 'es')}
        </p>
        <SignupInput lang="es" source="home_footer_cta" size="lg" client:load />
      </div>
      <div style="display: flex; justify-content: flex-end; opacity: 0.9;">
        <div class="home-band__quote">
          <p>"En la clínica dejamos de perder citas por mensajes que nadie alcanzaba a ver."</p>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  @media (max-width: 720px) {
    [style*="grid-template-columns: repeat(2,minmax(0,1fr))"] { grid-template-columns: 1fr !important; }
  }
</style>
