---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHeroSplit from '../../../components/ProductHeroSplit.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import { InboxFloatPreview } from '../../../components/FloatWidgets.tsx';
import { Check } from 'lucide-react';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '¿Los agentes IA de Shadia funcionan con el API oficial de WhatsApp?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. Shadia usa la API oficial de WhatsApp Business, lo que garantiza que tu número no será bloqueado y tienes acceso a todas las funciones premium incluyendo plantillas, catálogos y llamadas.' } },
    { '@type': 'Question', name: '¿Cuántos miembros del equipo pueden colaborar en conversaciones?', acceptedAnswer: { '@type': 'Answer', text: 'En el plan PRO tienes hasta 8 agentes. En ULTRA, con asientos ilimitados vía addon. Cada miembro ve el historial completo y puede colaborar con notas internas.' } },
    { '@type': 'Question', name: '¿La IA reemplaza a mi equipo?', acceptedAnswer: { '@type': 'Answer', text: 'No. El agente IA gestiona el volumen y escala al humano correcto. Tu equipo decide qué respuestas aprobar y cuándo intervenir.' } },
  ],
};
---

<BaseLayout
  title="Agentes IA omnicanal — Atención en todos tus canales | Shadia AI"
  description="Despliega agentes IA en WhatsApp, Instagram, Facebook y TikTok. Resolución autónoma con escalación inteligente y contexto completo para tu equipo."
  lang="es"
  canonical="https://shadia.ai/es/producto/omnicanal"
  ogImage="/og/omnicanal-es.png"
  jsonLd={faqSchema}
>

<ProductHeroSplit
  badge="Omnicanal"
  title="Agentes IA en"
  titleAccent="todos tus canales."
  lead="Un agente en WhatsApp, Instagram, Facebook y TikTok. Resuelve volumen rutinario; tu equipo interviene con historial completo — sin cambiar de app ni repetir preguntas."
  lang="es"
  source="product_omnicanal_hero"
  hint="Sin tarjeta de crédito · Gratis para empezar"
>
  <InboxFloatPreview lang="es" client:load />
</ProductHeroSplit>

<PageBand variant="muted" size="sm">
  <div class="container">
    <div class="page-stats-row">
      {[
        { v: '< 3 min', l: 'Tiempo de primera respuesta' },
        { v: '94%', l: 'Mensajes resueltos por IA' },
        { v: '0', l: 'Conversaciones perdidas' },
        { v: '24/7', l: 'Disponibilidad del agente IA' },
      ].map(s => (
        <div>
          <div class="page-stat__value" style="color: var(--accent);">{s.v}</div>
          <div class="page-stat__label">{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Capacidades</div>
      <h2 class="section-title">Todo lo que tus agentes IA necesitan a escala</h2>
    </div>
    <div class="grid-3">
      {[
        { icon: 'zap', title: 'Respuestas asistidas por IA', desc: 'Tu agente sugiere respuestas con el historial del cliente. Aprueba o edita con un clic. Tu equipo responde 5x más rápido.' },
        { icon: 'users', title: 'Colaboración en equipo', desc: 'Asigna conversaciones, deja notas internas, ve quién atiende qué. Nunca más dos agentes respondiendo al mismo cliente.' },
        { icon: 'bar-chart', title: 'Inteligencia de contactos', desc: 'Historial completo por contacto, etiquetas, notas y seguimiento del ciclo de vida — integrado, sin herramientas externas.' },
        { icon: 'search', title: 'Búsqueda instantánea', desc: 'Encuentra cualquier mensaje en segundos. Filtra por canal, agente, etiqueta, fecha o busca en el contenido de mensajes.' },
        { icon: 'bot', title: 'Automatización inteligente', desc: 'Respuestas automáticas para FAQs, bienvenidas, fuera de horario y más. Sin código, visual y configurable.' },
        { icon: 'trending-up', title: 'Analítica de resolución', desc: 'Métricas en tiempo real: tiempos de respuesta, resolución, satisfacción y rendimiento por miembro y canal.' },
      ].map(f => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;">{f.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Antes y después</div>
      <h2 class="section-title">La diferencia es inmediata</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
      <div style="padding:1.75rem;background:rgba(239,68,68,0.04);border:1px solid rgba(239,68,68,0.15);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#ef4444;margin-bottom:1.25rem;">Sin Shadia</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Mensajes perdidos entre WhatsApp, Instagram y Email', 'Respuestas tardías que pierden ventas', 'Sin historial centralizado del cliente', 'Equipo confundido sobre quién atiende qué', 'Imposible escalar sin contratar más personal'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink-3);">
              <span style="color:#ef4444;flex-shrink:0;">✗</span>{item}
            </li>
          ))}
        </ul>
      </div>
      <div style="padding:1.75rem;background:rgba(34,197,94,0.04);border:1px solid rgba(34,197,94,0.2);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#22c55e;margin-bottom:1.25rem;">Con agentes Shadia</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Todos los canales conectados, cero pérdidas', 'IA responde en segundos, 24/7 sin intervención', 'Historial completo del cliente en un solo lugar', 'Asignación automática + notas internas', 'Escala sin contratar: los agentes manejan el volumen'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink);">
              <Check size={15} style={{ color: '#22c55e', flexShrink: 0, marginTop: '2px' }} />{item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Cómo funciona</div>
      <h2 class="section-title">Empieza en minutos, no días</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:1.5rem;">
      {[
        { n: '1', title: 'Conecta tus canales', desc: 'WhatsApp Business API, Instagram, Facebook, Email — todos en un click. Sin configuración técnica compleja.' },
        { n: '2', title: 'Configura tu agente IA', desc: 'Dale contexto de negocio, respuestas frecuentes y reglas de escalación. Lenguaje natural, sin código.' },
        { n: '3', title: 'Invita a tu equipo', desc: 'Añade miembros, define roles y permisos. Cada uno ve solo lo que necesita.' },
        { n: '4', title: 'La IA empieza a trabajar', desc: 'Desde el primer mensaje, tu agente responde, clasifica y escala. Tu equipo aprueba y refina.' },
      ].map(s => (
        <div class="card" style="display:flex;gap:1.25rem;align-items:flex-start;padding:1.5rem;">
          <div style="width:40px;height:40px;border-radius:50%;background:var(--accent);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.n}</div>
          <div>
            <h3 style="font-size:1.0625rem;font-weight:700;margin-bottom:0.375rem;">{s.title}</h3>
            <p style="font-size:0.9375rem;color:var(--ink-3);margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container page-section-head" style="max-width:760px;">
    <div class="eyebrow">Integraciones</div>
    <h2 class="section-title">Conecta con las herramientas que ya usas</h2>
    <p class="lead-sm" style="margin-bottom:2.5rem;">Shadia se integra nativamente con los sistemas más populares. Sin Zapier, sin código.</p>
    <div class="product-channel-bar">
      {['WhatsApp Business API', 'Google Workspace', 'HubSpot', 'Salesforce', 'Calendly', 'Stripe', 'Shopify', 'Notion', 'Zapier', 'Slack', 'Twilio', 'Mailchimp'].map(int => (
        <span class="channel-badge">{int}</span>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container" style="max-width:680px;">
    <div class="page-section-head">
      <div class="eyebrow">FAQ</div>
      <h2 class="section-title">Preguntas frecuentes</h2>
    </div>
    {[
      { q: '¿Funciona con la API oficial de WhatsApp?', a: 'Sí. Usamos la API oficial de WhatsApp Business, garantizando que tu número no sea bloqueado y que tengas acceso a todas las funciones premium.' },
      { q: '¿Cuántos miembros del equipo pueden colaborar?', a: 'En PRO hasta 8 miembros; en ULTRA, con asientos adicionales sin límite. Cada uno ve el historial completo y puede colaborar con notas internas.' },
      { q: '¿La IA reemplaza a mi equipo de atención?', a: 'No. El agente IA gestiona el volumen y escala al humano correcto. Tu equipo decide qué respuestas aprobar y cuándo intervenir.' },
      { q: '¿Qué pasa si el cliente escribe fuera del horario?', a: 'Tu agente IA responde las 24 horas. Puedes configurar qué solicitudes maneja solo y cuáles esperan al siguiente día hábil.' },
    ].map(faq => (
      <div class="faq-item">
        <div style="padding:1.25rem 0;font-weight:600;font-size:1rem;color:var(--ink);">{faq.q}</div>
        <div class="faq-answer">{faq.a}</div>
      </div>
    ))}
  </div>
</PageBand>

<PageCta
  lang="es"
  source="product_omnicanal_cta"
  title="Despliega tus agentes"
  titleAccent="en todos tus canales."
  lead="Conecta WhatsApp, Instagram, Facebook y TikTok hoy — un agente, resolución consistente."
/>

</BaseLayout>

<style>
  @media (max-width: 900px) {
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
