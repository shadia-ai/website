---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHeroSplit from '../../../components/ProductHeroSplit.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import { InboxFloatPreview } from '../../../components/FloatWidgets.tsx';
import { Check } from 'lucide-react';
import { t } from '../../../i18n/utils';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '¿Shadia funciona con el API oficial de WhatsApp Business?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. Shadia usa la API oficial de WhatsApp Business, lo que garantiza que el número de tu clínica no será bloqueado y tienes acceso a todas las funciones premium.' } },
    { '@type': 'Question', name: '¿Cuántos miembros del equipo pueden colaborar en las conversaciones?', acceptedAnswer: { '@type': 'Answer', text: 'En el plan PRO tienes hasta 8 miembros de tu equipo. En ULTRA, asientos ilimitados vía addon. Cada uno ve el historial completo del paciente y puede colaborar con notas internas.' } },
    { '@type': 'Question', name: '¿La IA reemplaza a mi recepción?', acceptedAnswer: { '@type': 'Answer', text: 'No. El agente gestiona el volumen rutinario y escala al miembro del equipo correcto. Tu personal decide qué respuestas aprobar y cuándo intervenir.' } },
  ],
};
---

<BaseLayout
  title={t('meta.omnichannel.title', 'es')}
  description={t('meta.omnichannel.desc', 'es')}
  lang="es"
  canonical="https://shadia.ai/es/producto/omnicanal"
  ogImage="/og/omnicanal-es.png"
  jsonLd={faqSchema}
>

<ProductHeroSplit
  badge="Omnicanal clínico"
  title="Un agente, todo el"
  titleAccent="contexto del paciente."
  lead="WhatsApp, Instagram y Messenger en un solo inbox clínico. El agente resuelve lo rutinario; tu equipo entra con el historial completo, sin saltar de app ni pedirle al paciente que repita todo."
  lang="es"
  source="product_omnicanal_hero"
  hint="Sin tarjeta de crédito · Gratis para empezar"
>
  <InboxFloatPreview lang="es" client:load />
</ProductHeroSplit>

<PageBand variant="muted" size="sm">
  <div class="container">
    <div class="page-stats-row">
      {[
        { v: '< 3 min', l: 'Tiempo de primera respuesta' },
        { v: '90%+', l: 'Mensajes resueltos por el agente' },
        { v: '0', l: 'Conversaciones de pacientes perdidas' },
        { v: '24/7', l: 'Disponibilidad del agente IA' },
      ].map(s => (
        <div>
          <div class="page-stat__value" style="color: var(--accent);">{s.v}</div>
          <div class="page-stat__label">{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Capacidades</div>
      <h2 class="section-title">Todo lo que necesita la recepción de tu clínica</h2>
    </div>
    <div class="grid-3">
      {[
        { icon: 'zap', title: 'Respuestas con contexto del paciente', desc: 'El agente sugiere respuestas con el historial clínico y de citas del paciente. Aprueba o edita con un clic.' },
        { icon: 'users', title: 'Colaboración del equipo', desc: 'Asigna conversaciones a recepción, enfermería o al médico correspondiente. Nunca dos personas respondiendo al mismo paciente.' },
        { icon: 'bar-chart', title: 'Historial del paciente', desc: 'Citas, mensajes y notas centralizadas por paciente, sin herramientas externas ni hojas de cálculo.' },
        { icon: 'search', title: 'Búsqueda instantánea', desc: 'Encuentra cualquier conversación en segundos. Filtra por canal, paciente, etiqueta o fecha.' },
        { icon: 'bot', title: 'Automatización de rutina', desc: 'Respuestas automáticas para FAQs, bienvenida, fuera de horario y preparación de visita. Sin código.' },
        { icon: 'trending-up', title: 'Analítica de resolución', desc: 'Tiempos de respuesta, tasa de resolución y volumen por canal, en tiempo real.' },
      ].map(f => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;">{f.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Antes y después</div>
      <h2 class="section-title">La diferencia es inmediata</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
      <div style="padding:1.75rem;background:rgba(239,68,68,0.04);border:1px solid rgba(239,68,68,0.15);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#ef4444;margin-bottom:1.25rem;">Sin Shadia</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Mensajes de pacientes perdidos entre WhatsApp e Instagram', 'Respuestas tardías que terminan en citas perdidas', 'Sin historial centralizado del paciente', 'Equipo confundido sobre quién atiende cada caso', 'Imposible escalar sin contratar más recepción'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink-3);">
              <span style="color:#ef4444;flex-shrink:0;">✗</span>{item}
            </li>
          ))}
        </ul>
      </div>
      <div style="padding:1.75rem;background:rgba(34,197,94,0.04);border:1px solid rgba(34,197,94,0.2);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#22c55e;margin-bottom:1.25rem;">Con agentes Shadia</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Todos los canales conectados, cero mensajes perdidos', 'El agente responde en segundos, 24/7', 'Historial completo del paciente en un solo lugar', 'Asignación automática + notas internas del equipo', 'Escala sin contratar: el agente absorbe el volumen'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink);">
              <Check size={15} style={{ color: '#22c55e', flexShrink: 0, marginTop: '2px' }} />{item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Cómo funciona</div>
      <h2 class="section-title">Empieza en minutos, no días</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:1.5rem;">
      {[
        { n: '1', title: 'Conecta tus canales', desc: 'WhatsApp Business API, Instagram y Messenger, todos en un click. Sin configuración técnica compleja.' },
        { n: '2', title: 'Configura tu agente', desc: 'Dale el contexto de tu clínica: especialidad, horarios, políticas y reglas de escalación. Lenguaje natural, sin código.' },
        { n: '3', title: 'Invita a tu equipo', desc: 'Recepción, enfermería y médicos, cada uno con el rol y los permisos que necesita.' },
        { n: '4', title: 'El agente empieza a trabajar', desc: 'Desde el primer mensaje, responde, agenda y escala. Tu equipo aprueba y refina.' },
      ].map(s => (
        <div class="card" style="display:flex;gap:1.25rem;align-items:flex-start;padding:1.5rem;">
          <div style="width:40px;height:40px;border-radius:50%;background:var(--accent);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.n}</div>
          <div>
            <h3 style="font-size:1.0625rem;font-weight:700;margin-bottom:0.375rem;">{s.title}</h3>
            <p style="font-size:0.9375rem;color:var(--ink-3);margin:0;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container page-section-head" style="max-width:760px;">
    <div class="eyebrow">Integraciones</div>
    <h2 class="section-title">Conecta con las herramientas que ya usas</h2>
    <p class="lead-sm" style="margin-bottom:2.5rem;">Shadia se integra nativamente con los sistemas más comunes en clínicas. Sin Zapier, sin código.</p>
    <div class="product-channel-bar">
      {['WhatsApp Business API', 'Google Calendar', 'Google Workspace', 'Zoom', 'Calendly', 'Twilio', 'Slack', 'Notion', 'Zapier'].map(int => (
        <span class="channel-badge">{int}</span>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container" style="max-width:680px;">
    <div class="page-section-head">
      <div class="eyebrow">FAQ</div>
      <h2 class="section-title">Preguntas frecuentes</h2>
    </div>
    {[
      { q: '¿Funciona con el API oficial de WhatsApp?', a: 'Sí. Usamos la API oficial de WhatsApp Business, garantizando que el número de tu clínica no sea bloqueado y con acceso completo a funciones premium.' },
      { q: '¿Cuántos miembros del equipo pueden colaborar?', a: 'En PRO hasta 8 miembros; en ULTRA, asientos adicionales sin límite. Cada uno ve el historial completo del paciente y puede dejar notas internas.' },
      { q: '¿La IA reemplaza a mi recepción?', a: 'No. El agente gestiona el volumen rutinario y escala al miembro del equipo correcto. Tu personal decide qué aprobar y cuándo intervenir.' },
      { q: '¿Qué pasa si un paciente escribe fuera de horario?', a: 'El agente responde las 24 horas. Configuras qué solicitudes resuelve solo y cuáles esperan al siguiente día hábil.' },
    ].map(faq => (
      <div class="faq-item">
        <div style="padding:1.25rem 0;font-weight:600;font-size:1rem;color:var(--ink);">{faq.q}</div>
        <div class="faq-answer">{faq.a}</div>
      </div>
    ))}
  </div>
</PageBand>

<PageCta
  lang="es"
  source="product_omnicanal_cta"
  title="Despliega tu recepción"
  titleAccent="en todos los canales."
  lead="Conecta WhatsApp, Instagram y Messenger. Un inbox, un historial por paciente."
/>

</BaseLayout>

<style>
  @media (max-width: 900px) {
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
