---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHeroSplit from '../../../components/ProductHeroSplit.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import { AgentFloatPreview } from '../../../components/FloatWidgets.tsx';

const threads = [
  {
    title: '¿Qué pasó con este paciente?',
    msg: '@shadia dame un resumen de la última visita del paciente que preguntó por sus resultados la semana pasada.',
    response: 'El jueves pasado tuvo consulta de seguimiento con el Dr. Pérez. Se ajustó la dosis y quedó control en 4 semanas. El resumen se envió por WhatsApp y aún no lo ha confirmado. ¿Quieres que le dé seguimiento?',
    time: 'hace 2 min',
  },
  {
    title: 'Redacta un mensaje',
    msg: '@shadia redacta un mensaje para el paciente que no llegó a su cita esta mañana.',
    response: 'Aquí tienes una propuesta: "Hola [Nombre], notamos que no pudiste asistir a tu cita de hoy. ¿Quieres que te ayudemos a reagendar? Tenemos espacio esta semana." ¿La envío?',
    time: 'hace 15 min',
  },
  {
    title: 'Analiza la semana',
    msg: '@shadia ¿cómo fue la ocupación de la agenda esta semana comparado con la anterior?',
    response: 'Esta semana: 84 citas (+12%), 6 no-shows (-40% vs. semana pasada), 91% confirmadas por WhatsApp sin intervención. El Dr. Pérez tuvo la agenda más ocupada. 3 pacientes en lista de espera sin contactar aún.',
    time: 'ayer',
  },
];
---

<BaseLayout
  title="Shadia Agent. El copiloto IA de tu equipo clínico | Shadia AI"
  description="Shadia Agent trabaja con tu equipo clínico: resume pacientes, redacta mensajes, analiza la ocupación de la agenda y ejecuta acciones, todo en lenguaje natural, mencionando @shadia."
  lang="es"
  canonical="https://shadia.ai/es/producto/agente"
  ogImage="/og/agente-es.png"
>

<ProductHeroSplit
  badge="✦ Shadia Agent"
  title="La IA que trabaja"
  titleAccent="junto a tu equipo."
  lead="Shadia Agent vive dentro de la operación de tu clínica. Pregúntale por un paciente, pide un borrador de mensaje, revisa la ocupación de la agenda o escala un caso escribiendo @shadia."
  lang="es"
  source="product_agent_hero"
>
  <AgentFloatPreview lang="es" client:load />
</ProductHeroSplit>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Casos de uso</div>
      <h2 class="section-title">
        Pregunta lo que necesites.<br/>
        <span class="headline-accent">Shadia tiene el contexto clínico.</span>
      </h2>
    </div>
    <div class="grid-3">
      {[
        { q: '"¿Qué pasó con el paciente X?"', a: 'Shadia revisa el historial de visitas y mensajes y te da un resumen con contexto completo.' },
        { q: '"Redacta un mensaje de seguimiento"', a: 'Shadia genera un mensaje apropiado según el caso, el tono de tu clínica y el historial del paciente.' },
        { q: '"¿Cómo fue la ocupación esta semana?"', a: 'Obtén métricas de citas, no-shows y confirmaciones por canal al instante.' },
        { q: '"Marca a este paciente para seguimiento"', a: 'Shadia actualiza el perfil, añade la etiqueta y notifica al miembro del equipo responsable.' },
        { q: '"¿Cuántas citas hay mañana?"', a: 'Shadia consulta la agenda y te da el resumen con los detalles de cada cita y proveedor.' },
        { q: '"Escala este caso al médico responsable"', a: 'Shadia crea una notificación interna, asigna el caso y añade el contexto clínico necesario.' },
      ].map(item => (
        <div class="card-feature">
          <div style="font-size: 0.875rem; font-weight: 700; color: var(--accent); margin-bottom: 0.625rem; font-style: italic; line-height: 1.4;">{item.q}</div>
          <p style="font-size: 0.9375rem; color: var(--ink-3); line-height: 1.65;">{item.a}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 860px;">
    <div class="hero-split" style="align-items: start;">
      <div>
        <div class="eyebrow">Threads</div>
        <h2 class="section-title" style="margin-bottom: 1.25rem;">
          Organiza la operación<br/>
          <span class="headline-accent">en threads inteligentes.</span>
        </h2>
        <p class="lead-sm" style="margin-bottom: 2rem;">
          Crea threads para cualquier tarea o pregunta de la clínica. Shadia recuerda el contexto de cada conversación
          y puede retomar donde lo dejaste. Comparte threads con tu equipo o mantenlos privados.
        </p>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
          {[
            'Contexto persistente por thread',
            'Comparte threads con tu equipo clínico',
            'Menciona a Shadia con @shadia',
            'Archiva o fija threads importantes',
            'Historial completo de la operación',
          ].map(item => (
            <li style="display: flex; align-items: center; gap: 0.625rem; font-size: 0.9375rem; color: var(--ink-3);">
              <span style="color: var(--accent); font-weight: 700;">✓</span> {item}
            </li>
          ))}
        </ul>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.875rem;">
        {threads.map((t, i) => (
          <div class="card" style={`padding: 1.125rem 1.25rem; opacity: ${i === 0 ? 1 : 0.65};`}>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
              <span style="font-weight: 600; font-size: 0.875rem; color: var(--ink);">{t.title}</span>
              <span style="font-size: 0.6875rem; color: var(--ink-4);">{t.time}</span>
            </div>
            <p style="font-size: 0.8125rem; color: var(--ink-3); margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{t.msg}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Para equipos clínicos</div>
      <h2 class="section-title">
        Diseñado para que<br/>
        <span class="headline-accent">todo tu equipo trabaje junto.</span>
      </h2>
    </div>
    <div class="grid-4">
      {[
        { icon: '@', title: 'Menciones', desc: 'Menciona a Shadia o a un colega en cualquier thread.' },
        { icon: 'eye', title: 'Presencia', desc: 'Ve quién está activo y qué está atendiendo en tiempo real.' },
        { icon: 'message-square', title: 'Reacciones', desc: 'Reacciona a mensajes del equipo con emojis para dar contexto rápido.' },
        { icon: 'folder', title: 'Folders', desc: 'Organiza threads por proveedor, especialidad o tipo de caso.' },
        { icon: 'tag', title: 'Tags', desc: 'Etiqueta threads y pacientes para filtrar y encontrar lo que necesitas.' },
        { icon: '↩', title: 'Respuestas en hilo', desc: 'Responde a mensajes específicos manteniendo el contexto del thread.' },
        { icon: 'paperclip', title: 'Adjuntos', desc: 'Comparte documentos, imágenes y resultados directamente en los threads.' },
        { icon: 'user', title: 'Pacientes', desc: 'Organiza el contexto por paciente y ve toda su actividad reciente.' },
      ].map(f => (
        <div class="card-feature" style="text-align: center;">
          <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--accent-bg); border: 1px solid var(--accent-ring); display: flex; align-items: center; justify-content: center; font-size: 1.125rem; margin: 0 auto 0.875rem; color: var(--accent); font-weight: 700;"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size: 0.9375rem; font-weight: 600; margin-bottom: 0.375rem; color: var(--ink);">{f.title}</h3>
          <p style="font-size: 0.8125rem; color: var(--ink-3); line-height: 1.6;">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageCta
  lang="es"
  source="product_agent_cta"
  title="Incluido en todos los planes."
  titleAccent="Empieza con @shadia."
  lead="Shadia Agent viene con todos los planes. Sin configuraciones complicadas: escribe @shadia y listo."
>
  <p class="lead-sm" style="margin-top: 0.75rem; text-align: center;">Sin tarjeta de crédito · Incluido en todos los planes</p>
</PageCta>

</BaseLayout>

<style>
  @media (max-width: 900px) {
    .grid-4 { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>
