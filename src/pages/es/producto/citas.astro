---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHeroSplit from '../../../components/ProductHeroSplit.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';
import { AppointmentsFloatComposition } from '../../../components/FloatWidgets.tsx';

const citasSlides = [
  {
    tag: 'No-shows',
    stat1: '70%',
    stat1Label: 'Menos no-shows con\nrecordatorios automáticos',
    stat2: '48h + 2h',
    stat2Label: 'Ventanas de recordatorio\nque maximizan la confirmación',
    insight: 'Los no-shows no son inevitables — son el resultado de no contactar al paciente en el momento correcto.',
    detail: 'Shadia envía recordatorios automáticos en los momentos de mayor efectividad y solicita confirmación. Si no hay respuesta, el agente reagenda antes de que el hueco quede vacío.',
  },
  {
    tag: 'Disponibilidad 24/7',
    stat1: '40%',
    stat1Label: 'De citas solicitadas\nfuera del horario de atención',
    stat2: '< 30 s',
    stat2Label: 'Tiempo de confirmación\ndel agente IA',
    insight: 'Tu agenda no para cuando tu equipo se va. Tampoco debería parar la posibilidad de agendar.',
    detail: 'Shadia captura cada solicitud en tiempo real, consulta disponibilidad y confirma la cita en segundos — a cualquier hora, en WhatsApp. Cero llamadas perdidas, cero solicitudes ignoradas.',
  },
  {
    tag: 'Reactivación',
    stat1: '1 de 4',
    stat1Label: 'Clientes inactivos\nque regresan con IA',
    stat2: '6 meses',
    stat2Label: 'Umbral para activar\ncampaña de reactivación',
    insight: 'El cliente que no ha regresado en 6 meses no está perdido — solo nadie lo ha contactado.',
    detail: 'Shadia identifica los contactos sin cita reciente y lanza mensajes de reactivación personalizados. No campañas masivas — mensajes que se sienten individuales y oportunos.',
  },
  {
    tag: 'Productividad',
    stat1: '3 hrs',
    stat1Label: 'Diarias que se recuperan\nal automatizar la gestión',
    stat2: '0',
    stat2Label: 'Llamadas manuales\nnecesarias con Shadia activo',
    insight: 'Cada hora que tu equipo pasa gestionando la agenda es una hora que no pasa con clientes reales.',
    detail: 'Confirmaciones, reagendamientos, recordatorios y captura de nuevas citas — todo automatizado. Tu equipo se dedica a la atención, no a la logística.',
  },
];
---

<BaseLayout
  title="Motor de Citas IA — Agenda Automática | Shadia AI"
  description="Automatiza citas, confirmaciones y recordatorios con IA. Tu calendario siempre lleno, sin intervención humana. Integración con Google Calendar y WhatsApp."
  lang="es"
  canonical="https://shadia.ai/es/producto/citas"
  ogImage="/og/citas-es.png"
>

<ProductHeroSplit
  badge="Motor de Citas"
  title="Un agente IA llena tu calendario."
  titleAccent="Sin formularios. Sin fricción."
  lead="El agente conversa, entiende disponibilidad y confirma la cita directamente. Agenda, confirma, reagenda y elimina no-shows — sin que tu equipo intervenga."
  lang="es"
  source="product_citas_hero"
  hint="Sin tarjeta de crédito · Gratis para empezar"
>
  <AppointmentsFloatComposition lang="es" client:load />
</ProductHeroSplit>

<PageBand variant="plain" size="sm">
  <div class="container">
    <div class="page-stats-row">
      {[
        { v: '85%', l: 'Reducción de no-shows' },
        { v: '24/7', l: 'Disponibilidad para agendar' },
        { v: '3 min', l: 'Cita confirmada en' },
        { v: '0', l: 'Conflictos de horario' },
      ].map(s => (
        <div>
          <div class="page-stat__value" style="color: var(--accent);">{s.v}</div>
          <div class="page-stat__label">{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Funcionalidades</div>
      <h2 class="section-title">Citas automáticas, de principio a fin</h2>
    </div>
    <div class="grid-3">
      {[
        { icon: 'bot', title: 'Agenda autónoma', desc: 'El agente IA recibe la solicitud, verifica disponibilidad y confirma la cita sin intervención humana.' },
        { icon: 'bell', title: 'Recordatorios inteligentes', desc: 'WhatsApp, SMS y email con timing óptimo. El cliente confirma con un tap. No-shows eliminados.' },
        { icon: 'refresh-cw', title: 'Reagendamiento fácil', desc: 'El cliente puede cambiar su cita respondiendo el recordatorio. El agente actualiza el calendario automáticamente.' },
        { icon: 'calendar', title: 'Sincronización de calendarios', desc: 'Google Calendar, Outlook, Apple Calendar — todos sincronizados en tiempo real. Sin dobles reservas.' },
        { icon: 'zap', title: 'Reglas de disponibilidad', desc: 'Define horarios, servicios, duración, tiempos de preparación y máximo de citas simultáneas por servicio.' },
        { icon: 'bar-chart', title: 'Reportes de ocupación', desc: 'Ve cuándo está lleno tu calendario, qué servicios se agendan más y optimiza tu disponibilidad.' },
      ].map(f => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;">{f.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Antes y Después</div>
      <h2 class="section-title">Del caos de agenda al control total</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
      <div style="padding:1.75rem;background:rgba(239,68,68,0.04);border:1px solid rgba(239,68,68,0.15);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#ef4444;margin-bottom:1.25rem;">Sin Shadia</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Clientes esperando confirmación por horas', 'No-shows sin recordatorio previo', 'Doble booking por error humano', 'Recepcionista tomando citas manualmente', 'Sin datos de ocupación ni optimización'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink-3);">
              <span style="color:#ef4444;flex-shrink:0;">✗</span>{item}
            </li>
          ))}
        </ul>
      </div>
      <div style="padding:1.75rem;background:rgba(34,197,94,0.04);border:1px solid rgba(34,197,94,0.2);border-radius:18px;">
        <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#22c55e;margin-bottom:1.25rem;">Con Motor de Citas</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {['Cita confirmada en 3 minutos por WhatsApp', '85% menos no-shows con recordatorios automáticos', 'Cero doble booking, calendario en tiempo real', 'Tu equipo enfocado en atender, no en agendar', 'Reportes de ocupación y tendencias'].map(item => (
            <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.9375rem;color:var(--ink);">
              <span style="color:var(--green);font-weight:700;flex-shrink:0;">✓</span>{item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Casos de Uso</div>
      <h2 class="section-title">Perfecto para cualquier negocio con agenda</h2>
    </div>
    <div class="grid-4">
      {[
        { icon: 'heart', title: 'Clínicas y consultorios', desc: 'Citas médicas, recordatorios pre-consulta, reagendamiento automático.' },
        { icon: 'scissors', title: 'Salones de belleza', desc: 'Servicios múltiples, diferentes duraciones, evita espacios vacíos.' },
        { icon: 'graduation-cap', title: 'Academias y tutores', desc: 'Clases individuales, grupos, sesiones de prueba gratuitas.' },
        { icon: 'activity', title: 'Fitness y bienestar', desc: 'Entrenamientos personales, clases grupales, evaluaciones iniciales.' },
      ].map(u => (
        <div class="card-feature">
          <div style="display:flex;align-items:center;margin-bottom:0.875rem;color:var(--accent);"><Icon name={u.icon} size={20} /></div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.375rem;">{u.title}</h3>
          <p style="font-size:0.875rem;line-height:1.65;">{u.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="tint">
  <div class="container" style="max-width: 860px;">
    <div class="page-section-head">
      <div class="eyebrow">Flujo de Cita</div>
      <h2 class="section-title">Una cita, cinco pasos automáticos</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:1rem;">
      {[
        { n: '1', title: 'El cliente solicita cita por WhatsApp', desc: 'El agente detecta la intención, solicita fecha/servicio y verifica disponibilidad en tiempo real.' },
        { n: '2', title: 'Confirmación instantánea', desc: 'Se confirma la cita, se envía resumen y se añade al calendario del cliente y al tuyo.' },
        { n: '3', title: 'Recordatorio 24h antes', desc: 'WhatsApp o email automático con todos los detalles. El cliente responde S/N para confirmar.' },
        { n: '4', title: 'Recordatorio 1h antes', desc: 'Segundo recordatorio con dirección, indicaciones y opción de reagendar si es necesario.' },
        { n: '5', title: 'Post-cita y seguimiento', desc: 'Encuesta de satisfacción y recordatorio de próxima cita. El ciclo se repite sin esfuerzo.' },
      ].map(s => (
        <div style="display:flex;gap:1.25rem;align-items:flex-start;padding:1.25rem 1.5rem;background:var(--surface-raised);border:1px solid var(--border);border-radius:14px;">
          <div style="width:36px;height:36px;border-radius:50%;background:#0EA5E9;color:#fff;font-weight:700;font-size:0.875rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{s.n}</div>
          <div>
            <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.25rem;">{s.title}</h3>
            <p style="font-size:0.9rem;color:var(--ink-3);">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="muted">
  <div class="container">
    <div class="page-section-head">
      <div class="eyebrow">Por los números</div>
      <h2 class="section-title">Lo que cambia con el motor de citas</h2>
    </div>
    <div class="page-grid-2">
      {citasSlides.map(slide => (
        <div class="card page-card">
          <span class="pill-badge" style="margin-bottom: 1rem; width: fit-content;">{slide.tag}</span>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div>
              <div class="page-stat__value" style="font-size: 1.75rem;">{slide.stat1}</div>
              <p class="page-card__desc" style="white-space: pre-line; margin: 0;">{slide.stat1Label}</p>
            </div>
            <div>
              <div class="page-stat__value" style="font-size: 1.75rem;">{slide.stat2}</div>
              <p class="page-card__desc" style="white-space: pre-line; margin: 0;">{slide.stat2Label}</p>
            </div>
          </div>
          <p class="page-card__title" style="margin-bottom: 0.5rem;">{slide.insight}</p>
          <p class="page-card__desc">{slide.detail}</p>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageBand variant="plain">
  <div class="container" style="max-width:680px;">
    <div class="page-section-head">
      <div class="eyebrow">FAQ</div>
      <h2 class="section-title">Preguntas frecuentes</h2>
    </div>
    {[
      { q: '¿Funciona con Google Calendar?', a: 'Sí. Sincronización bidireccional en tiempo real. Las citas aparecen en tu Google Calendar automáticamente y los bloqueos del calendario se respetan.' },
      { q: '¿Puedo tener múltiples servicios con duraciones distintas?', a: 'Sí. Defines cada servicio con su duración, precio, tiempo de preparación y disponibilidad específica.' },
      { q: '¿Qué pasa si el cliente necesita cancelar?', a: 'El agente gestiona la cancelación, libera el slot y puede ofrecer una nueva fecha de inmediato. Tú recibes notificación en tiempo real.' },
      { q: '¿Funciona para negocios con múltiples empleados?', a: 'Sí. Cada empleado tiene su propio calendario y disponibilidad. El agente distribuye las citas de forma inteligente.' },
    ].map(faq => (
      <div class="faq-item">
        <div style="padding:1.25rem 0;font-weight:600;font-size:1rem;color:var(--ink);">{faq.q}</div>
        <div class="faq-answer">{faq.a}</div>
      </div>
    ))}
  </div>
</PageBand>

<PageCta
  lang="es"
  source="product_citas_cta"
  title="Tu calendario lleno"
  titleAccent="empieza hoy"
  lead="Activa el motor de citas y deja que la IA llene tu agenda automáticamente."
/>

</BaseLayout>

<style>
  @media (max-width: 900px) {
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
