---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageBand from '../../components/PageBand.astro';
import PageCta from '../../components/PageCta.astro';
import IndustryCarousel from '../../components/IndustryCarousel.tsx';

const lang = 'es';

const enterpriseSlides = [
  {
    tag: 'Multi-sede',
    stat1: '50+',
    stat1Label: 'Sedes operando\nen una sola plataforma',
    stat2: '99.9%',
    stat2Label: 'SLA de disponibilidad\ncon infraestructura dedicada',
    insight: 'Las redes hospitalarias no pueden depender de herramientas que no escalan entre sedes.',
    detail: 'Shadia unifica recepción, citas, sesiones clínicas y comunicación con pacientes en todas tus sedes, con roles, permisos y reportes centralizados.',
  },
  {
    tag: 'Operación clínica',
    stat1: '85%',
    stat1Label: 'Consultas de recepción\nresueltas sin intervención humana',
    stat2: '40%',
    stat2Label: 'Reducción promedio\nde no-shows con recordatorios IA',
    insight: 'Menos carga administrativa significa más tiempo clínico para tu equipo.',
    detail: 'La recepcionista IA atiende consultas frecuentes, confirma citas y envía preparación pre-visita. Tu equipo interviene solo cuando el caso lo requiere.',
  },
  {
    tag: 'Equipos clínicos',
    stat1: '3x',
    stat1Label: 'Más capacidad de atención\nsin contratar recepcionistas',
    stat2: '24/7',
    stat2Label: 'Cobertura de recepción\nsin turnos nocturnos',
    insight: 'Cada contratación de recepción tiene costo oculto: capacitación, rotación, cobertura de turnos.',
    detail: 'Shadia absorbe el volumen rutinario para que recepción, enfermería y administración se enfoquen en lo que requiere criterio humano.',
  },
  {
    tag: 'Privacidad',
    stat1: 'RBAC',
    stat1Label: 'Control de acceso por rol\nen toda la red',
    stat2: 'Audit',
    stat2Label: 'Registro completo\nde accesos y acciones',
    insight: 'En salud, la confidencialidad de los datos del paciente no es opcional.',
    detail: 'Cifrado en tránsito y en reposo, permisos granulares por rol y sede, retención configurable y auditoría completa. Diseñado para las expectativas de privacidad en atención médica.',
  },
];

const features = [
  {
    icon: 'lock',
    title: 'Seguridad y privacidad clínica',
    desc: 'Cifrado TLS/AES-256, auditoría de accesos, control de acceso por rol y retención configurable. Diseñado para proteger la confidencialidad del paciente.',
  },
  {
    icon: 'users',
    title: 'Roles y permisos multi-sede',
    desc: 'Define qué ve y hace cada rol, recepción, enfermería, médicos, administración, por sede, especialidad o canal.',
  },
  {
    icon: 'clipboard',
    title: 'Sesiones clínicas a escala',
    desc: 'Scribe con IA para toda la red. Plantillas por especialidad, revisión antes de guardar y exportación para integración clínica.',
  },
  {
    icon: 'calendar',
    title: 'Citas centralizadas',
    desc: 'Calendario unificado por sede, médico y sala. Recordatorios automáticos, reagendamiento por chat y reportes de ocupación.',
  },
  {
    icon: 'bot',
    title: 'Recepcionista IA por sede',
    desc: 'Agentes configurados por ubicación, especialidad y tono. Escalación inteligente al equipo humano con contexto completo.',
  },
  {
    icon: 'bar-chart',
    title: 'Reportes de red',
    desc: 'Dashboards por sede, especialidad y canal. CSAT, no-shows, tiempos de respuesta y comparativas entre centros.',
  },
];

const stats = [
  { value: '< 30 s', label: 'Tiempo promedio de respuesta de recepción IA' },
  { value: '85%', label: 'Consultas resueltas sin intervención humana' },
  { value: '24/7', label: 'Recepción disponible en todas las sedes' },
  { value: '50+', label: 'Sedes soportadas en una sola cuenta' },
];
---

<BaseLayout
  lang={lang}
  title="Shadia AI Enterprise. Plataforma clínica para redes hospitalarias"
  description="Shadia AI Enterprise: multi-sede, roles clínicos, recepcionista IA, sesiones clínicas y seguridad diseñada para redes hospitalarias."
>
  <PageHero
    eyebrow="Enterprise"
    title="IA clínica que escala"
    titleAccent="con tu red."
    lead="Multi-sede, roles clínicos, recepcionista IA y sesiones clínicas, con la seguridad y control que exige una operación hospitalaria seria."
    narrow={false}
  >
    <div class="page-hero__actions">
      <button class="btn-primary" style="padding: 0.75rem 1.75rem; font-size: 1rem;" data-open-modal>Hablar con ventas</button>
      <a href="/es/precios" class="btn-secondary" style="padding: 0.75rem 1.75rem; font-size: 1rem;">Ver planes</a>
    </div>
  </PageHero>

  <PageBand variant="muted" size="sm">
    <div class="container">
      <div class="page-stats-row">
        {stats.map(s => (
          <div>
            <div class="page-stat__value">{s.value}</div>
            <div class="page-stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </PageBand>

  <PageBand variant="plain">
    <div class="container">
      <div class="page-section-head">
        <h2 class="section-title">Todo lo que necesita una red hospitalaria</h2>
        <p class="lead-sm">Control completo sobre recepción, citas, documentación clínica y comunicación con pacientes.</p>
      </div>
      <div class="page-grid-3" style="max-width:none;">
        {features.map(f => (
          <div class="card page-card">
            <div style="display:flex;align-items:center;margin-bottom:1rem;color:var(--accent);"><Icon name={f.icon} size={20} /></div>
            <h3 class="page-card__title">{f.title}</h3>
            <p class="page-card__desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>

  <PageBand variant="tint">
    <div class="container" style="max-width: 900px;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
        <div>
          <div style="font-size: 0.8125rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem;">Seguridad y privacidad</div>
          <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: 700; letter-spacing: -0.03em; color: var(--ink); margin-bottom: 1rem;">
            Los datos del paciente. Solo tuyos.
          </h2>
          <p style="font-size: 1rem; color: var(--ink-3); line-height: 1.7; margin-bottom: 1.5rem;">
            Nunca usamos tus conversaciones ni notas clínicas para entrenar modelos. Cifrado en tránsito y en reposo. Backups automáticos y retención configurable por sede.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem;">
            {['Cifrado TLS/AES-256', 'Audit log completo', 'Control de acceso por rol y sede', 'Retención de datos configurable', 'Sin entrenamiento con tus datos'].map(item => (
              <li style="display: flex; align-items: center; gap: 0.625rem; font-size: 0.9375rem; color: var(--ink-2);">
                <span style="width: 18px; height: 18px; border-radius: 50%; background: var(--accent-bg); border: 1px solid var(--accent-ring); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="card" style="padding: 2rem;">
          <h3 style="font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 1.25rem;">Soporte Enterprise dedicado</h3>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {[
              { icon: 'zap', title: 'Onboarding clínico guiado', desc: 'Implementación dedicada con tu equipo técnico y clínico' },
              { icon: 'phone', title: 'Account Manager', desc: 'Un punto de contacto directo para tu red' },
              { icon: 'zap', title: 'SLA prioritario', desc: 'Tiempo de respuesta garantizado < 4 horas' },
              { icon: 'wrench', title: 'Integraciones a medida', desc: 'Conectores EHR/HIS y sistemas internos de la red' },
            ].map(item => (
              <div style="display: flex; gap: 0.875rem; align-items: flex-start;">
                <span style="font-size: 1.25rem; flex-shrink: 0; line-height: 1;"><Icon name={item.icon} size={20} /></span>
                <div>
                  <div style="font-size: 0.9375rem; font-weight: 600; color: var(--ink); margin-bottom: 0.125rem;">{item.title}</div>
                  <div style="font-size: 0.875rem; color: var(--ink-3);">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </PageBand>

  <PageBand variant="muted">
    <div class="container">
      <IndustryCarousel slides={enterpriseSlides} eyebrow="Por qué las redes hospitalarias eligen Shadia" client:load />
    </div>
  </PageBand>

  <PageCta
    lang={lang}
    source="enterprise_cta"
    title="¿Listo para unificar"
    titleAccent="tu red clínica?"
    lead="Habla con nuestro equipo y te mostramos cómo Shadia AI se adapta a tu operación multi-sede."
  />
</BaseLayout>

<style>
  @media (max-width: 860px) {
    .page-band .container > div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
  }
</style>
