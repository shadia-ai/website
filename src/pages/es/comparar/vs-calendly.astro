---
import ComparePage from '../../../components/ComparePage.astro';

const compareRows = [
  { feature: 'Agendamiento por WhatsApp', shadia: true, competitor: false },
  { feature: 'Recepcionista IA conversacional', shadia: true, competitor: false },
  { feature: 'Responde preguntas del paciente', shadia: true, competitor: false },
  { feature: 'Recordatorios por WhatsApp', shadia: true, competitor: 'Solo email' },
  { feature: 'Lista de espera / llenar huecos', shadia: true, competitor: false },
  { feature: 'Sesiones clínicas y resúmenes', shadia: true, competitor: false },
  { feature: 'Reagendamiento por chat', shadia: true, competitor: 'Por link' },
  { feature: 'Sin link externo para el paciente', shadia: true, competitor: false },
];

const faqs = [
  {
    q: '¿Por qué usar Shadia en lugar de Calendly en una clínica?',
    a: 'Calendly es un link de agenda. Shadia habla con el paciente en WhatsApp, responde dudas, confirma, reagenda y además documenta sesiones. Es operación de clínica, no solo un calendario.',
  },
  {
    q: '¿Puede Shadia reemplazar Calendly para citas de pacientes?',
    a: 'Para la mayoría de clínicas sí. El paciente escribe por WhatsApp y confirma sin abrir un formulario externo.',
  },
];
---

<ComparePage
  lang="es"
  competitor="Calendly"
  competitorSlug="calendly"
  title="Shadia AI vs Calendly. Citas clínicas por WhatsApp | Shadia AI"
  description="Calendly usa links de agenda. Shadia agenda pacientes por WhatsApp con IA, confirma, llena huecos y documenta sesiones."
  canonical="https://shadia.ai/es/comparar/vs-calendly"
  ogImage="/og/compare-calendly-es.png"
  heroHeadline="Shadia AI vs Calendly. Citas en el chat, no en un link"
  heroSubheadline="Calendly asume que el paciente abrirá un enlace. Shadia agenda, confirma y da seguimiento donde ya escribe: WhatsApp."
  verdictPoints={[
    'Shadia agenda por WhatsApp; Calendly requiere un link',
    'Recepcionista IA responde preguntas; Calendly solo muestra horarios',
    'Recordatorios y lista de espera nativos',
    'Sesiones clínicas incluidas en la misma plataforma',
    'Pensada para clínicas, no solo reuniones B2B',
  ]}
  compareRows={compareRows}
  detailedText={`<h2>¿Qué hace bien Calendly?</h2><p>Calendly es excelente para coordinar reuniones entre profesionales. Es simple y universal para demos y calls.</p><h2>Por qué no alcanza para una clínica</h2><p>El paciente de una clínica ya está en WhatsApp. Pedirle que abra un link, elija un slot y llene un formulario añade fricción y no-shows.</p><p>Shadia confirma, reagenda y llena huecos en la conversación, y además documenta la consulta con sesiones clínicas.</p>`}
  migrationText="Importa tus tipos de cita y disponibilidad. En poco tiempo, tu recepcionista IA agenda por WhatsApp."
  faqs={faqs}
/>
