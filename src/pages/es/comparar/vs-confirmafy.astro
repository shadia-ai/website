---
import ComparePage from '../../../components/ComparePage.astro';

const compareRows = [
  { feature: 'Recordatorios de citas', shadia: true, competitor: true },
  { feature: 'Reagendamiento inteligente', shadia: true, competitor: 'Básico' },
  { feature: 'Lista de espera / llenar huecos', shadia: true, competitor: false },
  { feature: 'Recepcionista IA 24/7', shadia: true, competitor: false },
  { feature: 'Sesiones clínicas y resúmenes', shadia: true, competitor: false },
  { feature: 'Omnicanal (WhatsApp, IG, Messenger)', shadia: true, competitor: false },
  { feature: 'Reactivación de pacientes', shadia: true, competitor: false },
  { feature: 'Soporte en español', shadia: true, competitor: true },
];

const faqs = [
  {
    q: '¿Cuál es la diferencia entre Shadia AI y Confirmafy?',
    a: 'Confirmafy se especializa en recordatorios de citas. Shadia es la plataforma de la clínica: recordatorios, recepción IA, sesiones documentadas y seguimiento del paciente en un solo lugar.',
  },
  {
    q: '¿Debería usar Confirmafy o Shadia para mi clínica?',
    a: 'Si solo necesitas recordatorios básicos, Confirmafy puede bastar. Si quieres operar recepción, agenda y documentación con IA, Shadia es la opción completa.',
  },
];
---

<ComparePage
  lang="es"
  competitor="Confirmafy"
  competitorSlug="confirmafy"
  title="Shadia AI vs Confirmafy. Clínica completa vs solo recordatorios | Shadia AI"
  description="Confirmafy recuerda citas. Shadia confirma, reagenda, documenta sesiones y atiende pacientes por WhatsApp."
  canonical="https://shadia.ai/es/comparar/vs-confirmafy"
  ogImage="/og/compare-confirmafy-es.png"
  heroHeadline="Shadia AI vs Confirmafy. Más que recordatorios"
  heroSubheadline="Confirmafy recuerda la cita. Shadia opera la clínica: recepción, agenda y sesiones documentadas."
  verdictPoints={[
    'Recordatorios + reagendamiento + lista de espera',
    'Recepcionista IA y sesiones clínicas incluidas',
    'Pacientes informados con resumen post-consulta',
    'Un solo sistema vs herramientas fragmentadas',
    'Hecha para clínicas que trabajan por WhatsApp',
  ]}
  compareRows={compareRows}
  detailedText={`<h2>¿Qué hace bien Confirmafy?</h2><p>Confirmafy es efectiva para recordatorios de citas por WhatsApp. Simple, en español y económica si solo necesitas ese caso de uso.</p><h2>Lo que una clínica necesita después del recordatorio</h2><p>Cuando el paciente cancela, ¿quién llena el hueco? ¿Quién responde a las 10 PM? ¿Quién documenta la consulta y envía el resumen?</p><p>Shadia cubre ese ciclo: confirma, reagenda, documenta y da seguimiento, sin apilar más herramientas.</p>`}
  migrationText="Si usas Confirmafy, puedes migrar en menos de un día: conectamos WhatsApp, activamos recordatorios y dejamos lista la recepcionista IA."
  faqs={faqs}
/>
