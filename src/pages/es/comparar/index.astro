---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';

const differentiators = [
  { icon: 'clipboard', title: 'Sesiones clínicas con IA', desc: 'Graba la consulta, actualiza el expediente y genera resumen médico + versión paciente.' },
  { icon: 'bot', title: 'Recepcionista IA', desc: 'Agenda, confirma y responde pacientes 24/7 en WhatsApp, con handoff humano.' },
  { icon: 'calendar', title: 'Motor de citas nativo', desc: 'Sin Calendly. Confirmaciones, lista de espera y menos no-shows en el chat.' },
  { icon: 'message-square', title: 'Hecha para clínicas', desc: 'WhatsApp-first, en español, y flujos pensados para consultorios y clínicas.' },
];

const competitors = [
  { name: 'Calendly', slug: 'vs-calendly', desc: 'Links de agenda vs citas conversacionales por WhatsApp para pacientes.', priority: true },
  { name: 'Confirmafy', slug: 'vs-confirmafy', desc: 'Recordatorios de citas vs plataforma clínica completa.', priority: true },
  { name: 'Heidi', slug: 'vs-heidi', desc: 'Scribe clínico vs sesiones + recepción + citas en un solo lugar.', priority: true },
  { name: 'Recepcionista tradicional', slug: 'vs-recepcionista-tradicional', desc: 'El costo oculto de operar la clínica solo con personas y hojas de cálculo.', priority: false },
];
---

<BaseLayout
  title="Comparaciones. Shadia AI vs Calendly, Confirmafy, Heidi | Shadia AI"
  description="Compara Shadia AI con herramientas de agenda y documentación clínica. Sesiones, recepción y citas para clínicas."
  lang="es"
  canonical="https://shadia.ai/es/comparar"
  ogImage="/og/compare-es.png"
>
  <PageHero
    eyebrow="Comparaciones"
    title="Elige con datos,"
    titleAccent="no con marketing."
    lead="Shadia combina sesiones clínicas, recepcionista IA y citas, diseñada para cómo opera una clínica de verdad."
  />

  <PageBand variant="muted" size="sm">
    <div class="container" style="max-width: 720px;">
      <div class="page-grid-2">
        {differentiators.map(d => (
          <div class="card page-card">
            <div style="display:flex;align-items:center;margin-bottom:0.625rem;color:var(--accent);"><Icon name={d.icon} size={20} /></div>
            <h3 class="page-card__title" style="font-size:0.9375rem;">{d.title}</h3>
            <p class="page-card__desc" style="font-size:0.8125rem;margin-bottom:0;">{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>

  <PageBand variant="plain">
    <div class="container">
      <div class="page-section-head">
        <h2 class="section-title">Comparaciones detalladas</h2>
      </div>
      <div class="page-grid-3">
        {competitors.map(c => (
          <a href={`/es/comparar/${c.slug}`} class="page-card-link">
            <div class:list={['card', 'page-card', c.priority && 'page-card--featured']}>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;">
                <h3 class="page-card__title" style="font-size:1rem;">Shadia vs {c.name}</h3>
                {c.priority && <span class="pill-badge" style="font-size:0.6875rem;padding:0.15rem 0.5rem;">Popular</span>}
              </div>
              <p class="page-card__desc" style="font-size:0.8125rem;">{c.desc}</p>
              <span class="page-card__link">Ver comparación →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </PageBand>

  <PageCta
    lang="es"
    source="compare_index_cta"
    title="Pruébalo en tu clínica"
    titleAccent="con una demo."
    lead="Conecta WhatsApp y mira sesiones, recepción y citas en acción."
  />
</BaseLayout>
