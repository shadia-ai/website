---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageBand from '../../components/PageBand.astro';
import PageCta from '../../components/PageCta.astro';
import SignupInput from '../../components/SignupInput.tsx';

const sections = [
  {
    id: 'sesiones',
    title: 'Sesiones clínicas',
    subtitle: 'Documentación clínica mientras atiendes',
    desc: 'Shadia escucha la consulta, estructura la nota clínica y la deja lista para revisión, sin interrumpir la relación con el paciente.',
    icon: 'clipboard',
    features: [
      { name: 'Scribe clínico con IA', desc: 'Transcribe y estructura la consulta en tiempo real. Tú revisas y apruebas antes de guardar.' },
      { name: 'Plantillas por especialidad', desc: 'Notas adaptadas a consulta general, odontología, estética, salud mental y más.' },
      { name: 'Resumen post-consulta', desc: 'Genera un resumen claro para el expediente y las instrucciones de seguimiento al paciente.' },
      { name: 'Instrucciones al paciente', desc: 'Preparación pre-visita, medicación, cuidados post-procedimiento, redactados en lenguaje claro.' },
      { name: 'Historial de sesiones', desc: 'Cada consulta queda vinculada al perfil del paciente con contexto completo para el equipo.' },
      { name: 'Revisión antes de guardar', desc: 'Ninguna nota se publica sin aprobación del profesional. Control total sobre lo que entra al expediente.' },
      { name: 'Multi-profesional', desc: 'Varios médicos documentan en la misma clínica con plantillas y permisos por rol.' },
      { name: 'Exportación de notas', desc: 'Exporta notas aprobada en formatos estándar para integración con tu flujo clínico.' },
    ],
  },
  {
    id: 'recepcionista',
    title: 'Recepcionista IA',
    subtitle: 'La recepción que nunca cierra',
    desc: 'Responde preguntas frecuentes, califica consultas, agenda citas y escala al equipo humano solo cuando el caso lo requiere.',
    icon: 'bot',
    features: [
      { name: 'Atención 24/7 por WhatsApp', desc: 'Pacientes escriben a cualquier hora. Shadia responde, orienta y agenda sin esperas.' },
      { name: 'FAQs de la clínica', desc: 'Horarios, ubicación, servicios, precios orientativos y requisitos de la visita, respondidos al instante.' },
      { name: 'Calificación de consultas', desc: 'Identifica urgencia, tipo de servicio y si el paciente es nuevo o recurrente antes de agendar.' },
      { name: 'Escalación inteligente', desc: 'Casos sensibles, quejas o situaciones fuera de protocolo pasan al equipo con historial completo.' },
      { name: 'Tono de tu clínica', desc: 'Formal, cercano o clínico, la recepcionista habla como tu equipo, no como un bot genérico.' },
      { name: 'Preparación pre-visita', desc: 'Envía instrucciones de ayuno, documentos requeridos y confirmación de seguro antes de la cita.' },
      { name: 'Multi-sede', desc: 'Dirige al paciente a la ubicación correcta según servicio, médico o disponibilidad.' },
      { name: 'Handoff con contexto', desc: 'Cuando interviene un humano, ya sabe qué pidió el paciente, qué ofreció la IA y qué falta resolver.' },
    ],
  },
  {
    id: 'citas',
    title: 'Motor de citas',
    subtitle: 'Agendamiento autónomo, sin herramientas externas',
    desc: 'Shadia agenda, confirma, reconfirma y gestiona cancelaciones directamente en WhatsApp, sincronizado con el calendario de tu clínica.',
    icon: 'calendar',
    features: [
      { name: 'Agendamiento por WhatsApp', desc: 'El paciente pide cita en el chat y la recepcionista IA confirma en el mismo hilo.' },
      { name: 'Recordatorios automáticos', desc: 'WhatsApp 24h y 1h antes. El paciente confirma con una respuesta y reduce no-shows.' },
      { name: 'Reagendamiento por chat', desc: 'El paciente cambia la cita respondiendo al recordatorio. El calendario se actualiza al instante.' },
      { name: 'Sincronización Google Calendar', desc: 'Bidireccional en tiempo real por médico, sala o sede. Cero doble reserva.' },
      { name: 'Tipos de cita clínica', desc: 'Consulta inicial, seguimiento, procedimiento, teleconsulta, con duración y preparación específica.' },
      { name: 'Reglas de disponibilidad', desc: 'Horarios por médico, bloques quirúrgicos, días inhábiles y máximo de citas simultáneas.' },
      { name: 'Seguimiento post-cita', desc: 'Encuesta de satisfacción, recordatorio de control y próxima cita sugerida automáticamente.' },
      { name: 'Múltiples sedes', desc: 'Gestiona disponibilidad de consultorios, clínicas y centros desde un solo sistema.' },
    ],
  },
  {
    id: 'canales',
    title: 'Canales omnicanal',
    subtitle: 'Todos los canales, un solo expediente',
    desc: 'WhatsApp como canal principal, Instagram para estética, Facebook y TikTok para captar pacientes, todo unificado con contexto clínico.',
    icon: 'message-square',
    features: [
      { name: 'WhatsApp Business API oficial', desc: 'Canal principal para citas, recordatorios, resúmenes post-consulta y seguimiento clínico.' },
      { name: 'Instagram DMs y comentarios', desc: 'Ideal para clínicas de estética: responde consultas de procedimientos y agenda desde el DM.' },
      { name: 'Facebook Messenger', desc: 'Atiende la página de tu clínica y ofrece continuar en WhatsApp cuando el paciente lo prefiera.' },
      { name: 'TikTok DMs', desc: 'Convierte el interés de videos de estética o salud en consultas y citas reales.' },
      { name: 'Conversaciones unificadas', desc: 'Un paciente, un perfil. Sin importar el canal, el equipo ve el historial completo.' },
      { name: 'Switch a WhatsApp', desc: 'Mueve la conversación al canal que prefiera el paciente sin perder contexto.' },
      { name: 'Plantillas de WhatsApp', desc: 'Recordatorios de cita, instrucciones pre-visita y seguimiento con plantillas aprobadas.' },
      { name: 'Difusiones segmentadas', desc: 'Campañas de prevención, promociones de chequeo o recordatorios de control a segmentos de pacientes.' },
    ],
  },
  {
    id: 'pacientes',
    title: 'Pacientes y contactos',
    subtitle: 'Expediente unificado para cada paciente',
    desc: 'Historial de conversaciones, citas, notas clínicas y atributos del paciente en un solo perfil, sin hojas de cálculo ni sistemas paralelos.',
    icon: 'user',
    features: [
      { name: 'Perfil unificado del paciente', desc: 'Conversaciones, citas, sesiones clínicas, notas del equipo y atributos en un solo lugar.' },
      { name: 'Historial clínico conversacional', desc: 'Cada interacción queda registrada para que recepción, médicos y administración tengan contexto.' },
      { name: 'Tags y segmentación', desc: 'Etiqueta por especialidad, estado del tratamiento, seguro o campaña para filtrar y dar seguimiento.' },
      { name: 'Atributos personalizados (16 tipos)', desc: 'Cédula, seguro, alergias, médico tratante, consentimiento, modela cualquier dato clínico o administrativo.' },
      { name: 'Notas del equipo', desc: 'Recepción, enfermería y administración añaden contexto sin mezclarlo con la nota clínica.' },
      { name: 'Detección de duplicados', desc: 'Identifica pacientes duplicados por teléfono o nombre y sugiere unificarlos.' },
      { name: 'Importación/exportación CSV', desc: 'Migra tu base de pacientes existente y exporta segmentos para reportes o campañas.' },
      { name: 'Enmascarado de datos', desc: 'Oculta teléfonos y correos de roles que no los necesitan. Privacidad sin fricción operativa.' },
    ],
  },
  {
    id: 'automatizacion',
    title: 'Automatización',
    subtitle: 'Flujos clínicos que corren solos',
    desc: 'Desde la primera consulta hasta el seguimiento post-procedimiento, automatiza lo repetitivo para que tu equipo se enfoque en la atención.',
    icon: 'zap',
    features: [
      { name: 'Flujos de bienvenida', desc: 'Paciente nuevo recibe orientación, formulario de datos y opción de agendar en el primer contacto.' },
      { name: 'Recordatorios de cita', desc: 'Secuencia automática de confirmación, preparación pre-visita y alerta de no-show.' },
      { name: 'Seguimiento post-consulta', desc: 'Instrucciones de cuidado, encuesta de satisfacción y recordatorio de control programados.' },
      { name: 'Reactivación de pacientes', desc: 'Identifica pacientes inactivos y envía recordatorios de chequeo o control periódico.' },
      { name: 'Escalación por reglas', desc: 'Define cuándo la IA pasa al humano: urgencias, quejas, casos fuera de protocolo o solicitud explícita.' },
      { name: 'Asignación automática', desc: 'Enruta conversaciones al equipo correcto: recepción, facturación, especialista o sede.' },
      { name: 'Horarios de atención', desc: 'Mensajes automáticos fuera de horario con opción de dejar consulta o agendar para el día siguiente.' },
      { name: 'Mensajes programados', desc: 'Programa seguimientos, recordatorios de medicación o avisos de resultados para fecha y hora exacta.' },
    ],
  },
  {
    id: 'analitica',
    title: 'Analítica',
    subtitle: 'Datos para mejorar la operación clínica',
    desc: 'Mide tiempos de respuesta, ocupación del calendario, satisfacción del paciente y rendimiento por sede, en tiempo real.',
    icon: 'bar-chart',
    features: [
      { name: 'Dashboard en tiempo real', desc: 'Conversaciones activas, citas del día, tiempos de respuesta y carga del equipo.' },
      { name: 'Reportes de citas', desc: 'Ocupación por médico, servicios más solicitados, no-shows y tendencias semanales.' },
      { name: 'Satisfacción del paciente (CSAT)', desc: 'Encuestas automáticas post-consulta con métricas de satisfacción en tiempo real.' },
      { name: 'Reportes por canal', desc: 'Qué canal genera más citas: WhatsApp, Instagram, Facebook o TikTok.' },
      { name: 'Reportes por sede', desc: 'Compara rendimiento entre consultorios, clínicas o centros de la red.' },
      { name: 'Rendimiento del equipo', desc: 'Tiempos de respuesta, resolución y escalaciones por miembro del equipo.' },
      { name: 'Exportación CSV', desc: 'Descarga reportes para análisis externo, juntas directivas o auditorías internas.' },
      { name: 'Reportes personalizados (ULTRA)', desc: 'Métricas a medida para redes hospitalarias y operaciones multi-sede.' },
    ],
  },
  {
    id: 'seguridad',
    title: 'Seguridad y privacidad',
    subtitle: 'Protección de datos clínicos desde el diseño',
    desc: 'Cifrado, control de acceso por rol, auditoría y controles de retención, pensado para la confidencialidad que exige la atención médica.',
    icon: 'lock',
    features: [
      { name: 'Cifrado TLS + AES-256', desc: 'Datos en tránsito y en reposo cifrados con estándares enterprise.' },
      { name: 'Control de acceso por rol (RBAC)', desc: 'Recepción, enfermería, médicos y administración ven solo lo que corresponde a su función.' },
      { name: 'Auditoría completa', desc: 'Registro de quién accedió, modificó o exportó información del paciente.' },
      { name: 'Enmascarado de datos sensibles', desc: 'Oculta teléfonos, correos y datos identificables según el rol del usuario.' },
      { name: 'Retención configurable', desc: 'Define políticas de retención y eliminación de conversaciones y notas clínicas.' },
      { name: 'SSO / SAML (ULTRA)', desc: 'Inicio de sesión único para redes con directorio corporativo activo.' },
      { name: 'SLA de uptime 99.9%', desc: 'Infraestructura redundante con compromisos contractuales de disponibilidad.' },
      { name: 'Meta Business Partner', desc: 'Integración oficial verificada por Meta para WhatsApp con máxima seguridad.' },
      { name: 'Sin entrenamiento con tus datos', desc: 'Tus conversaciones y notas clínicas no se usan para entrenar modelos de IA.' },
    ],
  },
];
---

<BaseLayout
  title="Características. Plataforma clínica con IA | Shadia AI"
  description="Sesiones clínicas, recepcionista IA, citas, omnicanal, expediente del paciente, automatización, analítica y seguridad, todo en Shadia AI para clínicas."
  lang="es"
  canonical="https://shadia.ai/es/caracteristicas"
  ogImage="/og/features-es.png"
>

<PageHero
  eyebrow="Características"
  title="Todo lo que tu clínica"
  titleAccent="necesita con IA."
  lead="Sesiones clínicas, recepcionista IA, motor de citas, omnicanal, expediente del paciente, automatización y seguridad, en una sola plataforma."
  narrow={false}
>
  <div class="page-hero__actions">
    <SignupInput lang="es" source="features_page_hero" size="lg" client:load />
  </div>
</PageHero>

<div class="sticky-subnav">
  <div class="container sticky-subnav__inner">
    <div class="sticky-subnav__tabs">
      {sections.map(s => (
        <a href={`#${s.id}`} class="sticky-subnav__tab">
          <Icon name={s.icon} size={20} /> {s.title}
        </a>
      ))}
    </div>
  </div>
</div>

{sections.map((section, i) => (
  <PageBand id={section.id} variant={i % 2 === 0 ? 'plain' : 'muted'}>
    <div class="container">
      <!-- Section header -->
      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; margin-bottom: 3.5rem; align-items: start;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.875rem; background: var(--accent-bg); border: 1px solid var(--accent-ring); border-radius: 9999px; font-size: 0.6875rem; font-weight: 700; color: var(--accent); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1rem;">
            <Icon name={section.icon} size={20} /> {section.title}
          </div>
          <h2 style="font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 600; line-height: 1.2; color: var(--ink); margin-bottom: 0.875rem;">{section.subtitle}</h2>
        </div>
        <div>
          <p style="font-size: 1.0625rem; color: var(--ink-3); line-height: 1.75; margin: 0;">{section.desc}</p>
        </div>
      </div>

      <!-- Features grid -->
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 16px; overflow: hidden;">
        {section.features.map(f => (
          <div style="padding: 1.375rem 1.5rem; background: var(--bg);">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
              <span style="width: 18px; height: 18px; border-radius: 50%; background: var(--accent); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="9" height="9" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.3;">{f.name}</h3>
            </div>
            <p style="font-size: 0.8125rem; color: var(--ink-4); line-height: 1.6; margin: 0; padding-left: 1.625rem;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>
))}

<PageBand variant="tint">
  <div class="container" style="max-width: 960px;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <div class="eyebrow" style="justify-content: center; margin-bottom: 0.875rem;">Expediente del paciente</div>
      <h2 style="font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600; line-height: 1.15; margin-bottom: 0.875rem;">
        16 tipos de atributo.<br/>
        <span style="font-family: var(--font-display); font-style: italic; font-weight: 400;">Modela cualquier dato clínico.</span>
      </h2>
      <p style="color: var(--ink-3); font-size: 1rem; max-width: 580px; margin: 0 auto;">
        Desde alergias y seguro médico hasta consentimiento informado y firma digital. Shadia soporta 16 tipos de dato estructurado para el expediente del paciente.
      </p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
      {[
        { type: 'TEXT',         label: 'Texto',          desc: 'Diagnóstico, observaciones' },
        { type: 'NUMBER',       label: 'Número',         desc: 'Peso, presión, valores lab' },
        { type: 'BOOLEAN',      label: 'Booleano',       desc: 'Alergia sí/no, embarazo' },
        { type: 'DATE',         label: 'Fecha',          desc: 'Nacimiento, última visita' },
        { type: 'DATETIME',     label: 'Fecha y hora',   desc: 'Cita, procedimiento' },
        { type: 'TIME',         label: 'Hora',           desc: 'Horario preferido' },
        { type: 'CURRENCY',     label: 'Moneda',         desc: 'Copago, saldo pendiente' },
        { type: 'SELECTION',    label: 'Selección',      desc: 'Seguro, especialidad' },
        { type: 'LINK',         label: 'Link',           desc: 'Resultados, formularios' },
        { type: 'EMAIL',        label: 'Email',          desc: 'Correo del paciente' },
        { type: 'PHONE',        label: 'Teléfono',       desc: 'WhatsApp principal' },
        { type: 'GEOLOCATION',  label: 'Geolocalización',desc: 'Sede más cercana' },
        { type: 'SIGNATURE',    label: 'Firma digital',  desc: 'Consentimiento informado' },
        { type: 'CONSENT',      label: 'Consentimiento', desc: 'Autorización de datos' },
        { type: 'STATEMENT',    label: 'Declaración',    desc: 'Aviso de privacidad' },
        { type: 'ATTACHMENT',   label: 'Adjunto',        desc: 'Estudios, identificación' },
      ].map(a => (
        <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.875rem 1rem;">
          <div style="font-size: 0.625rem; font-weight: 700; letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase; margin-bottom: 0.25rem; font-family: 'SF Mono', 'Fira Code', monospace;">{a.type}</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--ink); margin-bottom: 0.125rem;">{a.label}</div>
          <div style="font-size: 0.75rem; color: var(--ink-4);">{a.desc}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageCta
  lang="es"
  source="features_page_cta"
  title="Todo esto,"
  titleAccent="desde $49 al mes."
  lead="7 días gratis, sin tarjeta de crédito. Empieza hoy y activa lo que necesites."
>
  <p class="lead-sm" style="margin-top: 0.75rem; text-align: center;">Sin compromisos · Cancela cuando quieras</p>
</PageCta>

</BaseLayout>

<style>
  @media (max-width: 1024px) {
    [style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: repeat(2, 1fr) !important; }
    [style*="grid-template-columns: 1fr 2fr"] { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 640px) {
    [style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: 1fr !important; }
  }
  ::-webkit-scrollbar { display: none; }
</style>
