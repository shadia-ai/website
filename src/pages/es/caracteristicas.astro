---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageBand from '../../components/PageBand.astro';
import PageCta from '../../components/PageCta.astro';
import SignupInput from '../../components/SignupInput.tsx';

const sections = [
  {
    id: 'canales',
    title: 'Canales y agentes',
    subtitle: 'Todos tus canales, un solo lugar',
    desc: 'Conecta WhatsApp, Instagram, TikTok, Facebook Messenger y más. Gestiona todas las conversaciones desde un solo lugar unificada.',
    icon: 'message-square',
    features: [
      { name: 'WhatsApp Business API oficial', desc: 'Número verificado, plantillas aprobadas y acceso completo a la API de Meta.' },
      { name: 'Instagram DMs y comentarios', desc: 'Responde mensajes directos y comentarios con intención de compra automáticamente.' },
      { name: 'Facebook Messenger', desc: 'Automatiza DMs de Messenger y ofrece continuar en WhatsApp en el idioma del usuario.' },
      { name: 'TikTok DMs', desc: 'Convierte el engagement de TikTok en conversaciones y citas reales.' },
      { name: 'Switch a WhatsApp', desc: 'Cuando un lead inicia en Messenger, Shadia ofrece mover la conversación a WhatsApp — en su idioma preferido.' },
      { name: 'Conversaciones unificadas omnicanal', desc: 'Todos los canales en un solo lugar. El equipo responde sin cambiar de ventana.' },
      { name: 'Difusiones masivas', desc: 'Envía campañas a segmentos de contactos con plantillas aprobadas de WhatsApp.' },
      { name: 'Plantillas de WhatsApp', desc: 'Crea, gestiona y usa plantillas aprobadas para mensajes proactivos.' },
    ],
  },
  {
    id: 'conversaciones',
    title: 'Conversaciones',
    subtitle: 'Todo lo que necesitas para gestionar cada interacción',
    desc: 'Herramientas de colaboración, organización y resolución para manejar cualquier conversación eficientemente.',
    icon: 'message-square',
    features: [
      { name: 'Auto-asignación de conversaciones', desc: 'Asigna automáticamente conversaciones al agente correcto según reglas de equipo y carga de trabajo.' },
      { name: 'Notas internas', desc: 'Agrega notas privadas dentro de cualquier conversación para que el equipo tenga contexto completo.' },
      { name: 'Reacciones a mensajes', desc: 'Reacciona rápidamente a mensajes del cliente o del equipo con emojis.' },
      { name: 'Respuestas en hilo', desc: 'Responde mensajes específicos manteniendo el hilo de la conversación organizado.' },
      { name: 'Menciones (@)', desc: 'Menciona a un colega o a Shadia Agent en cualquier conversación para pedir ayuda o contexto.' },
      { name: 'Presencia del equipo', desc: 'Ve quién está en línea y trabajando activamente en conversaciones en tiempo real.' },
      { name: 'Adjuntos', desc: 'Comparte y recibe documentos, imágenes, audios y videos directamente en el chat.' },
      { name: 'Búsqueda en conversaciones', desc: 'Encuentra cualquier conversación, mensaje o archivo al instante con búsqueda avanzada.' },
      { name: 'Horarios de atención', desc: 'Define horarios de atención por canal y equipo. Mensajes automáticos fuera de horario.' },
      { name: 'Detección de colisiones', desc: 'Avisa cuando dos agentes están respondiendo la misma conversación simultáneamente.' },
      { name: 'Mensajes programados', desc: 'Programa mensajes para enviar después, como en Slack. Define la fecha y hora exacta y Shadia lo envía automáticamente.' },
      { name: 'Auto-cierre por inactividad', desc: 'Cierra conversaciones automáticamente tras X días/meses sin actividad. Configurable por cuenta, canal o equipo.' },
      { name: 'Colaboradores en conversación', desc: 'Asigna varios roles a una misma conversación (ej. ventas + soporte). Mencionar (@usuario) lo agrega automáticamente como participante.' },
      { name: 'Modos de visualización', desc: 'Cuatro vistas configurables por miembro: Full (todo), Standard (sin notas internas), Focus (solo mensajes del cliente), Collaborative (solo notas del equipo).' },
    ],
  },
  {
    id: 'ia',
    title: 'IA y agentes',
    subtitle: 'Inteligencia artificial que opera de verdad',
    desc: 'Agentes IA conversacionales con LLM real que mantienen contexto, toman decisiones y gestionan conversaciones completas de manera autónoma.',
    icon: 'bot',
    features: [
      { name: 'Agentes IA conversacionales (LLM)', desc: 'Agentes que entienden contexto, recuerdan conversaciones y responden con inteligencia real.' },
      { name: 'Shadia Agent (agente de tu equipo)', desc: 'Tu copiloto IA. Pregunta sobre clientes, pide resúmenes, redacta respuestas — en lenguaje natural.' },
      { name: 'AI Threads', desc: 'Inicia conversaciones privadas con tu IA estilo ChatGPT sobre tus datos. Delega, activa, asigna y envíale trabajo a la IA directamente desde el chat para que active tu negocio.' },
      { name: 'AI Presence', desc: 'Ve exactamente dónde está trabajando la IA en tu cuenta en tiempo real: qué conversaciones está procesando, qué acciones está ejecutando y su estado actual.' },
      { name: 'Escalación inteligente', desc: 'El agente escala al equipo humano cuando detecta que la situación lo requiere.' },
      { name: 'Personalidad y tono de marca', desc: 'Define cómo habla tu agente: formal, amigable, técnico. Consistente en cada mensaje.' },
      { name: 'Respuestas automáticas FAQs', desc: 'El agente responde preguntas frecuentes sin intervención humana, 24/7.' },
      { name: 'Memoria de conversación', desc: 'El agente recuerda el historial del cliente y adapta las respuestas al contexto.' },
      { name: 'Múltiples agentes IA', desc: 'Configura distintos agentes para diferentes canales, equipos o tipos de consulta.' },
    ],
  },
  {
    id: 'citas',
    title: 'Motor de citas',
    subtitle: 'Agendamiento autónomo, sin herramientas externas',
    desc: 'Sin Calendly, sin links externos. Shadia agenda, confirma, reconfirma y gestiona toda la logística de citas directamente en WhatsApp.',
    icon: 'calendar',
    features: [
      { name: 'Agendamiento por WhatsApp', desc: 'El cliente pide cita por WhatsApp y el agente confirma en el mismo chat.' },
      { name: 'Recordatorios automáticos', desc: 'WhatsApp automático 24h y 1h antes. El cliente confirma con una respuesta.' },
      { name: 'Reagendamiento por chat', desc: 'El cliente puede cambiar la cita respondiendo el recordatorio. El agente actualiza el calendario.' },
      { name: 'Sincronización Google Calendar', desc: 'Bidireccional en tiempo real. Cero doble booking.' },
      { name: 'Múltiples tipos de cita', desc: 'Define servicios con duración, precio, tiempo de preparación y disponibilidad específica.' },
      { name: 'Reglas de disponibilidad', desc: 'Horarios, días, máximo de citas simultáneas por servicio o agente.' },
      { name: 'Seguimiento post-cita', desc: 'Encuesta de satisfacción automática y recordatorio de próxima cita.' },
      { name: 'Múltiples ubicaciones', desc: 'Gestiona disponibilidad de diferentes sedes o agentes desde el mismo sistema.' },
    ],
  },
  {
    id: 'contactos',
    title: 'Contactos y datos',
    subtitle: 'Todo el contexto de tus clientes, siempre disponible',
    desc: 'Organiza contactos, empresas y toda la información relevante. Sin spreadsheets, sin herramientas separadas — Shadia gestiona el contexto por ti.',
    icon: 'user',
    features: [
      { name: 'Perfiles de contacto unificados', desc: 'Historial completo de conversaciones, citas, notas y atributos en un solo perfil.' },
      { name: 'Empresas y organizaciones', desc: 'Asocia contactos a empresas y ve toda la actividad de un cliente corporativo.' },
      { name: 'Tags y etiquetas', desc: 'Organiza y segmenta contactos con etiquetas personalizadas para filtrar y encontrar.' },
      { name: 'Data attributes personalizados (16 tipos)', desc: 'El sistema de atributos más completo de la categoría: TEXT, LINK, EMAIL, PHONE, NUMBER, DATE, DATETIME, TIME, BOOLEAN, CURRENCY, SELECTION, GEOLOCATION, SIGNATURE, CONSENT, STATEMENT, ATTACHMENT y RELATIONSHIP. Modela cualquier dato de negocio sin limitaciones.' },
      { name: 'Notas de contacto', desc: 'El equipo puede añadir notas a cualquier contacto con contexto importante.' },
      { name: 'Resource viewers', desc: 'Ve qué recursos, documentos o páginas ha visitado cada contacto.' },
      { name: 'Sugerencias de duplicados', desc: 'Shadia detecta automáticamente contactos duplicados y sugiere unificarlos.' },
      { name: 'Importación/exportación CSV', desc: 'Importa tu base de contactos existente y exporta segmentos cuando necesites.' },
      { name: 'Limpieza de contactos IA', desc: 'La IA detecta y agrega flags automáticos en contactos sin respuesta, sin interés o inactivos. Mantén tu base de datos limpia sin trabajo manual.' },
      { name: 'Acciones masivas', desc: 'Importa contactos, asigna tags, cambia carpeta, actualiza estado y más — en lote sobre múltiples contactos a la vez.' },
    ],
  },
  {
    id: 'equipos',
    title: 'Equipos y colaboración',
    subtitle: 'Tu equipo trabajando como uno',
    desc: 'Herramientas diseñadas para que equipos completos colaboren en conversaciones con visibilidad, control y eficiencia.',
    icon: 'users',
    features: [
      { name: 'Auto-asignación inteligente', desc: 'Asigna conversaciones automáticamente según disponibilidad, carga de trabajo y habilidades del agente.' },
      { name: 'Folders y organización', desc: 'Organiza conversaciones y threads en carpetas por proyecto, canal o equipo.' },
      { name: 'Equipos y sub-equipos', desc: 'Crea grupos de agentes para distintas áreas: ventas, soporte, operaciones.' },
      { name: 'Presencia en tiempo real', desc: 'Ve quién está activo, ocupado o fuera de línea. Distribuye la carga de manera inteligente.' },
      { name: 'Control de acceso por rol (RBAC)', desc: 'Define qué puede ver y hacer cada miembro del equipo en la plataforma.' },
      { name: 'Auditoría de acciones', desc: 'Registra quién hizo qué y cuándo para cumplimiento y revisiones internas.' },
      { name: 'Horarios por miembro', desc: 'Configura la disponibilidad de cada miembro del equipo para que las asignaciones respeten sus horarios.' },
      { name: 'Capacidad por miembro', desc: 'Previene la sobrecarga limitando el número de conversaciones simultáneas por miembro.' },
    ],
  },
  {
    id: 'api',
    title: 'API e integraciones',
    subtitle: 'Conecta Shadia con todo tu stack',
    desc: 'API robusta, webhooks en tiempo real e integraciones nativas para conectar Shadia con cualquier herramienta de tu ecosistema.',
    icon: 'link',
    features: [
      { name: 'API completa', desc: 'Consultas y mutaciones para acceder y modificar contactos, conversaciones, citas y más.' },
      { name: 'Webhooks en tiempo real', desc: 'Recibe eventos de Shadia en tu sistema al instante para automatizaciones externas.' },
      { name: 'OAuth 2.0', desc: 'Autenticación segura y estándar para integraciones de terceros.' },
      { name: 'Documentación interactiva', desc: 'Explora y prueba la API directamente desde la documentación en línea.' },
      { name: 'SDK (Node.js, Python)', desc: 'Librerías oficiales para integrar Shadia en tus aplicaciones más rápidamente.' },
      { name: 'Integraciones nativas', desc: 'Google Calendar, HubSpot, Zapier, Slack y más — conectados en minutos.' },
      { name: 'Dashboard apps', desc: 'Embebe aplicaciones personalizadas dentro de Shadia para casos de uso específicos.' },
      { name: 'IP whitelisting', desc: 'Controla qué IPs pueden acceder a tu API para máxima seguridad.' },
    ],
  },
  {
    id: 'reportes',
    title: 'Reportes y analytics',
    subtitle: 'Datos que te ayudan a decidir',
    desc: 'Dashboards en tiempo real y reportes detallados para medir el rendimiento de tu operación, equipo y canales.',
    icon: 'bar-chart',
    features: [
      { name: 'Dashboard en tiempo real', desc: 'Vista general de conversaciones activas, tiempos de respuesta y carga del equipo.' },
      { name: 'Reportes por miembro', desc: 'Mide el rendimiento individual de cada miembro del equipo: velocidad, resolución y satisfacción.' },
      { name: 'Reportes por canal', desc: 'Ve qué canales generan más conversaciones, cuáles convierten mejor y dónde hay oportunidades.' },
      { name: 'CSAT (Satisfacción del cliente)', desc: 'Encuestas automáticas post-conversación con métricas de satisfacción en tiempo real.' },
      { name: 'Reportes de citas', desc: 'Ocupación del calendario, servicios más solicitados, no-shows y tendencias.' },
      { name: 'Exportación de reportes', desc: 'Descarga cualquier reporte en CSV para análisis externo o presentaciones.' },
      { name: 'Reportes personalizados', desc: 'Crea reportes a medida con las métricas que más importan a tu negocio (ULTRA).' },
      { name: 'Vista en vivo', desc: 'Monitorea las conversaciones activas del equipo en tiempo real desde el dashboard.' },
    ],
  },
  {
    id: 'seguridad',
    title: 'Seguridad y cumplimiento',
    subtitle: 'Seguridad enterprise desde el primer día',
    desc: 'Cifrado, auditoría, control de acceso y cumplimiento de privacidad de datos para que tu operación esté siempre protegida.',
    icon: 'lock',
    features: [
      { name: 'Cifrado end-to-end (TLS + AES-256)', desc: 'Todos los datos en tránsito y en reposo están cifrados con estándares enterprise.' },
      { name: 'Control de acceso por rol (RBAC)', desc: 'Define permisos granulares por rol para cada función de la plataforma.' },
      { name: 'Auditoría completa', desc: 'Registro detallado de todas las acciones realizadas por usuarios de la plataforma.' },
      { name: 'SSO / SAML', desc: 'Inicio de sesión único compatible con los principales proveedores de identidad (ULTRA).' },
      { name: 'SLA de uptime 99.9%', desc: 'Infraestructura redundante con compromisos contractuales de disponibilidad.' },
      { name: 'Cumplimiento GDPR', desc: 'Herramientas y controles para cumplir con regulaciones de privacidad de datos.' },
      { name: 'IP whitelisting', desc: 'Restricción de acceso a IPs específicas para acceso a la API y panel de administración.' },
      { name: 'Meta Business Partner', desc: 'Integración oficial verificada por Meta para máxima seguridad en WhatsApp.' },
      { name: 'Enmascarado de datos (Mask)', desc: 'Oculta números de teléfono y correos electrónicos de los agentes para proteger la información sensible de los contactos. Privacidad y seguridad de datos sin fricción operativa.' },
    ],
  },
];
---

<BaseLayout
  title="Características — Todo lo que incluye Shadia AI | Shadia AI"
  description="Descubre todas las funciones de Shadia AI: agentes omnicanal, motor de citas, contactos, equipos, API, reportes y seguridad enterprise."
  lang="es"
  canonical="https://shadia.ai/es/caracteristicas"
  ogImage="/og/features-es.png"
>

<PageHero
  eyebrow="Características"
  title="Todo lo que necesitas"
  titleAccent="para operar con IA."
  lead="Agentes IA, motor de citas, agentes IA, contactos, equipos, API y seguridad enterprise — en una sola plataforma."
  narrow={false}
>
  <div class="page-hero__actions">
    <SignupInput lang="es" source="features_page_hero" size="lg" client:load />
  </div>
</PageHero>

<div class="sticky-subnav">
  <div class="container sticky-subnav__inner">
    <div class="sticky-subnav__tabs">
      {sections.map(s => (
        <a href={`#${s.id}`} class="sticky-subnav__tab">
          <Icon name={s.icon} size={20} /> {s.title}
        </a>
      ))}
    </div>
  </div>
</div>

{sections.map((section, i) => (
  <PageBand id={section.id} variant={i % 2 === 0 ? 'plain' : 'muted'}>
    <div class="container">
      <!-- Section header -->
      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; margin-bottom: 3.5rem; align-items: start;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.875rem; background: var(--accent-bg); border: 1px solid var(--accent-ring); border-radius: 9999px; font-size: 0.6875rem; font-weight: 700; color: var(--accent); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1rem;">
            <Icon name={section.icon} size={20} /> {section.title}
          </div>
          <h2 style="font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 600; line-height: 1.2; color: var(--ink); margin-bottom: 0.875rem;">{section.subtitle}</h2>
        </div>
        <div>
          <p style="font-size: 1.0625rem; color: var(--ink-3); line-height: 1.75; margin: 0;">{section.desc}</p>
        </div>
      </div>

      <!-- Features grid -->
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 16px; overflow: hidden;">
        {section.features.map(f => (
          <div style="padding: 1.375rem 1.5rem; background: var(--bg);">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
              <span style="width: 18px; height: 18px; border-radius: 50%; background: var(--accent); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="9" height="9" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.3;">{f.name}</h3>
            </div>
            <p style="font-size: 0.8125rem; color: var(--ink-4); line-height: 1.6; margin: 0; padding-left: 1.625rem;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </PageBand>
))}

<PageBand variant="tint">
  <div class="container" style="max-width: 960px;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <div class="eyebrow" style="justify-content: center; margin-bottom: 0.875rem;">Data Attributes</div>
      <h2 style="font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600; line-height: 1.15; margin-bottom: 0.875rem;">
        16 tipos de atributo.<br/>
        <span style="font-family: var(--font-display); font-style: italic; font-weight: 400;">Modela cualquier dato de negocio.</span>
      </h2>
      <p style="color: var(--ink-3); font-size: 1rem; max-width: 580px; margin: 0 auto;">
        La mayoría de plataformas te da campos de texto y punto. Shadia soporta 16 tipos de dato estructurado — desde geolocalización y firma digital hasta consentimiento legal y relaciones entre entidades.
      </p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
      {[
        { type: 'TEXT',         label: 'Texto',          desc: 'Texto libre de una línea' },
        { type: 'NUMBER',       label: 'Número',         desc: 'Entero o decimal' },
        { type: 'BOOLEAN',      label: 'Booleano',       desc: 'Verdadero / Falso' },
        { type: 'DATE',         label: 'Fecha',          desc: 'ISO-8601 YYYY-MM-DD' },
        { type: 'DATETIME',     label: 'Fecha y hora',   desc: 'Con zona horaria' },
        { type: 'TIME',         label: 'Hora',           desc: 'HH:MM:SS' },
        { type: 'CURRENCY',     label: 'Moneda',         desc: 'Monto + código ISO-4217' },
        { type: 'SELECTION',    label: 'Selección',      desc: 'Lista de opciones configurada' },
        { type: 'LINK',         label: 'Link',           desc: 'URL validada' },
        { type: 'EMAIL',        label: 'Email',          desc: 'Correo normalizado' },
        { type: 'PHONE',        label: 'Teléfono',       desc: 'Formato E.164' },
        { type: 'GEOLOCATION',  label: 'Geolocalización',desc: 'Latitud y longitud' },
        { type: 'SIGNATURE',    label: 'Firma digital',  desc: 'Captura y almacena firmas' },
        { type: 'CONSENT',      label: 'Consentimiento', desc: 'Acepta políticas o términos' },
        { type: 'STATEMENT',    label: 'Declaración',    desc: 'Texto para mostrar/aceptar' },
        { type: 'ATTACHMENT',   label: 'Adjunto',        desc: 'Referencia a archivo subido' },
      ].map(a => (
        <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.875rem 1rem;">
          <div style="font-size: 0.625rem; font-weight: 700; letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase; margin-bottom: 0.25rem; font-family: 'SF Mono', 'Fira Code', monospace;">{a.type}</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--ink); margin-bottom: 0.125rem;">{a.label}</div>
          <div style="font-size: 0.75rem; color: var(--ink-4);">{a.desc}</div>
        </div>
      ))}
    </div>
  </div>
</PageBand>

<PageCta
  lang="es"
  source="features_page_cta"
  title="Todo esto,"
  titleAccent="desde $49 al mes."
  lead="7 días gratis, sin tarjeta de crédito. Empieza hoy y activa lo que necesites."
>
  <p class="lead-sm" style="margin-top: 0.75rem; text-align: center;">Sin compromisos · Cancela cuando quieras</p>
</PageCta>

</BaseLayout>

<style>
  @media (max-width: 1024px) {
    [style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: repeat(2, 1fr) !important; }
    [style*="grid-template-columns: 1fr 2fr"] { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 640px) {
    [style*="grid-template-columns: repeat(4, 1fr)"] { grid-template-columns: 1fr !important; }
  }
  ::-webkit-scrollbar { display: none; }
</style>
