---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import PageBand from '../../../components/PageBand.astro';
import PageCta from '../../../components/PageCta.astro';

const industries = [
  { title: 'Ecommerce', desc: 'Recupera carritos, resuelve pedidos y confirma envíos en WhatsApp.', benefits: ['Carritos abandonados', 'Estado de pedido', 'Devoluciones en chat', 'Upsell post-compra'], href: '/es/industrias/ecommerce', color: '#10B981' },
  { title: 'Salud', desc: 'Clínicas y consultorios: llena agenda, reduce ausencias y reactiva pacientes.', benefits: ['Agenda 24/7', 'Recordatorios', 'Reagendos', 'Reactivación'], href: '/es/industrias/salud', color: '#22c55e' },
  { title: 'Ventas', desc: 'Califica leads, da seguimiento y cierra más sin ampliar el equipo.', benefits: ['Calificación IA', 'Seguimiento automático', 'Pipeline activo', 'Handoff al vendedor'], href: '/es/industrias/ventas', color: '#3b82f6' },
  { title: 'Soporte', desc: 'Resuelve lo rutinario; tu equipo atiende lo que requiere criterio humano.', benefits: ['Resolución autónoma', 'Escalación con contexto', 'SLA por prioridad', 'Analítica en vivo'], href: '/es/industrias/soporte', color: '#6366F1' },
  { title: 'Agencias', desc: 'Multi-marca desde una plataforma: cada cliente con su agente y reglas.', benefits: ['Multi-workspace', 'Agentes por marca', 'Analítica consolidada', 'Onboarding rápido'], href: '/es/industrias/agencias', color: '#F59E0B' },
  { title: 'Odontología', desc: 'Llena agenda y reduce no-shows sin saturar recepción.', benefits: ['Citas por WhatsApp', 'Confirmaciones', 'Post-tratamiento', 'Reactivación'], href: '/es/industrias/odontologia', color: '#14B8A6' },
  { title: 'Belleza', desc: 'Confirma citas, reagenda y reactiva clientes desde WhatsApp.', benefits: ['Confirmación automática', 'Recordatorios 24h', 'Reactivación', 'Upsell'], href: '/es/industrias/belleza', color: '#ec4899' },
];
---

<BaseLayout
  title="Industrias — Shadia AI para tu sector | Shadia AI"
  description="Shadia AI para ecommerce, salud, ventas, soporte, agencias, odontología y belleza. WhatsApp-first para negocios en RD y LATAM."
  lang="es"
  canonical="https://shadia.ai/es/industrias"
  ogImage="/og/industries-es.png"
>
  <PageHero
    eyebrow="Industrias"
    title="Hecho para cómo opera"
    titleAccent="tu sector."
    lead="Mismo motor de IA — calibrado para clínicas, salones, tiendas y equipos que viven del chat en la región."
  />

  <PageBand variant="plain">
    <div class="container">
      <div class="page-grid-2">
        {industries.map(ind => (
          <a href={ind.href} class="page-card-link">
            <div class="card page-card">
              <h2 class="page-card__title">{ind.title}</h2>
              <p class="page-card__desc">{ind.desc}</p>
              <ul style="list-style:none;padding:0;margin:0 0 1.25rem;display:flex;flex-direction:column;gap:0.5rem;">
                {ind.benefits.map(b => (
                  <li style="display:flex;align-items:center;gap:0.5rem;font-size:0.875rem;color:var(--ink-3);">
                    <span style={`width:5px;height:5px;border-radius:50%;background:${ind.color};flex-shrink:0;`}></span>
                    {b}
                  </li>
                ))}
              </ul>
              <span class="page-card__link" style={`color:${ind.color};`}>Ver solución →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </PageBand>

  <PageCta
    lang="es"
    source="industries_index_cta"
    title="¿Tu industria no está?"
    titleAccent="Cuéntanos."
    lead="Configuramos Shadia para tu operación en una llamada — empieza gratis hoy."
  />
</BaseLayout>
